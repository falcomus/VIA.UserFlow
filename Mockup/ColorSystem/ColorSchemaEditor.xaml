<via:XWindow
    x:Class="Mockup.ColorSystem.ColorSchemaEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:colorSys="clr-namespace:Mockup.ColorSystem"
    xmlns:controls="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="Root"
    Title="Edit color scheme"
    Width="850"
    CornerRadius="10"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    ShowResizeGrip="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    SizeToContent="Height"
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    TitleBarHeight="45"
    TitleBarPadding="22,0,0,0"
    TitleFontSize="18"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    WindowStartupLocation="CenterOwner">
    <!--  MaxHeight="950"  -->
    <via:XWindow.Effect>
        <DropShadowEffect
            BlurRadius="18"
            Direction="270"
            Opacity="0.20"
            ShadowDepth="5" />
    </via:XWindow.Effect>

    <via:XWindow.Resources>
        <colorSys:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </via:XWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <via:XStackPanel
            Grid.Row="0"
            Margin="28,22,28,24"
            Orientation="Vertical"
            Spacing="18">
            <via:XStackPanel Orientation="Vertical" Spacing="5">
                <via:XTextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                    Text="Color scheme" />
                <via:XTextBlock
                    FontSize="13"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                    Text="Select a color token, then adjust it below." />
            </via:XStackPanel>

            <!--  Height="240"  -->
            <via:XBorder
                Padding="3,5"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                BorderThickness="1"
                CornerRadius="8"
                Elevation="Low">
                <via:XListBox
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding ColorItems}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedColorItem, Mode=TwoWay}">
                    <via:XListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type colorSys:ColorSchemaEditor+ColorItem}">
                            <via:XBorder
                                Margin="-5,0,-5,0"
                                Padding="5,8"
                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <via:XBorder
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                                        BorderThickness="1"
                                        CornerRadius="4" />
                                    <via:XTextBlock
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                        Text="{Binding Label}" />
                                    <via:XBadge
                                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                                        Margin="0 0 4 0"
                                        Grid.Column="2"
                                        CornerRadius="4"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                        Content="{Binding Hex}"
                                        VerticalAlignment="Center"
                                        FontSize="12" />
                                    <!--<via:XTextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Margin="0 0 10 0"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                        Text="{Binding Hex}" />-->
                                </Grid>
                            </via:XBorder>
                        </DataTemplate>
                    </via:XListBox.ItemTemplate>
                    <via:XListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </via:XListBox.ItemsPanel>
                </via:XListBox>
            </via:XBorder>

            <via:XBorder
                Padding="14"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                BorderThickness="1"
                CornerRadius="8"
                Elevation="Low">
                <controls:XColorPicker Margin="0,0,0,5" SelectedColor="{Binding SelectedColorItem.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </via:XBorder>
        </via:XStackPanel>

        <via:XBorder
            Grid.Row="1"
            Padding="28,14"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    Width="112"
                    Command="{Binding OkCommand}"
                    Content="OK"
                    Cursor="Hand"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    Width="92"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    Cursor="Hand"
                    IsCancel="True"
                    Size="Large" />
            </via:XStackPanel>
        </via:XBorder>
    </Grid>
</via:XWindow>
