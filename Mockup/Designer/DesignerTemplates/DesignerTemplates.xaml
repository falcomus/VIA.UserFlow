<!--
    ======================================================================================
    FILE: (dein ResourceDictionary, z.B. Themes/Generic.xaml oder BaseDesignerStyles.xaml)
    ======================================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Mockup.Designer"
    xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF">

    <Style TargetType="{x:Type local:BaseDesigner}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BaseDesigner}">

                    <Grid>
                        <!--  SKIA CANVAS  -->
                        <skia:SKElement x:Name="PART_Canvas" Margin="0" />
                        <!--  IgnorePixelScaling="True" />  -->

                        <!--  OVERLAY  -->
                        <Canvas
                            x:Name="PART_Overlay"
                            Background="Transparent"
                            IsHitTestVisible="False" />
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Type local:BaseDesigner}}" TargetType="{x:Type local:ScreenDesigner}" />

    <Style TargetType="{x:Type local:TemplateDesigner}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TemplateDesigner}">

                    <Grid>
                        <!--  SKIA CANVAS  -->
                        <skia:SKElement
                            x:Name="PART_Canvas"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <!--  IgnorePixelScaling="True" />  -->

                        <!--  OVERLAY  -->
                        <Canvas
                            x:Name="PART_Overlay"
                            Background="Transparent"
                            IsHitTestVisible="False" />
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:PopupDesigner}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PopupDesigner}">

                    <Grid>
                        <!--  SKIA CANVAS  -->
                        <skia:SKElement
                            x:Name="PART_Canvas"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <!--  IgnorePixelScaling="True" />  -->

                        <!--  OVERLAY  -->
                        <Canvas
                            x:Name="PART_Overlay"
                            Background="Transparent"
                            IsHitTestVisible="False" />
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
