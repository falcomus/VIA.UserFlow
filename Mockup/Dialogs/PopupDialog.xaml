<dialogs:ModalDialogWindow
    x:Class="Mockup.Dialogs.PopupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:dialogs="clr-namespace:Mockup.Dialogs"
    xmlns:via="http://schemas.via.dev/wpf"
    Title="{via:XLoc Dialog.Popup.Edit.Title, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
    Subtitle=""
    Width="500"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    ShowMinimizeButton="False"
    ShowMaximizeButton="False"
    ShowResizeGrip="False"
    TitleBarHeight="45"
    TitleFontSize="16"
    TitleBarPadding="20,0,0,0"
    CornerRadius="10"
    WindowStartupLocation="CenterOwner"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    d:DataContext="{d:DesignInstance Type=mockup:ScreenPopup}"
    mc:Ignorable="d">

    <dialogs:ModalDialogWindow.Effect>
        <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.20" ShadowDepth="5" />
    </dialogs:ModalDialogWindow.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,26" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <via:XTextBox
                x:Name="InputName"
                Grid.Row="0"
                Header="{via:XLoc Dialog.Name, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <via:XTextBox
                x:Name="InputTitle"
                Grid.Row="2"
                Header="{via:XLoc Dialog.TitleField, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <via:XComboBox
                Grid.Row="4"
                Header="{via:XLoc Dialog.Category, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                IsEditable="True"
                IsTextSearchEnabled="True"
                ItemsSource="{Binding Source={x:Static mockup:MockupService.Mockup}, Path=PopupGroupNames}"
                Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <via:XTextBlock
                Grid.Row="6"
                FontSize="13"
                FontWeight="SemiBold"
                Text="{via:XLoc Dialog.Position, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

            <via:XStackPanel Grid.Row="8" Orientation="Horizontal" Spacing="12">
                <via:XRadioButton Content="{via:XLoc Dialog.Popup.Left, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" IsChecked="{Binding Position, Mode=TwoWay, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Left}" />
                <via:XRadioButton Content="{via:XLoc Dialog.Popup.Right, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" IsChecked="{Binding Position, Mode=TwoWay, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Right}" />
                <via:XRadioButton Content="{via:XLoc Dialog.Popup.Top, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" IsChecked="{Binding Position, Mode=TwoWay, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Top}" />
                <via:XRadioButton Content="{via:XLoc Dialog.Popup.Bottom, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" IsChecked="{Binding Position, Mode=TwoWay, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Bottom}" />
                <via:XRadioButton Content="{via:XLoc Dialog.Popup.Center, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" IsChecked="{Binding Position, Mode=TwoWay, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Center}" />
                <via:XRadioButton Content="{via:XLoc Dialog.Popup.MousePosition, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" IsChecked="{Binding Position, Mode=TwoWay, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=MousePos}" />
            </via:XStackPanel>

            <via:XBorder
                Grid.Row="10"
                Padding="14,12"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                CornerRadius="6">
                <!--BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                BorderThickness="1"-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <via:XCheckBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="{via:XLoc Dialog.Popup.ShowHeader, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        IsChecked="{Binding HasHeader, Mode=TwoWay}" />
                    <via:XTextBox
                        Grid.Column="2"
                        Header="{via:XLoc Dialog.Popup.HeaderHeight, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        IsEnabled="{Binding HasHeader}"
                        Text="{Binding HeaderHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </via:XBorder>

            <via:XTextBox
                x:Name="InputDescription"
                Grid.Row="12"
                AcceptsReturn="True"
                Header="{via:XLoc Dialog.Description, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                MaxLines="4"
                Height="85"
                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalContentAlignment="Stretch" />
        </Grid>

        <via:XBorder
            Grid.Row="1"
            Padding="28,14"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    Width="112"
                    Click="Ok_Click"
                    Content="{via:XLoc Common.OK, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    Width="92"
                    Click="Cancel_Click"
                    Content="{via:XLoc Common.Cancel, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsCancel="True"
                    Size="Large" />
            </via:XStackPanel>
        </via:XBorder>
    </Grid>
</dialogs:ModalDialogWindow>
