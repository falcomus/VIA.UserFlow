<dialogs:ModalDialogWindow
    x:Class="Mockup.Dialogs.PopupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Mockup.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    Title="{via:XLoc Dialog.Popup.Edit.Title,
                     ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
    d:DataContext="{d:DesignInstance Type=mockup:ScreenPopup}"
    CornerRadius="10"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    ShowResizeGrip="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    SizeToContent="Height"
    Subtitle=""
    Width="450"
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    TitleBarHeight="45"
    TitleBarPadding="20,0,0,0"
    TitleFontSize="16"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <dialogs:ModalDialogWindow.Effect>
        <DropShadowEffect
            BlurRadius="18"
            Direction="270"
            Opacity="0.20"
            ShadowDepth="5" />
    </dialogs:ModalDialogWindow.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <via:XStackPanel
            Grid.Row="0"
            Margin="20 15 20 20"
            VerticalAlignment="Top"
            Spacing="16">
            <via:XTextBox
                x:Name="InputName"
                Header="{via:XLoc Dialog.Name,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <via:XTextBox
                x:Name="InputTitle"
                Header="{via:XLoc Dialog.TitleField,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <via:XComboBox
                Header="{via:XLoc Dialog.Category,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                IsEditable="True"
                IsTextSearchEnabled="True"
                ItemsSource="{Binding Source={x:Static mockup:MockupService.Mockup}, Path=PopupGroupNames}"
                Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <via:XStackPanel Margin="0,4,0,0" Spacing="8">
                <via:XTextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{via:XLoc Dialog.Position,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                <via:XButtonGroup
                    HorizontalAlignment="Left"
                    ItemMinWidth="52"
                    Height="36"
                    SelectedValue="{Binding Position, Mode=TwoWay}"
                    Variant="Primary">
                    <via:XButtonGroupItem Content="{via:XLoc Dialog.Popup.Left, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" Value="{x:Static mockup:ScreenPopupPosition.Left}" />
                    <via:XButtonGroupItem Content="{via:XLoc Dialog.Popup.Right, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" Value="{x:Static mockup:ScreenPopupPosition.Right}" />
                    <via:XButtonGroupItem Content="{via:XLoc Dialog.Popup.Top, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" Value="{x:Static mockup:ScreenPopupPosition.Top}" />
                    <via:XButtonGroupItem Content="{via:XLoc Dialog.Popup.Bottom, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" Value="{x:Static mockup:ScreenPopupPosition.Bottom}" />
                    <via:XButtonGroupItem Content="{via:XLoc Dialog.Popup.Center, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" Value="{x:Static mockup:ScreenPopupPosition.Center}" />
                    <via:XButtonGroupItem Content="{via:XLoc Dialog.Popup.MousePosition, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" Value="{x:Static mockup:ScreenPopupPosition.MousePos}" />
                </via:XButtonGroup>
            </via:XStackPanel>

            <via:XBorder
                Padding="0,5"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                BorderThickness="0"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <via:XCheckBox
                        Grid.Column="0"
                        Margin="0,0,0,3"
                        VerticalAlignment="Bottom"
                        Content="{via:XLoc Dialog.Popup.ShowHeader,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        IsChecked="{Binding HasHeader, Mode=TwoWay}" />
                    <via:XTextBox
                        Grid.Column="2"
                        Header="{via:XLoc Dialog.Popup.HeaderHeight,
                                          ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        IsEnabled="{Binding HasHeader}"
                        Text="{Binding HeaderHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </via:XBorder>

            <via:XTextBox
                x:Name="InputDescription"
                Height="85"
                VerticalContentAlignment="Stretch"
                AcceptsReturn="True"
                Header="{via:XLoc Dialog.Description,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                MaxLines="4"
                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </via:XStackPanel>

        <via:XBorder
            Grid.Row="1"
            Padding="20,15"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0"
            CornerRadius="0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    Width="100"
                    Height="30"
                    Padding="0"
                    Click="Ok_Click"
                    Content="{via:XLoc Common.OK,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    Width="100"
                    Height="30"
                    Padding="0"
                    Click="Cancel_Click"
                    Content="{via:XLoc Common.Cancel,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsCancel="True"
                    Size="Large" />
            </via:XStackPanel>
        </via:XBorder>
    </Grid>
</dialogs:ModalDialogWindow>
