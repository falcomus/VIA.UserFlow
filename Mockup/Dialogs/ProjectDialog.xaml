<dialogs:ModalDialogWindow
    x:Class="Mockup.Dialogs.ProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Mockup.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root"
    Title="Edit project"
    Subtitle=""
    Width="620"
    MinHeight="400"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    ShowMinimizeButton="False"
    ShowMaximizeButton="False"
    ShowResizeGrip="False"
    TitleBarHeight="45"
    TitleFontSize="16"
    TitleBarPadding="20,0,0,0"
    CornerRadius="10"
    WindowStartupLocation="CenterOwner"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    d:DataContext="{d:DesignInstance Type=mockup:Project}"
    mc:Ignorable="d">

    <dialogs:ModalDialogWindow.Effect>
        <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.20" ShadowDepth="5" />
    </dialogs:ModalDialogWindow.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <via:XTabControl
            Margin="28,20,28,24"
            HeaderAppearance="Underlined"
            HeaderPadding="14,7,14,7"
            HeaderSpacing="4"
            ShowBorder="False">
            <via:XTabItem Header="General">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <via:XTextBox
                        x:Name="InputName"
                        Header="Name"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <via:XTextBox
                        x:Name="InputDescription"
                        Grid.Row="2"
                        Height="90"
                        Padding="2 3"
                        AcceptsReturn="True"
                        Header="Description"
                        MaxLines="6"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top" />
                </Grid>
            </via:XTabItem>

            <via:XTabItem Header="Device">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <via:XNumberBox
                        Grid.Row="0"
                        Header="Width"
                        Maximum="2000"
                        Minimum="100"
                        Step="10"
                        Value="{Binding DeviceWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <via:XNumberBox
                        Grid.Row="0"
                        Grid.Column="2"
                        Header="Height"
                        Maximum="2000"
                        Minimum="100"
                        Step="10"
                        Value="{Binding DeviceHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <via:XComboBox
                        x:Name="PART_ScreenSizes"
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        DisplayMemberPath="DisplayText"
                        Header="Device preset"
                        SelectionChanged="PART_ScreenSizes_SelectionChanged" />

                </Grid>
            </via:XTabItem>

            <via:XTabItem Header="Theme &amp; sharing">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <via:XComboBox
                        DisplayMemberPath="Name"
                        Header="Color scheme"
                        ItemsSource="{Binding ElementName=root, Path=ColorSchemas}"
                        SelectedValue="{Binding ColorSchemaKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Key" />

                    <via:XBorder
                        Grid.Row="2"
                        Padding="16,14"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <via:XStackPanel Orientation="Vertical" Spacing="10">
                            <via:XCheckBox
                                Content="Shared project"
                                IsChecked="{Binding IsShared, Mode=TwoWay}" />
                            <via:XCheckBox
                                Content="Read-only for shared users"
                                IsEnabled="{Binding IsShared}"
                                IsChecked="{Binding IsSharedReadonly, Mode=TwoWay}" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XTextBlock
                        Grid.Row="4"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                        Text="The selected color scheme is used by all screens and popups in this project."
                        TextWrapping="Wrap" />
                </Grid>
            </via:XTabItem>
        </via:XTabControl>

        <via:XBorder
            Grid.Row="1"
            Padding="28,14"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    Width="112"
                    Click="Ok_Click"
                    Content="OK"
                    Cursor="Hand"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    Width="92"
                    Click="Cancel_Click"
                    Content="Cancel"
                    Cursor="Hand"
                    IsCancel="True"
                    Size="Large" />
            </via:XStackPanel>
        </via:XBorder>
    </Grid>
</dialogs:ModalDialogWindow>
