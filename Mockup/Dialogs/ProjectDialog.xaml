<dialogs:ModalDialogWindow
    x:Class="Mockup.Dialogs.ProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Mockup.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root"
    Title="{via:XLoc Dialog.Project.Edit.Title,
                     ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
    Width="400"
    MinHeight="370"
    d:DataContext="{d:DesignInstance Type=mockup:Project}"
    CornerRadius="10"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    ShowResizeGrip="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    SizeToContent="Height"
    Subtitle=""
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    TitleBarHeight="45"
    TitleBarPadding="20,0,0,0"
    TitleFontSize="16"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <dialogs:ModalDialogWindow.Effect>
        <DropShadowEffect
            BlurRadius="18"
            Direction="270"
            Opacity="0.20"
            ShadowDepth="5" />
    </dialogs:ModalDialogWindow.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <via:XTabControl
            Margin="20"
            HeaderAppearance="Underlined"
            HeaderPadding="14,7,14,7"
            HeaderSpacing="4"
            ShowBorder="False">
            <via:XTabItem Header="{via:XLoc Dialog.General, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <via:XTextBox
                        x:Name="InputName"
                        Header="{via:XLoc Dialog.Name,
                                          ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <via:XTextBox
                        x:Name="InputDescription"
                        Grid.Row="2"
                        Height="90"
                        Padding="2,3"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Header="{via:XLoc Dialog.Description,
                                          ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        MaxLines="6"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </Grid>
            </via:XTabItem>

            <via:XTabItem Header="{via:XLoc Dialog.Project.DeviceTab, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <via:XNumberBox
                        Grid.Row="0"
                        Header="{via:XLoc Dialog.Width,
                                          ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Maximum="2000"
                        Minimum="100"
                        Step="10"
                        Value="{Binding DeviceWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <via:XNumberBox
                        Grid.Row="0"
                        Grid.Column="2"
                        Header="{via:XLoc Dialog.Height,
                                          ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Maximum="2000"
                        Minimum="100"
                        Step="10"
                        Value="{Binding DeviceHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <via:XComboBox
                        x:Name="PART_ScreenSizes"
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        DisplayMemberPath="DisplayText"
                        Header="{via:XLoc Dialog.Project.DevicePreset,
                                          ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        SelectionChanged="PART_ScreenSizes_SelectionChanged" />

                </Grid>
            </via:XTabItem>

            <via:XTabItem Header="{via:XLoc Dialog.Project.ThemeSharingTab, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <via:XComboBox
                        DisplayMemberPath="Name"
                        Header="{via:XLoc Dialog.Project.ColorScheme,
                                          ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        ItemsSource="{Binding ElementName=root, Path=ColorSchemas}"
                        SelectedValue="{Binding ColorSchemaKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Key" />

                    <via:XTextBlock
                        Grid.Row="2"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                        Text="{via:XLoc Dialog.Project.ColorSchemeInfo,
                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        TextWrapping="Wrap" />

                    <via:XBorder
                        Grid.Row="4"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                        BorderThickness="0">
                        <via:XStackPanel Orientation="Horizontal" Spacing="30">
                            <via:XToggleSwitch Content="{via:XLoc Dialog.Project.SharedProject, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" IsChecked="{Binding IsShared, Mode=TwoWay}" />
                            <via:XToggleSwitch
                                Content="{via:XLoc Dialog.Project.ReadOnlySharedUsers,
                                                   ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                IsChecked="{Binding IsSharedReadonly, Mode=TwoWay}"
                                IsEnabled="{Binding IsShared}" />
                        </via:XStackPanel>
                    </via:XBorder>

                </Grid>
            </via:XTabItem>
        </via:XTabControl>

        <via:XBorder
            Grid.Row="1"
            Padding="20,15"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0"
            CornerRadius="0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    Width="100"
                    Height="30"
                    Padding="0"
                    Click="Ok_Click"
                    Content="{via:XLoc Common.OK,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    Width="100"
                    Height="30"
                    Padding="0"
                    Click="Cancel_Click"
                    Content="{via:XLoc Common.Cancel,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsCancel="True"
                    Size="Large" />
            </via:XStackPanel>
        </via:XBorder>
    </Grid>
</dialogs:ModalDialogWindow>
