<dialogs:ModalDialogWindow
    x:Class="Mockup.Dialogs.TemplateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Mockup.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    Title="{via:XLoc Dialog.Template.Edit.Title,
                     ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
    Width="320"
    d:DataContext="{d:DesignInstance Type=mockup:ScreenTemplate}"
    CornerRadius="10"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    ShowResizeGrip="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    SizeToContent="Height"
    Subtitle=""
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    TitleBarHeight="45"
    TitleBarPadding="20,0,0,0"
    TitleFontSize="16"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <dialogs:ModalDialogWindow.Effect>
        <DropShadowEffect
            BlurRadius="18"
            Direction="270"
            Opacity="0.20"
            ShadowDepth="5" />
    </dialogs:ModalDialogWindow.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="20"
            VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <via:XTextBox
                x:Name="InputName"
                Grid.Row="0"
                Header="{via:XLoc Dialog.Name,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <via:XTextBox
                x:Name="InputDescription"
                Grid.Row="2"
                Height="85"
                VerticalContentAlignment="Top"
                AcceptsReturn="True"
                Header="{via:XLoc Dialog.Description,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                MaxLines="4"
                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <via:XComboBox
                Grid.Row="4"
                Header="{via:XLoc Dialog.Category,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                IsEditable="True"
                IsTextSearchEnabled="True"
                ItemsSource="{Binding Source={x:Static mockup:MockupService.Mockup}, Path=TemplateGroupNames}"
                Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <via:XBorder
            Grid.Row="1"
            Padding="20,15"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0"
            CornerRadius="0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    Width="100"
                    Height="30"
                    Padding="0"
                    Click="Ok_Click"
                    Content="{via:XLoc Common.OK,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    Width="100"
                    Height="30"
                    Padding="0"
                    Click="Cancel_Click"
                    Content="{via:XLoc Common.Cancel,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsCancel="True"
                    Size="Large" />
            </via:XStackPanel>
        </via:XBorder>
    </Grid>
</dialogs:ModalDialogWindow>
