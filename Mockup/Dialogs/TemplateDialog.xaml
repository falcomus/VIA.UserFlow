<dialogs:ModalDialogWindow
    x:Class="Mockup.Dialogs.TemplateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:dialogs="clr-namespace:Mockup.Dialogs"
    xmlns:via="http://schemas.via.dev/wpf"
    Title="Edit template"
    Subtitle=""
    Width="400"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    ShowMinimizeButton="False"
    ShowMaximizeButton="False"
    ShowResizeGrip="False"
    TitleBarHeight="45"
    TitleFontSize="16"
    TitleBarPadding="20,0,0,0"
    CornerRadius="10"
    WindowStartupLocation="CenterOwner"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    d:DataContext="{d:DesignInstance Type=mockup:ScreenTemplate}"
    mc:Ignorable="d">

    <dialogs:ModalDialogWindow.Effect>
        <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.20" ShadowDepth="5" />
    </dialogs:ModalDialogWindow.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,26" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <via:XTextBox
                x:Name="InputName"
                Grid.Row="0"
                Header="Name"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <via:XTextBox
                x:Name="InputDescription"
                Grid.Row="2"
                Height="85"
                AcceptsReturn="True"
                Header="Description"
                MaxLines="4"
                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalContentAlignment="Top" />

            <via:XComboBox
                Grid.Row="4"
                Header="Category"
                IsEditable="True"
                IsTextSearchEnabled="True"
                ItemsSource="{Binding Source={x:Static mockup:MockupService.Mockup}, Path=TemplateGroupNames}"
                Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <via:XBorder
            Grid.Row="1"
            Padding="28,14"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    Width="112"
                    Click="Ok_Click"
                    Content="OK"
                    Cursor="Hand"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    Width="92"
                    Click="Cancel_Click"
                    Content="Cancel"
                    Cursor="Hand"
                    IsCancel="True"
                    Size="Large" />
            </via:XStackPanel>
        </via:XBorder>
    </Grid>
</dialogs:ModalDialogWindow>
