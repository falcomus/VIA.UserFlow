<Window
    x:Class="Mockup.Dialogs.XColorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:resources="clr-namespace:Mockup.Resources"
    Title="{via:XLoc Dialog.ColorPicker.Title, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
    Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <via:XColorPicker
            x:Name="PART_ColorPicker"
            Grid.Row="0"
            SelectedColor="{Binding SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <via:XStackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <via:XButton
                Width="110"
                Click="Ok_Click"
                Content="{via:XLoc Common.OK, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                Cursor="Hand"
                IsDefault="True"
                IsTabStop="False"
                Variant="Primary" />
            <via:XButton
                Width="80"
                Content="{via:XLoc Common.Cancel, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                Cursor="Hand"
                IsCancel="True"
                IsTabStop="False" />
        </via:XStackPanel>
    </Grid>
</Window>
