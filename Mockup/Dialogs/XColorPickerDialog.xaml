<dialogs:ModalDialogWindow
    x:Class="Mockup.Dialogs.XColorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:Mockup.Dialogs"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    Title="{via:XLoc Dialog.ColorPicker.Title,
                     ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
    Width="560"
    BorderThickness="1"
    CornerRadius="10"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    ShowResizeGrip="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    SizeToContent="Height"
    Subtitle=""
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    TitleBarHeight="45"
    TitleBarPadding="20,0,0,0"
    TitleFontSize="16"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    WindowStartupLocation="CenterOwner">

    <dialogs:ModalDialogWindow.Effect>
        <DropShadowEffect
            BlurRadius="18"
            Direction="270"
            Opacity="0.20"
            ShadowDepth="5" />
    </dialogs:ModalDialogWindow.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">
            <via:XColorPicker x:Name="PART_ColorPicker" SelectedColor="{Binding SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <via:XBorder
            Grid.Row="1"
            Padding="20,15"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0"
            CornerRadius="0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    Width="100"
                    Height="30"
                    Padding="0"
                    Click="Ok_Click"
                    Content="{via:XLoc Common.OK,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    Width="100"
                    Height="30"
                    Padding="0"
                    Click="Cancel_Click"
                    Content="{via:XLoc Common.Cancel,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Cursor="Hand"
                    IsCancel="True"
                    Size="Large" />
            </via:XStackPanel>
        </via:XBorder>
    </Grid>

</dialogs:ModalDialogWindow>
