<UserControl
    x:Class="Mockup.Rendering.LiveViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="clr-namespace:Mockup.Designer"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    PreviewMouseWheel="LayoutRoot_PreviewMouseWheel"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot">
        <rendering:ScreenDesigner x:Name="PART_Designer" />
    </Grid>

</UserControl>
