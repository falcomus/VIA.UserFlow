<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SelectionBG" Color="#E5F0FF" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#F8FAFD" />
    <SolidColorBrush x:Key="DataGridRowBorderBrush" Color="#EEF2F7" />

    <Style
        x:Key="MockupDataGridRowStyle"
        BasedOn="{StaticResource DataGridRowStyle}"
        TargetType="DataGridRow">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#FF101828" />
        <Setter Property="BorderBrush" Value="{StaticResource DataGridRowBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="32" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBG}" />
                <Setter Property="Foreground" Value="#FF101828" />
                <Setter Property="BorderBrush" Value="#D6E8FF" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SelectionBG}" />
                <Setter Property="Foreground" Value="#FF101828" />
                <Setter Property="BorderBrush" Value="#D6E8FF" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="MockupDataGridCellStyle"
        BasedOn="{StaticResource DataGridCellStyle.Small}"
        TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FF101828" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="6,0" />

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF101828" />
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
