<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type ui:DropDown}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimarySubtleHover}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:DropDown}">
                    <Grid>
                        <Border
                            x:Name="PART_ClickArea"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Left Content  -->
                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding LeftContent}" />

                                <!--  Arrow Button  -->
                                <ToggleButton
                                    x:Name="PART_Toggle"
                                    Grid.Column="1"
                                    Width="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <ToggleButton.Content>
                                        <Path
                                            Width="8"
                                            Height="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M0,0 L4,4 L8,0 Z"
                                            Fill="{TemplateBinding ArrowColor}"
                                            Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="LayoutTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=PART_Toggle}" Value="True">
                                                            <Setter Property="LayoutTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="180" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </ToggleButton.Content>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!--  Dropdown Popup  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PART_ClickArea}"
                            PopupAnimation="Fade"
                            StaysOpen="False"
                            VerticalOffset="1">
                            <via:XBorder
                                Margin="30"
                                Padding="2"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceOverlay}}"
                                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}"
                                BorderThickness="1"
                                Effect="{DynamicResource EffectShadow3}">
                                <ContentPresenter Content="{TemplateBinding DropDownContent}" />
                            </via:XBorder>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
