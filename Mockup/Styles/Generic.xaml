<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mockup.Designer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Mockup.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Themes;component/Themes/Generic.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/ViaWorkbenchControls.xaml" />

        <!--  Designer Templates  -->
        <ResourceDictionary Source="/VIA.Mockup;component/Designer/DesignerTemplates/DesignerTemplates.xaml" />

        <!--  Controls  -->

        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XPanel.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XTabControl.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XTabControl2.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XTabControl3.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/DropDown.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/Expander.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XContextMenu.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/ViewContextMenus.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/Converters.xaml" />

    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="DesignerNavigatorSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.Primary}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Border
                                Width="6"
                                Height="34"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                CornerRadius="3" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <Ellipse
                                    Width="3"
                                    Height="3"
                                    Margin="0,0,0,3"
                                    Fill="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}" />
                                <Ellipse
                                    Width="3"
                                    Height="3"
                                    Margin="0,0,0,3"
                                    Fill="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}" />
                                <Ellipse
                                    Width="3"
                                    Height="3"
                                    Fill="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type views:DesignerWorkspaceHost}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsToolboxPinned" Value="{Binding ToolboxPinned, Mode=TwoWay}" />
        <Setter Property="ToolboxWidth" Value="{Binding ToolboxWidth, Mode=TwoWay}" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:DesignerWorkspaceHost}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="1"
                            Width="{TemplateBinding EffectiveToolboxReservedWidth}"
                            IsHitTestVisible="False" />

                        <ContentPresenter
                            Grid.Column="0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <views:ToolboxView
                            Grid.ColumnSpan="3"
                            d:Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            Panel.ZIndex="20"
                            DockWidth="{Binding ToolboxWidth, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            IsFlyoutPinned="{Binding IsToolboxPinned, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
