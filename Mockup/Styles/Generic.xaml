<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Mockup.Designer"
    xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Themes;component/Themes/Generic.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/ViaWorkbenchControls.xaml" />

        <!--  Designer Templates  -->
        <ResourceDictionary Source="/VIA.Mockup;component/Designer/DesignerTemplates/DesignerTemplates.xaml" />

        <!--  Controls  -->

        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XPanel.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XTabControl.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XTabControl2.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XTabControl3.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/DropDown.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/Expander.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/ContextMenu.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/XContextMenu.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/ViewContextMenus.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/ChipListBox.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/ModernCardStyle.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/DataGrid.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/Converters.xaml" />

    </ResourceDictionary.MergedDictionaries>


    <!--  COLORS  -->

    <!--  App shell  -->
    <SolidColorBrush x:Key="AppShellBrush" Color="#20242B" />
    <SolidColorBrush x:Key="AppShellAltBrush" Color="#303540" />
    <SolidColorBrush x:Key="AppShellBorderBrush" Color="#2D333C" />
    <SolidColorBrush x:Key="AppStatusBarBrush" Color="#20242B" />
    <SolidColorBrush x:Key="AppStatusBarItemBrush" Color="#303540" />

    <!--  Neutral surfaces  -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E0EA" />
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#C7D0DC" />
    <SolidColorBrush x:Key="PanelBorder" Color="#D8E0EA" />
    <SolidColorBrush x:Key="SubHeaderBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="DesignerBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="TabHeaderBrush" Color="#303540" />
    <SolidColorBrush x:Key="SearchBoxBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ListBoxBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="ToolBarElemBorderBrush" Color="#D8E0EA" />
    <SolidColorBrush x:Key="ToolBarElemBGBrush" Color="#F2F5F9" />
    <SolidColorBrush x:Key="NoDataBackground" Color="#EEF2F7" />
    <SolidColorBrush x:Key="DesignAreaBackground" Color="#14000000" />

    <!--  Accent system  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#256AA0" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#213D58" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#4AA3FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D92D20" />
    <SolidColorBrush x:Key="LightDangerBrush" Color="#FF7A7A" />
    <SolidColorBrush x:Key="TertiaryRegionBrush" Color="#EEF2F7" />

    <!--  Selection  -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#2580B0FA" />
    <SolidColorBrush x:Key="SelectionBorder" Color="#5580B0FA" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#101828" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475467" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#667085" />

    <!--  Custom colors  -->
    <Color x:Key="CheckerBackgroundColor">#C5C6C8</Color>
    <Color x:Key="CheckerForegroundColor">#CCCDCF</Color>

    <SolidColorBrush x:Key="DialogBackground" Color="#303133" />

    <SolidColorBrush x:Key="SubHeaderBackgroundBrush" Color="#DDE0E5" />
    <SolidColorBrush x:Key="ExpanderHeaderBrush" Color="#EAECF0" />

</ResourceDictionary>
