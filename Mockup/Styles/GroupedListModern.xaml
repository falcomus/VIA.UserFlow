<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behav="clr-namespace:Mockup.Behaviour"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:via="http://schemas.via.dev/wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/Expander.xaml" />
        <ResourceDictionary Source="/VIA.Mockup;component/Styles/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  =========================================================  -->
    <!--  BRUSHES / CONSTANTS  -->
    <!--  =========================================================  -->

    <SolidColorBrush x:Key="GroupedListItemHoverBrush" Color="#FFF4F8FC" />
    <SolidColorBrush x:Key="GroupedListItemSelectedBrush" Color="#FFE3F0FF" />
    <SolidColorBrush x:Key="GroupedListItemSelectedBorderBrush" Color="#FFBBD7F4" />
    <SolidColorBrush x:Key="GroupedListAccentBrush" Color="#FF4AA3FF" />
    <SolidColorBrush x:Key="GroupedListItemBorderBrush" Color="#FFE8EEF5" />

    <SolidColorBrush x:Key="GroupedListActionForegroundBrush" Color="#FF667085" />
    <SolidColorBrush x:Key="GroupedListActionHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="GroupedListDeleteHoverBrush" Color="#18D92D20" />
    <SolidColorBrush x:Key="GroupedListDeleteHoverForegroundBrush" Color="#FFC62828" />

    <SolidColorBrush x:Key="GroupedListBadgeForegroundBrush" Color="#FF245A92" />
    <SolidColorBrush x:Key="GroupedListBadgeBackgroundBrush" Color="#F0FAFF" />
    <SolidColorBrush x:Key="GroupedListBadgeBorderBrush" Color="#D0C3DBFF" />


    <Style
        x:Key="GroupedListExpanderStyle"
        BasedOn="{StaticResource MetalExpanderStyleSmall}"
        TargetType="Expander">
        <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.SurfaceDark}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
    </Style>

    <!--  =========================================================  -->
    <!--  GROUP ITEM STYLE  -->
    <!--  =========================================================  -->

    <Style x:Key="GroupedListGroupItemStyle" TargetType="{x:Type GroupItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupItem}">
                    <Expander Header="{Binding Name}" Style="{StaticResource GroupedListExpanderStyle}">
                        <ItemsPresenter />
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="GroupedListGroupItemStyle.PersistentState"
        BasedOn="{StaticResource GroupedListGroupItemStyle}"
        TargetType="{x:Type GroupItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupItem}">
                    <Expander Header="{Binding Name}" Style="{StaticResource GroupedListExpanderStyle}">
                        <ItemsPresenter />
                    </Expander>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================  -->
    <!--  LISTBOX ITEM STYLE  -->
    <!--  =========================================================  -->

    <Style x:Key="GroupedListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="OuterBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="4"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                        <Grid>
                            <Border
                                x:Name="AccentBar"
                                Width="4"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource PrimaryBrush}"
                                Opacity="0" />

                            <ContentPresenter
                                Margin="6,0,2,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.HoverBackground}}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.SelectionBackground}}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.SelectionBorder}}" />
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.SelectionBackground}}" />
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================  -->
    <!--  ACTION BUTTONS  -->
    <!--  =========================================================  -->

    <Style x:Key="GroupedListActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource GroupedListActionForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GroupedListActionHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="GroupedListDeleteButtonStyle"
        BasedOn="{StaticResource GroupedListActionButtonStyle}"
        TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource GroupedListDeleteHoverForegroundBrush}" />
                <Setter Property="Background" Value="{StaticResource GroupedListDeleteHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  =========================================================  -->
    <!--  BADGE / STATUS  -->
    <!--  =========================================================  -->

    <Style x:Key="GroupedListHomeBadgeBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Padding" Value="7,0,7,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource GroupedListBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GroupedListBadgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  =========================================================  -->
    <!--  SCREEN ITEM TEMPLATE  -->
    <!--  =========================================================  -->

    <DataTemplate x:Key="GroupedScreenItemTemplate" DataType="{x:Type mockup:Screen}">
        <Grid
            Margin="0"
            ext:GridEx.ColDef="*,Auto"
            ext:GridEx.RowDef="Auto,Auto">
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="12,5,8,6"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Medium"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />

                <Border
                    Style="{StaticResource GroupedListHomeBadgeBorderStyle}"
                    ToolTip="Main Screen"
                    Visibility="{Binding IsHomeScreen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ico:PackIconMaterial
                            Width="13"
                            Height="13"
                            Margin="0,0,3,1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource GroupedListBadgeForegroundBrush}"
                            Kind="Home" />
                        <TextBlock
                            Margin="0,0,1,0.5"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{StaticResource GroupedListBadgeForegroundBrush}"
                            Text="Main" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <via:XIconButton
                    Width="22"
                    Height="22"
                    MinWidth="22"
                    MinHeight="22"
                    Margin="0,2,0,2"
                    Padding="0"
                    Background="#10000000"
                    BorderThickness="0"
                    Command="{Binding DataContext.EditScreenCoreCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}"
                    CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Cursor="Hand"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Icon="{via:MaterialDesignIcon Kind=Edit}"
                    IconSize="13"
                    Size="Small"
                    ToolTip="Edit Screen"
                    Variant="Default" />

                <via:XIconButton
                    Width="22"
                    Height="22"
                    MinWidth="22"
                    MinHeight="22"
                    Margin="2,2,-7,2"
                    Padding="0"
                    Background="#10000000"
                    BorderThickness="0"
                    Command="{Binding DataContext.DeleteScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}"
                    CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Cursor="Hand"
                    Foreground="{DynamicResource DangerBrush}"
                    Icon="{via:MaterialDesignIcon Kind=Delete}"
                    IconSize="13"
                    Size="Small"
                    ToolTip="Delete Screen"
                    Variant="Default" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="12,-3,12,8"
                FontSize="12"
                Opacity="0.8"
                Text="{Binding Descr}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="{Binding Descr, Converter={StaticResource StringToVisibilityConverter}}" />
        </Grid>
    </DataTemplate>

    <!--  =========================================================  -->
    <!--  TEMPLATE ITEM TEMPLATE  -->
    <!--  =========================================================  -->

    <DataTemplate x:Key="GroupedTemplateItemTemplate" DataType="{x:Type mockup:ScreenTemplate}">
        <Grid
            Margin="0"
            ext:GridEx.ColDef="*,Auto"
            ext:GridEx.RowDef="Auto,Auto">
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="12,5,8,6"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Medium"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <via:XIconButton
                    Width="22"
                    Height="22"
                    MinWidth="22"
                    MinHeight="22"
                    Margin="0,2,0,2"
                    Padding="0"
                    Background="#10000000"
                    BorderThickness="0"
                    Command="{Binding DataContext.EditTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}"
                    CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Cursor="Hand"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Icon="{via:MaterialDesignIcon Kind=Edit}"
                    IconSize="13"
                    Size="Small"
                    ToolTip="Edit Template"
                    Variant="Default" />

                <via:XIconButton
                    Width="22"
                    Height="22"
                    MinWidth="22"
                    MinHeight="22"
                    Margin="2,2,-7,2"
                    Padding="0"
                    Background="#10000000"
                    BorderThickness="0"
                    Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}"
                    CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Cursor="Hand"
                    Foreground="{DynamicResource DangerBrush}"
                    Icon="{via:MaterialDesignIcon Kind=Delete}"
                    IconSize="13"
                    Size="Small"
                    ToolTip="Delete Template"
                    Variant="Default" />

            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="12,-3,12,8"
                FontSize="12"
                Opacity="0.8"
                Text="{Binding Description}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
        </Grid>
    </DataTemplate>


    <!--  =========================================================  -->
    <!--  POUPUP ITEM TEMPLATE  -->
    <!--  =========================================================  -->

    <DataTemplate x:Key="GroupedPopupItemTemplate" DataType="{x:Type mockup:ScreenPopup}">
        <Grid
            Margin="0"
            ext:GridEx.ColDef="*,Auto"
            ext:GridEx.RowDef="Auto,Auto">
            <TextBlock
                x:Name="lblName"
                Grid.Row="0"
                Grid.Column="0"
                Margin="12,5,8,6"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="Medium"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <via:XIconButton
                    Width="22"
                    Height="22"
                    MinWidth="22"
                    MinHeight="22"
                    Margin="0,2,0,2"
                    Padding="0"
                    Background="#10000000"
                    BorderThickness="0"
                    Command="{Binding DataContext.EditPopupCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}"
                    CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Cursor="Hand"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Icon="{via:MaterialDesignIcon Kind=Edit}"
                    IconSize="13"
                    Size="Small"
                    ToolTip="Edit Popup"
                    Variant="Default" />

                <via:XIconButton
                    Width="22"
                    Height="22"
                    MinWidth="22"
                    MinHeight="22"
                    Margin="2,2,-7,2"
                    Padding="0"
                    Background="#10000000"
                    BorderThickness="0"
                    Command="{Binding DataContext.DeletePopupCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}"
                    CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Cursor="Hand"
                    Foreground="{DynamicResource DangerBrush}"
                    Icon="{via:MaterialDesignIcon Kind=Delete}"
                    IconSize="13"
                    Size="Small"
                    ToolTip="Delete Popup"
                    Variant="Default" />

            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="12,-3,12,8"
                HorizontalAlignment="Left"
                FontSize="12"
                Opacity="0.8"
                Text="{Binding Description}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="WrapWithOverflow"
                Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
