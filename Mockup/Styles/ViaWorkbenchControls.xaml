<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:via="http://schemas.via.dev/wpf">

    <DropShadowEffect
        x:Key="EffectShadow1"
        BlurRadius="8"
        Direction="270"
        Opacity="0.12"
        ShadowDepth="1" />

    <DropShadowEffect
        x:Key="EffectShadow2"
        BlurRadius="12"
        Direction="270"
        Opacity="0.16"
        ShadowDepth="2" />

    <DropShadowEffect
        x:Key="EffectShadow3"
        BlurRadius="18"
        Direction="270"
        Opacity="0.20"
        ShadowDepth="4" />

    <Style x:Key="StatusBarBaseStyle" TargetType="StatusBar">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>
