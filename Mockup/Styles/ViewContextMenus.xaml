<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:via="http://schemas.via.dev/wpf">

    <via:XContextMenu
        x:Key="ScreenListContextMenu"
        x:Shared="False">

        <via:XMenuItem
            Command="{Binding TargetDataContext.NewScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="New Screen"
            Icon="{via:MaterialIcon Kind=Plus}"
            Variant="Primary" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.EditScreenCoreCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Edit Screen"
            Icon="{via:MaterialIcon Kind=PencilOutline}" />

        <via:XMenuItem
            Header="Duplicate Screen"
            Icon="{via:MaterialIcon Kind=ContentCopy}" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.DeleteScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Delete Screen"
            Icon="{via:MaterialIcon Kind=DeleteOutline}"
            Variant="Danger" />

    </via:XContextMenu>

    <via:XContextMenu
        x:Key="TemplateListContextMenu"
        x:Shared="False">

        <via:XMenuItem
            Command="{Binding TargetDataContext.NewTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="New Template"
            Icon="{via:MaterialIcon Kind=Plus}"
            Variant="Primary" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.EditTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Edit Template"
            Icon="{via:MaterialIcon Kind=PencilOutline}" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Delete Template"
            Icon="{via:MaterialIcon Kind=DeleteOutline}"
            Variant="Danger" />

    </via:XContextMenu>

    <via:XContextMenu
        x:Key="PopupListContextMenu"
        x:Shared="False">

        <via:XMenuItem
            Command="{Binding TargetDataContext.NewPopupCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="New Popup"
            Icon="{via:MaterialIcon Kind=Plus}"
            Variant="Primary" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.EditPopupCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Edit Popup"
            Icon="{via:MaterialIcon Kind=PencilOutline}" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.DeletePopupCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Delete Popup"
            Icon="{via:MaterialIcon Kind=DeleteOutline}"
            Variant="Danger" />

    </via:XContextMenu>

    <via:XContextMenu
        x:Key="ProjectScreenListContextMenu"
        x:Shared="False">

        <via:XMenuItem
            Command="{Binding TargetDataContext.NewScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="New Screen"
            Icon="{via:MaterialIcon Kind=Plus}"
            Variant="Primary" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.EditScreenCoreCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Edit Screen"
            Icon="{via:MaterialIcon Kind=PencilOutline}" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.DeleteScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Delete Screen"
            Icon="{via:MaterialIcon Kind=DeleteOutline}"
            Variant="Danger" />

        <Separator Style="{DynamicResource XMenuSeparatorStyle}" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.SetAsHomeScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetItem, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Set as Home Screen"
            Icon="{via:MaterialIcon Kind=HomeOutline}" />

    </via:XContextMenu>
    <via:XContextMenu
        x:Key="ProjectActionsContextMenu"
        x:Shared="False">

        <via:XMenuItem
            Command="{Binding TargetDataContext.SaveProjectAsCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Save Project As..."
            Icon="{via:MaterialIcon Kind=ContentSave}"
            Variant="Primary" />

        <Separator Style="{DynamicResource XMenuSeparatorStyle}" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetDataContext.CurrentProjectFile, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Edit Project Settings"
            Icon="{via:MaterialIcon Kind=PencilOutline}" />

        <via:XMenuItem
            Command="{Binding TargetDataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            CommandParameter="{Binding TargetDataContext.CurrentProjectFile, RelativeSource={RelativeSource AncestorType={x:Type via:XContextMenu}}}"
            Header="Delete Project"
            Icon="{via:MaterialIcon Kind=DeleteOutline}"
            Variant="Danger" />

    </via:XContextMenu>
</ResourceDictionary>