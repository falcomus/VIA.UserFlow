<!--
    ======================================================================================
    FILE: Mockup.UIControls/XContextMenu.xaml

    PURPOSE:
    - Kompakter ContextMenu-Style auf VIA.WPF-Tokens
    - Unterstützt:
      * normale Items
      * Check-Items (Haken)
      * Radio-Optik (Kreis) für IsCheckable+IsChecked (Enum-Binding)
      * Icons via MenuItem.Icon (z.B. MahApps PackIcon)

    USAGE:
      - ContextMenu:         Style="{StaticResource XContextMenu}"
      - Normale MenuItems:   Style="{StaticResource XMenuItem}"
      - Check-MenuItems:     Style="{StaticResource XMenuItemCheck}"
      - Radio-MenuItems:     Style="{StaticResource XMenuItemRadio}"
      - Separator:           Style="{StaticResource XMenuSeparator}"

    ICONS (von außen):
      - Pro MenuItem:
          <MenuItem ... Style="{StaticResource XMenuItem}">
              <MenuItem.Icon>
                  <ico:PackIconMaterialDesign Width="16" Height="16" Kind="Add" />
              </MenuItem.Icon>
          </MenuItem>

    TUNING (zentral):
      - Menü:                XCtxMenuMinWidth, XCtxMenuCornerRadius, XCtxMenuPadding
      - Items:               XCtxItemHeight, XCtxItemMargin, XCtxItemPadding
      - Spalten:             XCtxGlyphColWidth, XCtxIconColWidth
      - Glyph:               XCtxCheckSize, XCtxRadioSize, XCtxRadioInnerSize
      - Typo:                FontSize/FontWeight im XContextMenu Style
      - Separator bis links: XContextMenu Padding=0 + XMenuSeparator Margin=0
    ======================================================================================-->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:via="http://schemas.via.dev/wpf">

    <!--  =========================================================  -->
    <!--  THEME TOKENS  -->
    <!--  =========================================================  -->

    <!--  =========================================================  -->
    <!--  LAYOUT TOKENS (zentral, konsistent)  -->
    <!--  =========================================================  -->

    <!--  Menü  -->
    <sys:Double x:Key="XCtxMenuMinWidth">144</sys:Double>
    <CornerRadius x:Key="XCtxMenuCornerRadius">6</CornerRadius>

    <!--  WICHTIG: Padding=0, damit Separator bis x=0 geht  -->
    <Thickness x:Key="XCtxMenuPadding">4 4</Thickness>

    <!--  Items  -->
    <sys:Double x:Key="XCtxItemHeight">30</sys:Double>
    <Thickness x:Key="XCtxItemMargin">0</Thickness>

    <!--  Innen: links klein, damit alles kompakter wirkt  -->
    <Thickness x:Key="XCtxItemPadding">4,0,4,0</Thickness>

    <!--  Spalten: MUST be GridLength (für ColumnDefinition.Width)  -->
    <GridLength x:Key="XCtxGlyphColWidth">20</GridLength>
    <!--  links: Check/Radio Platz  -->
    <GridLength x:Key="XCtxIconColWidth">22</GridLength>
    <!--  Icon Platz (MenuItem.Icon)  -->

    <!--  Glyph Größen  -->
    <sys:Double x:Key="XCtxCheckSize">14</sys:Double>
    <sys:Double x:Key="XCtxRadioSize">14</sys:Double>
    <sys:Double x:Key="XCtxRadioInnerSize">7</sys:Double>

    <!--  Separator  -->
    <Thickness x:Key="XCtxSepMargin">0,6,0,6</Thickness>
    <!--  bis ganz links/rechts  -->

    <!--  =========================================================  -->
    <!--  CONTEXT MENU STYLE  -->
    <!--  =========================================================  -->

    <Style x:Key="XContextMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />

        <!--  Typo: hier zentral anpassen  -->
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />

        <Setter Property="Padding" Value="{StaticResource XCtxMenuPadding}" />
        <Setter Property="MinWidth" Value="{StaticResource XCtxMenuMinWidth}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource XCtxMenuCornerRadius}"
                        SnapsToDevicePixels="True">
                        <!--  kein inner Padding => Separator kann x=0  -->
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================  -->
    <!--  SEPARATOR STYLE (bis x=0)  -->
    <!--  =========================================================  -->

    <Style x:Key="XMenuSeparator" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="{StaticResource XCtxSepMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  =========================================================  -->
    <!--  BASE MENUITEM TEMPLATE (Glyph | Icon | Text)  -->
    <!--  =========================================================  -->

    <ControlTemplate x:Key="XMenuItemTemplate" TargetType="{x:Type MenuItem}">
        <Border
            x:Name="Bd"
            Height="{StaticResource XCtxItemHeight}"
            Margin="{StaticResource XCtxItemMargin}"
            Padding="0"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="4"
            SnapsToDevicePixels="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <!--  gleiche Spalte wie Check/Radio  -->
                    <ColumnDefinition Width="{StaticResource XCtxGlyphColWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Icon exakt in Glyph-Spalte  -->
                <ContentPresenter
                    Grid.Column="0"
                    Margin="4,0,4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ContentSource="Icon" />

                <!--  Text startet konsistent  -->
                <ContentPresenter
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="4,0,10,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True"
                    TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextTertiary}}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.StateHover}}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  =========================================================  -->
    <!--  CHECK TEMPLATE (Glyph Check | Icon | Text)  -->
    <!--  =========================================================  -->

    <ControlTemplate x:Key="XMenuItemCheckTemplate" TargetType="{x:Type MenuItem}">
        <Border
            x:Name="Bd"
            Height="{StaticResource XCtxItemHeight}"
            Margin="{StaticResource XCtxItemMargin}"
            Padding="{StaticResource XCtxItemPadding}"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="4"
            SnapsToDevicePixels="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource XCtxGlyphColWidth}" />
                    <ColumnDefinition Width="{StaticResource XCtxIconColWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Check Glyph (zentriert)  -->
                <Grid
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="CheckBox"
                        Width="{StaticResource XCtxCheckSize}"
                        Height="{StaticResource XCtxCheckSize}"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                        BorderThickness="1"
                        CornerRadius="3"
                        SnapsToDevicePixels="True" />

                    <Path
                        x:Name="CheckMark"
                        Width="8"
                        Height="7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 1 3 L 3 6 L 7 1"
                        SnapsToDevicePixels="True"
                        Stroke="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="2"
                        Visibility="Collapsed" />
                </Grid>

                <!--  ICON von außen  -->
                <ContentPresenter
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ContentSource="Icon"
                    SnapsToDevicePixels="True" />

                <!--  Text  -->
                <ContentPresenter
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="4,0,0,2"
                    VerticalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True"
                    TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextDisabled}}" />
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>

            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.StateHover}}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}" />
            </Trigger>

            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBox" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.Primary}}" />
                <Setter TargetName="CheckBox" Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.Primary}}" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  =========================================================  -->
    <!--  RADIO TEMPLATE (Glyph Radio | Icon | Text)  -->
    <!--  =========================================================  -->

    <ControlTemplate x:Key="XMenuItemRadioTemplate" TargetType="{x:Type MenuItem}">
        <Border
            x:Name="Bd"
            Height="{StaticResource XCtxItemHeight}"
            Margin="{StaticResource XCtxItemMargin}"
            Padding="{StaticResource XCtxItemPadding}"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="4"
            SnapsToDevicePixels="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource XCtxGlyphColWidth}" />
                    <ColumnDefinition Width="{StaticResource XCtxIconColWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Radio Glyph (zentriert)  -->
                <Grid
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <Ellipse
                        x:Name="Outer"
                        Width="{StaticResource XCtxRadioSize}"
                        Height="{StaticResource XCtxRadioSize}"
                        Fill="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                        SnapsToDevicePixels="True"
                        Stroke="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                        StrokeThickness="1" />

                    <Ellipse
                        x:Name="Inner"
                        Width="{StaticResource XCtxRadioInnerSize}"
                        Height="{StaticResource XCtxRadioInnerSize}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                        SnapsToDevicePixels="True"
                        Visibility="Collapsed" />
                </Grid>

                <!--  ICON von außen  -->
                <ContentPresenter
                    Grid.Column="0"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ContentSource="Icon"
                    SnapsToDevicePixels="True" />

                <!--  Text  -->
                <ContentPresenter
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="4,0,0,2"
                    VerticalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True"
                    TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextDisabled}}" />
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>

            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.StateHover}}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}" />
            </Trigger>

            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource {x:Static via:XBrushKeys.Primary}}" />
                <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  =========================================================  -->
    <!--  PUBLIC MENUITEM STYLES  -->
    <!--  =========================================================  -->

    <Style x:Key="XMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
        <Setter Property="Template" Value="{StaticResource XMenuItemTemplate}" />
    </Style>

    <Style x:Key="XMenuItemCheck" TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsCheckable" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
        <Setter Property="Template" Value="{StaticResource XMenuItemCheckTemplate}" />
    </Style>

    <Style x:Key="XMenuItemRadio" TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsCheckable" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
        <Setter Property="Template" Value="{StaticResource XMenuItemRadioTemplate}" />
    </Style>

</ResourceDictionary>
