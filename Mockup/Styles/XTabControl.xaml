<!--  XTabControl  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:via="http://schemas.via.dev/wpf">

    <!--  =========================================================  -->
    <!--  Main shell navigation  -->
    <!--  =========================================================  -->

    <Style x:Key="CustomTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Height" Value="46" />
        <Setter Property="MinWidth" Value="74" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">

                    <Grid
                        Margin="12,5,12,0"
                        VerticalAlignment="Center"
                        ext:GridEx.RowDef="*,Auto"
                        Background="Transparent"
                        Cursor="Hand"
                        SnapsToDevicePixels="True">

                        <ContentPresenter
                            x:Name="ContentSite"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            RecognizesAccessKey="True"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="17"
                            TextElement.FontWeight="SemiBold"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Border
                            x:Name="Underline"
                            Grid.Row="1"
                            Height="3"
                            Margin="0,1,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            CornerRadius="2" />

                    </Grid>


                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelSelectedItemForeground}}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.Primary}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentSite" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.PrimaryLight}}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelSelectedItemForeground}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CustomTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.Canvas}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <via:XBorder
                            Grid.Row="0"
                            Padding="0"
                            Background="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelBackground}}"
                            BorderThickness="0"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                            <DockPanel LastChildFill="True">
                                <Image
                                    Height="50"
                                    Margin="-2,2,22,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    Source="/VIA.Mockup;component/Resources/PNG/via_logo_white.png" />

                                <TabPanel
                                    x:Name="HeaderPanel"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    Panel.ZIndex="1"
                                    Background="Transparent"
                                    IsItemsHost="True"
                                    KeyboardNavigation.TabIndex="1" />
                            </DockPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Row="1"
                            Padding="0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                ContentSource="SelectedContent"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </via:XBorder>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
