<UserControl
    x:Class="Mockup.UIControls.AlignmentToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    mc:Ignorable="d">

    <via:XToggleDropDown
        Content="Alignment"
        Focusable="False"
        IsTabStop="False">
        <via:XToggleDropDown.DropDownContent>
            <Border
                Padding="8"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="18"
                        Direction="315"
                        Opacity="0.16"
                        ShadowDepth="4" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock
                        Margin="2,0,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                        Text="ALIGNMENT" />

                    <via:XStackPanel Orientation="Horizontal" Spacing="4">
                        <via:XIconButton
                            Command="{Binding AlignLeftCommand}"
                            Icon="{via:MaterialIcon Kind=FormatHorizontalAlignLeft}"
                            ToolTip="Align Left" />
                        <via:XIconButton
                            Command="{Binding AlignCenterCommand}"
                            Icon="{via:MaterialIcon Kind=FormatHorizontalAlignCenter}"
                            ToolTip="Align Center" />
                        <via:XIconButton
                            Command="{Binding AlignRightCommand}"
                            Icon="{via:MaterialIcon Kind=FormatHorizontalAlignRight}"
                            ToolTip="Align Right" />
                        <via:XIconButton
                            Margin="6,0,0,0"
                            Command="{Binding AlignTopCommand}"
                            Icon="{via:MaterialIcon Kind=FormatVerticalAlignTop}"
                            ToolTip="Align Top" />
                        <via:XIconButton
                            Command="{Binding AlignMiddleCommand}"
                            Icon="{via:MaterialIcon Kind=FormatVerticalAlignCenter}"
                            ToolTip="Align Middle" />
                        <via:XIconButton
                            Command="{Binding AlignBottomCommand}"
                            Icon="{via:MaterialIcon Kind=FormatVerticalAlignBottom}"
                            ToolTip="Align Bottom" />
                    </via:XStackPanel>

                    <TextBlock
                        Margin="2,12,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                        Text="SIZE &amp; SPACING" />

                    <via:XStackPanel Orientation="Horizontal" Spacing="4">
                        <via:XIconButton
                            Command="{Binding MakeSameWidthCommand}"
                            Icon="{via:MaterialIcon Kind=ArrowExpandHorizontal}"
                            ToolTip="Make Same Width" />
                        <via:XIconButton
                            Command="{Binding MakeSameHeightCommand}"
                            Icon="{via:MaterialIcon Kind=ArrowExpandVertical}"
                            ToolTip="Make Same Height" />
                        <via:XIconButton
                            Command="{Binding MakeSameSizeCommand}"
                            Icon="{via:MaterialIcon Kind=CropSquare}"
                            ToolTip="Make Same Size" />
                        <via:XIconButton
                            Margin="6,0,0,0"
                            Command="{Binding SpaceHorEvenCommand}"
                            Icon="{via:MaterialIcon Kind=UnfoldMoreVertical}"
                            ToolTip="Space Horizontal Even" />
                        <via:XIconButton
                            Command="{Binding SpaceVerEvenCommand}"
                            Icon="{via:MaterialIcon Kind=UnfoldMoreHorizontal}"
                            ToolTip="Space Vertical Even" />
                    </via:XStackPanel>

                    <TextBlock
                        Margin="2,12,0,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                        Text="STACK" />

                    <via:XStackPanel Orientation="Horizontal" Spacing="4">
                        <via:XIconButton
                            Command="{Binding StackHorCommand}"
                            Icon="{via:MaterialIcon Kind=ViewWeekOutline}"
                            ToolTip="Stack Horizontal" />
                        <via:XIconButton
                            Command="{Binding StackVerCommand}"
                            Icon="{via:MaterialIcon Kind=ViewAgendaOutline}"
                            ToolTip="Stack Vertical" />
                    </via:XStackPanel>
                </StackPanel>
            </Border>
        </via:XToggleDropDown.DropDownContent>
    </via:XToggleDropDown>
</UserControl>
