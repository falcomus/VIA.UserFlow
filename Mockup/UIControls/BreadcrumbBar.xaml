<UserControl
    x:Class="Mockup.Navigation.BreadcrumbBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:Mockup.Converter"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:Mockup.ViewModel"
    xmlns:via="http://schemas.via.dev/wpf"
    Focusable="False"
    IsTabStop="True">

    <UserControl.Resources>

        <!--  Converter  -->
        <converter:IsNotFirstToVisibilityConverter x:Key="IsNotFirstToVisibility" />

        <!--  Chevron-Template (Body + rechter Pfeil + linke Kerbe)  -->
        <Style x:Key="ChevronBreadcrumbButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="true" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!--  Höhe fix, Pfeilbreite & Kerbenbreite passend dazu  -->
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="20" />
                                <!--  Pfeilbreite  -->
                            </Grid.ColumnDefinitions>
                            <!--  Body ohne Rundungen  -->
                            <Border x:Name="Body" Background="{TemplateBinding Background}" />
                            <!--  Rechte Pfeilspitze  -->
                            <Path
                                x:Name="RightArrow"
                                Grid.Column="1"
                                Data="M0,0 L10,15 L0,30 Z"
                                Fill="{TemplateBinding Background}" />
                            <!--  Linke Kerbe (weiß), nur ab Item 2 sichtbar  -->
                            <Path
                                x:Name="LeftNotch"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                Data="M0,0 L12,15 L0,30 Z"
                                Fill="Transparent">
                                <Path.Visibility>
                                    <Binding
                                        Converter="{StaticResource IsNotFirstToVisibility}"
                                        Path="Tag"
                                        RelativeSource="{RelativeSource TemplatedParent}" />
                                </Path.Visibility>
                            </Path>
                            <!--  Inhalt  -->
                            <ContentPresenter
                                x:Name="PART_Content"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentPresenter.Margin>
                                    <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}">
                                        <Binding.Converter>
                                            <converter:FirstItemMarginConverter DefaultMargin="12,0,6,1" FirstItemMargin="10,0,6,1" />
                                        </Binding.Converter>
                                    </Binding>
                                </ContentPresenter.Margin>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.StateHover}}" />
                                <Setter TargetName="RightArrow" Property="Fill" Value="{DynamicResource {x:Static via:XBrushKeys.StateHover}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer
        Focusable="False"
        HorizontalScrollBarVisibility="Auto"
        IsTabStop="False"
        PanningMode="None"
        PreviewMouseDown="ScrollViewer_PreviewMouseDown"
        VerticalScrollBarVisibility="Disabled">
        <ItemsControl
            AlternationCount="1000"
            ClipToBounds="False"
            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ItemsSource}"
            SnapsToDevicePixels="True"
            Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Height="28"
                        Margin="0,0,-6,0"
                        HorizontalContentAlignment="Center"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=NavigateToIndexCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                        Content="{Binding Name}"
                        Focusable="False"
                        FontSize="13"
                        IsTabStop="False"
                        Style="{StaticResource ChevronBreadcrumbButton}"
                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
