<UserControl
    x:Class="Mockup.UIControls.DesignerToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <local:AlignmentToolbar HorizontalAlignment="Right" Visibility="{Binding IsMultipleControlsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

        <via:XToggleButton
            Margin="8,0,0,0"
            CheckedIcon="{via:MaterialIcon Kind=RulerSquare}"
            IconSize="16"
            IsChecked="{Binding CurrentProject.ShowAlignmentGuidelines, Mode=TwoWay}"
            ToolTip="Smart guides: show and snap to matching control edges and centers"
            UncheckedIcon="{via:MaterialIcon Kind=RulerSquare}"
            Variant="Info" />

        <via:XSeparator Margin="8,0" />

        <local:UndoRedoBar />

        <via:XSeparator Margin="8,0" />

        <via:XZoomSlider
            Margin="0,0,10,0"
            BorderThickness="0"
            Cursor="Hand"
            MaxZoomPercent="{Binding ElementName=root, Path=MaxZoomPercent}"
            MinZoomPercent="{Binding ElementName=root, Path=MinZoomPercent}"
            TickFrequency="1"
            ZoomPercent="{Binding ElementName=root, Path=ZoomPercent, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
