<UserControl
    x:Class="Mockup.UIControls.DesignerToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <local:AlignmentToolbar
            HorizontalAlignment="Right"
            Visibility="{Binding IsMultipleControlsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

        <via:XToggleButton
            Width="32"
            Height="32"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            CheckedIcon="{via:MaterialIcon Kind=RulerSquare}"
            IconSize="16"
            IsChecked="{Binding CurrentProject.ShowAlignmentGuidelines, Mode=TwoWay}"
            ToolTip="Smart guides: show and snap to matching control edges and centers"
            UncheckedIcon="{via:MaterialIcon Kind=RulerSquare}" />
    </StackPanel>
</UserControl>
