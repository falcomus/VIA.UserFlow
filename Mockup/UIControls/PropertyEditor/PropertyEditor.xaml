<UserControl
    x:Class="Mockup.UIControls.PropertyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root"
    MinWidth="280"
    d:DesignHeight="700"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="{x:Type via:XTextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <via:XBorder
        Padding="0"
        Background="{DynamicResource {x:Static via:XBrushKeys.Background}}"
        BorderThickness="0"
        CornerRadius="0">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

                <via:XBorder
                    Grid.Column="0"
                    Padding="0"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                    BorderThickness="0,0,1,0">
                    <via:XNavigationList
                        Padding="4"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="Name"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                        ItemCornerRadius="4"
                        ItemHoverBackground="{DynamicResource {x:Static via:XBrushKeys.StateHover}}"
                        ItemMargin="0,1"
                        ItemPadding="10,7,8,7"
                        ItemsSource="{Binding ElementName=root, Path=PropertyCategories}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding ElementName=root, Path=SelectedPropertyCategory, Mode=TwoWay}"
                        SelectedItemBackground="{DynamicResource {x:Static via:XBrushKeys.StateSelected}}"
                        SelectedItemForeground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                        SelectionIndicatorBrush="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                        SelectionIndicatorCornerRadius="0,2,2,0"
                        SelectionIndicatorWidth="3"
                        ShowSelectionIndicator="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <via:XNavigationList.ItemContainerStyle>
                            <Style TargetType="{x:Type via:XNavigationListItem}">
                                <Setter Property="MinHeight" Value="34" />
                                <Setter Property="ShowBadge" Value="True" />
                                <Setter Property="BadgeContent" Value="{Binding Count}" />
                                <Setter Property="BadgeVariant" Value="Primary" />
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                            </Style>
                        </via:XNavigationList.ItemContainerStyle>
                    </via:XNavigationList>
                </via:XBorder>

            <Grid
                Grid.Column="1"
                Visibility="{Binding ElementName=root, Path=HasActiveSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <via:XTextBlock
                        Margin="12,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding ElementName=root, Path=SelectionHeaderText}" />

                    <ScrollViewer
                        Grid.Row="1"
                        Padding="0,8,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ElementName=root, Path=VisibleProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,0,12,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="148" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <via:XTextBlock
                                                    Grid.Column="0"
                                                    Margin="0,0,10,0"
                                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                                    Text="{Binding DisplayName}" />

                                                <Grid Grid.Column="1">
                                                    <via:XTextBox
                                                        AcceptsReturn="True"
                                                        FontSize="13"
                                                        GotKeyboardFocus="TextEditor_GotKeyboardFocus"
                                                        LostFocus="TextEditor_LostFocus"
                                                        Tag="{Binding}"
                                                        Text="{Binding CurrentTextValue, Mode=OneWay}"
                                                        TextChanged="TextEditor_TextChanged"
                                                        Visibility="{Binding IsTextEditor, Converter={StaticResource BoolToVisibility}}" />

                                                    <via:XTextBox
                                                        Height="64"
                                                        MinHeight="64"
                                                        AcceptsReturn="True"
                                                        FontSize="13"
                                                        LostFocus="ItemsEditor_LostFocus"
                                                        Tag="{Binding}"
                                                        Text="{Binding CurrentItemsText, Mode=OneWay}"
                                                        TextWrapping="Wrap"
                                                        VerticalScrollBarVisibility="Auto"
                                                        Visibility="{Binding IsItemsEditor, Converter={StaticResource BoolToVisibility}}" />

                                                    <via:XNumberBox
                                                        FontSize="13"
                                                        Loaded="NumericEditor_Loaded"
                                                        LostFocus="NumericEditor_LostFocus"
                                                        PreviewKeyDown="NumericEditor_PreviewKeyDown"
                                                        Tag="{Binding}"
                                                        Unloaded="NumericEditor_Unloaded"
                                                        Visibility="{Binding IsNumericEditor, Converter={StaticResource BoolToVisibility}}"
                                                        Value="{Binding CurrentNumericValue, Mode=OneWay}" />

                                                    <via:XDatePicker
                                                        FontSize="13"
                                                        Loaded="DateTimeEditor_Loaded"
                                                        SelectedDate="{Binding CurrentDateTimeValue, Mode=OneWay}"
                                                        Tag="{Binding}"
                                                        Unloaded="DateTimeEditor_Unloaded"
                                                        Visibility="{Binding IsDateTimeEditor, Converter={StaticResource BoolToVisibility}}" />

                                                    <via:XCheckBox
                                                        VerticalAlignment="Center"
                                                        Checked="BoolEditor_Changed"
                                                        FontSize="13"
                                                        IsChecked="{Binding CurrentBoolValue, Mode=OneWay}"
                                                        Tag="{Binding}"
                                                        Unchecked="BoolEditor_Changed"
                                                        Visibility="{Binding IsBoolEditor, Converter={StaticResource BoolToVisibility}}" />

                                                    <via:XComboBox
                                                        FontSize="13"
                                                        ItemsSource="{Binding EnumValues}"
                                                        SelectedItem="{Binding CurrentValue, Mode=OneWay}"
                                                        SelectionChanged="EnumEditor_SelectionChanged"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding IsEnumEditor, Converter={StaticResource BoolToVisibility}}" />

                                                    <via:XComboBox
                                                        FontSize="13"
                                                        ItemsSource="{Binding FontWeightValues}"
                                                        SelectedItem="{Binding CurrentValue, Mode=OneWay}"
                                                        SelectionChanged="FontWeightEditor_SelectionChanged"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding IsFontWeightEditor, Converter={StaticResource BoolToVisibility}}" />

                                                    <Grid Visibility="{Binding IsImageRefEditor, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <via:XTextBlock
                                                            Grid.Column="0"
                                                            Margin="0,0,6,0"
                                                            FontWeight="Medium"
                                                            Text="{Binding CurrentTextValue}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <via:XButton
                                                            Grid.Column="1"
                                                            Width="30"
                                                            Height="28"
                                                            Margin="0,0,4,0"
                                                            Click="SelectImageRef_Click"
                                                            Content="..."
                                                            FontSize="14"
                                                            Tag="{Binding}" />

                                                        <via:XButton
                                                            Grid.Column="2"
                                                            Width="30"
                                                            Height="28"
                                                            Click="ClearValue_Click"
                                                            Content="×"
                                                            FontSize="19"
                                                            Foreground="{DynamicResource {x:Static via:XBrushKeys.Danger}}"
                                                            Tag="{Binding}" />
                                                    </Grid>

                                                    <via:XTextBlock
                                                        FontWeight="Medium"
                                                        Text="{Binding CurrentTextValue}"
                                                        Visibility="{Binding IsReadOnlyEditor, Converter={StaticResource BoolToVisibility}}" />

                                                    <Grid Visibility="{Binding IsColorEditor, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <via:XBorder
                                                            Grid.Column="0"
                                                            Margin="0,0,6,0"
                                                            Background="{Binding CurrentBrush}"
                                                            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                                            BorderThickness="1"
                                                            CornerRadius="3" />

                                                        <via:XButton
                                                            Grid.Column="1"
                                                            Width="34"
                                                            Height="28"
                                                            Click="PickColor_Click"
                                                            Content="..."
                                                            FontWeight="Medium"
                                                            Tag="{Binding}" />
                                                    </Grid>
                                                </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
            </Grid>

            <via:XStackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="260"
                Spacing="8"
                Visibility="{Binding ElementName=root, Path=HasNoActiveSelection, Converter={StaticResource BoolToVisibility}}">
                <via:XTextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{via:XLoc Toolbox.NoControlSelected, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                <via:XTextBlock
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                    Text="{via:XLoc Toolbox.NoControlSelectedHint, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </via:XStackPanel>
        </Grid>
    </via:XBorder>
</UserControl>
