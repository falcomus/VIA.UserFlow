<UserControl
    x:Class="Mockup.UIControls.XColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mockup.UIControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=local:XColorPickerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="500"
    Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    BorderThickness="0"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  0: SV + Hue  -->
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <!--  2: Ausgewählte Farbe  -->
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <!--  4: Default-Farben  -->
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <!--  6: Recent-Farben  -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <!--  Linke Spalte: SV-Feld + Hue-Balken  -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  SV-Feld  -->
            <Border
                Grid.Row="0"
                Height="120"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                BorderThickness="1"
                CornerRadius="4"
                MouseLeftButtonDown="SvField_MouseLeftButtonDown"
                MouseLeftButtonUp="SvField_MouseLeftButtonUp"
                MouseMove="SvField_MouseMove"
                SizeChanged="SvField_SizeChanged">
                <Grid ClipToBounds="True">
                    <!--  Hintergrund (wird per Binding aktualisiert)  -->
                    <Rectangle Fill="{Binding PickerSvBrush}" />
                    <!--  Weiß-Verlauf (S=0)  -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FFFFFFFF" />
                                <GradientStop Offset="1" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!--  Schwarz-Verlauf (V=0)  -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="1" Color="#FF000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!--  Selektor  -->
                    <Canvas IsHitTestVisible="False">
                        <Ellipse
                            Canvas.Left="{Binding SvSelectorX}"
                            Canvas.Top="{Binding SvSelectorY}"
                            Width="14"
                            Height="14"
                            Fill="Transparent"
                            Stroke="White"
                            StrokeThickness="2" />
                        <Ellipse
                            Canvas.Left="{Binding SvSelectorX}"
                            Canvas.Top="{Binding SvSelectorY}"
                            Width="14"
                            Height="14"
                            Fill="Transparent"
                            Stroke="#55000000"
                            StrokeThickness="1" />
                    </Canvas>
                </Grid>
            </Border>

            <!--  Hue-Balken  -->
            <Border
                Grid.Column="2"
                Width="35"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                BorderThickness="1"
                CornerRadius="4"
                MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                MouseLeftButtonUp="HueBar_MouseLeftButtonUp"
                MouseMove="HueBar_MouseMove"
                SizeChanged="HueBar_SizeChanged">
                <Grid>
                    <Rectangle RadiusX="4" RadiusY="4">
                        <Rectangle.Fill>
                            <!--  Vertikaler Verlauf  -->
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.00" Color="#FFFF0000" />
                                <GradientStop Offset="0.17" Color="#FFFFFF00" />
                                <GradientStop Offset="0.33" Color="#FF00FF00" />
                                <GradientStop Offset="0.50" Color="#FF00FFFF" />
                                <GradientStop Offset="0.67" Color="#FF0000FF" />
                                <GradientStop Offset="0.83" Color="#FFFF00FF" />
                                <GradientStop Offset="1.00" Color="#FFFF0000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!--  Selektor vertikal  -->
                    <Canvas IsHitTestVisible="False">
                        <Border
                            Canvas.Top="{Binding HueSelectorY}"
                            Width="33"
                            Height="5"
                            Background="White" />
                        <Border
                            Canvas.Top="{Binding HueSelectorY}"
                            Width="33"
                            Height="5"
                            Margin="0,1,0,0"
                            Background="#50000000"
                            Cursor="Hand" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <!--  Rechte Spalte: RGB-Slider + Hex  -->
        <Grid
            Grid.Row="0"
            Grid.Column="2"
            VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <!--  R  -->
                <Grid Margin="10,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,10,5"
                        VerticalAlignment="Center"
                        Text="R" />
                    <via:XSlider
                        Grid.Column="1"
                        Margin="0,1,5,0"
                        VerticalAlignment="Center"
                        Maximum="255"
                        Minimum="0"
                        Size="Small"
                        Value="{Binding R, Mode=TwoWay}" />
                    <via:XNumberBox
                        Grid.Column="2"
                        Width="55"
                        MinWidth="30"
                        Margin="10,0,0,0"
                        Padding="5,0,0,0"
                        Size="Medium"
                        Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--  G  -->
                <Grid Margin="10,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,10,5"
                        VerticalAlignment="Center"
                        Text="G" />
                    <via:XSlider
                        Grid.Column="1"
                        Margin="0,1,5,0"
                        VerticalAlignment="Center"
                        Maximum="255"
                        Minimum="0"
                        Size="Small"
                        Value="{Binding G, Mode=TwoWay}" />
                    <via:XNumberBox
                        Grid.Column="2"
                        Width="55"
                        MinWidth="30"
                        Margin="10,0,0,0"
                        Padding="5,0,0,0"
                        Size="Medium"
                        Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--  B  -->
                <Grid Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,10,5"
                        VerticalAlignment="Center"
                        Text="B" />
                    <via:XSlider
                        Grid.Column="1"
                        Margin="0,1,5,0"
                        VerticalAlignment="Center"
                        Maximum="255"
                        Minimum="0"
                        Size="Small"
                        Value="{Binding B, Mode=TwoWay}" />
                    <via:XNumberBox
                        Grid.Column="2"
                        Width="55"
                        MinWidth="30"
                        Margin="10,0,0,0"
                        Padding="5,0,0,0"
                        Size="Medium"
                        Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--  Alpha  -->
                <Grid Margin="10,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,10,5"
                        VerticalAlignment="Center"
                        Text="A" />
                    <via:XSlider
                        Grid.Column="1"
                        Margin="0,1,5,0"
                        VerticalAlignment="Center"
                        Maximum="255"
                        Minimum="0"
                        Size="Small"
                        Value="{Binding A, Mode=TwoWay}" />
                    <via:XNumberBox
                        Grid.Column="2"
                        Width="55"
                        MinWidth="30"
                        Margin="10,0,0,0"
                        Padding="5,0,0,0"
                        Size="Medium"
                        Value="{Binding A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>

            <!--  Hex-Eingabe  -->
            <TextBox
                Grid.Row="1"
                Height="26"
                MinHeight="26"
                Margin="0,10,0,0"
                Padding="8,0,8,2"
                Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="Collapsed" />
        </Grid>

        <!--  Aktuelle Farbvorschau (Row 2)  -->
        <Border
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Height="32"
            Margin="0,10,0,0"
            Background="{Binding SelectedBrush}"
            CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="10,0,0,1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{Binding PreviewForegroundBrush}"
                    Text="{Binding Hex}" />
                <TextBlock
                    Margin="20,0,0,1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="{Binding PreviewForegroundBrush}"
                    Text="{Binding RgbText}" />
                <TextBlock
                    Margin="20,0,0,1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{Binding PreviewForegroundBrush}"
                    Text="{Binding OpacityText}" />
            </StackPanel>
        </Border>

        <!--  Default-Farben (Row 4)  -->
        <Border
            Margin="0 4 0 0"
            Grid.Row="4"
            Grid.ColumnSpan="3"
            Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0"
            CornerRadius="4">
            <StackPanel>
                <TextBlock
                    Margin="4,4,0,4"
                    FontSize="11"
                    FontWeight="Medium"
                    Text="DEFAULT COLORS" />
                <ItemsControl
                    Margin="4,2,8,0"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding DefaultColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="24"
                                Height="20"
                                Margin="0,0,4,2"
                                Background="{Binding}"
                                BorderBrush="#22000000"
                                BorderThickness="1"
                                CornerRadius="3"
                                Cursor="Hand"
                                UseLayoutRounding="False">
                                <Border.InputBindings>
                                    <MouseBinding
                                        Command="{Binding DataContext.PickSwatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <Border UseLayoutRounding="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <!--  oben: heller Glanz  -->
                                            <GradientStop Offset="0.00" Color="#D0FFFFFF" />
                                            <GradientStop Offset="0.18" Color="#00FFFFFF" />
                                            <!--  unten: dunkle Kante  -->
                                            <GradientStop Offset="0.82" Color="#00000000" />
                                            <GradientStop Offset="1.00" Color="#30000000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  Recent-Farben (Row 6)  -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
            <TextBlock
                Margin="4,0,0,0"
                FontSize="11"
                FontWeight="Medium"
                Text="RECENT COLORS" />
            <ScrollViewer
                Margin="4,6,8,0"
                HorizontalAlignment="Left"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding RecentColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="15"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="24"
                                Height="20"
                                Margin="0,0,5,5"
                                Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                BorderBrush="#22000000"
                                BorderThickness="1"
                                CornerRadius="3"
                                Cursor="Hand"
                                UseLayoutRounding="False">
                                <Border.InputBindings>
                                    <MouseBinding
                                        Command="{Binding DataContext.PickRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <Border UseLayoutRounding="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <!--  oben: heller Glanz  -->
                                            <GradientStop Offset="0.00" Color="#D0FFFFFF" />
                                            <GradientStop Offset="0.18" Color="#00FFFFFF" />
                                            <!--  unten: dunkle Kante  -->
                                            <GradientStop Offset="0.82" Color="#00000000" />
                                            <GradientStop Offset="1.00" Color="#30000000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
