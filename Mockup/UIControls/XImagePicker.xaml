<UserControl
    x:Class="Mockup.UIControls.XImagePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editing="clr-namespace:Mockup.Dialogs"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.UIControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=mockup:Screen}"
    d:DesignHeight="350"
    d:DesignWidth="500"
    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <Grid ext:GridEx.ColDef="240,Auto,*" Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">

        <!--#region === LEFT GRID ===-->
        <Grid ext:GridEx.RowDef="*,120,Auto">

            <!--#region === DROP AREA ===-->
            <Grid
                Margin="12,0"
                VerticalAlignment="Center"
                ext:GridEx.RowDef="*,Auto"
                AllowDrop="True"
                DragOver="OnDragOverImage"
                Drop="OnDropImage">
                <Button
                    Width="48"
                    Height="48"
                    Margin="0,40,0,15"
                    Padding="0"
                    Background="{DynamicResource {x:Static via:XBrushKeys.PrimaryStrong}}"
                    Cursor="Hand"
                    IsHitTestVisible="False">
                    <ico:PackIconMaterialDesign
                        Width="20"
                        Height="20"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                        Kind="FileDownload" />
                </Button>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,0,15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="14"
                    FontWeight="SemiBold"
                    IsHitTestVisible="False"
                    Text="{via:XLoc Dialog.ImagePicker.DropHere,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
            </Grid>
            <!--#endregion === DROP AREA ===-->

            <!--#region === RECOMMENDED SIZE INFO ===-->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Medium"
                    Opacity="0.8"
                    Text="{via:XLoc Dialog.ImagePicker.RecommendedSize,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,8,0,50"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                    Text="{Binding ElementName=root, Path=ImageSizeHint, FallbackValue='—'}" />
            </StackPanel>
            <!--#endregion === RECOMMENDED SIZE INFO ===-->

            <!--#region === CLEAR / BROWSE BUTTONS ===-->
            <Grid
                Grid.Row="2"
                Margin="10,0,10,15"
                ext:GridEx.ColDef="*,*">
                <Button
                    Grid.Row="1"
                    Width="90"
                    Height="35"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                    BorderThickness="1"
                    Click="RemoveImageButton_Click">
                    <Grid ext:GridEx.ColDef="Auto,*">
                        <ico:PackIconMaterial
                            Width="15"
                            Height="15"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.StatusDanger}}"
                            Kind="CloseCircle" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.StatusDanger}}"
                            Text="{via:XLoc Dialog.ImagePicker.Clear,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                    </Grid>
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="100"
                    Height="35"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                    BorderThickness="1"
                    Click="SelectImageButton_Click">
                    <Grid ext:GridEx.ColDef="Auto,*">
                        <ico:PackIconMaterial
                            Width="15"
                            Height="15"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                            Kind="FolderOpen" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                            Text="{via:XLoc Dialog.ImagePicker.Browse,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                    </Grid>
                </Button>
            </Grid>
            <!--#endregion === CLEAR / BROWSE BUTTONS ===-->

        </Grid>
        <!--#endregion === LEFT GRID ===-->


        <!--#region === VERTIKAL SEPARATOR ===-->
        <Border
            Grid.Column="1"
            Width="1"
            Background="{DynamicResource {x:Static via:XBrushKeys.Divider}}" />
        <!--#endregion === VERTIKAL SEPARATOR ===-->

        <!--#region === PREVIEW IMAGE ===-->
        <Border
            Grid.Column="2"
            Margin="30,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderStrong}}"
            BorderThickness="14"
            CornerRadius="15">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="0.35" ScaleY="0.35" />
            </Border.LayoutTransform>
            <Image
                x:Name="PART_Image"
                Width="{Binding Source={x:Static mockup:MockupService.Mockup}, Path=CurrentProject.DeviceWidth, FallbackValue=400}"
                Height="{Binding Source={x:Static mockup:MockupService.Mockup}, Path=CurrentProject.DeviceHeight, FallbackValue=870}"
                Source="/Mockup;component/Resources/PNG/mobileScreen.png"
                Stretch="Fill" />
        </Border>
        <!--#endregion === PREVIEW IMAGE ===-->

    </Grid>

</UserControl>
