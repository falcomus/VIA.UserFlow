<UserControl
    x:Class="Mockup.UIControls.XZoomSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:local="clr-namespace:Mockup.UIControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=local:XZoomSlider}"
    d:DesignHeight="45"
    d:DesignWidth="300"
    Background="Transparent"
    mc:Ignorable="d">

    <Border
        Padding="2,0,4,0"
        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
        BorderThickness="{Binding ElementName=root, Path=BorderThickness}">
        <Grid ext:GridEx.ColDef="*,Auto">
            <!--<Border
                Height="32"
                VerticalAlignment="Center"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0"
                CornerRadius="3"
                SnapsToDevicePixels="True">-->
            <via:XSlider
                Width="100"
                MinWidth="100"
                Margin="5,0,2,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutoToolTipPlacement="None"
                Background="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                BorderThickness="0"
                Cursor="Hand"
                Focusable="False"
                IsSnapToTickEnabled="True"
                Maximum="{Binding ElementName=root, Path=MaxZoomPercent}"
                Minimum="{Binding ElementName=root, Path=MinZoomPercent}"
                TickFrequency="{Binding ElementName=root, Path=TickFrequency}"
                TickPlacement="None"
                Value="{Binding ElementName=root, Path=ZoomPercent, Mode=TwoWay}" />
            <!--</Border>-->

            <via:XButton
                x:Name="PART_ResetButton"
                Grid.Column="1"
                Width="50"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                BorderThickness="1"
                Command="{Binding ElementName=root, Path=ResetZoomCommand}"
                CornerRadius="4"
                Cursor="Hand"
                Focusable="False"
                Height="25"
                Padding="0"
                MinHeight="20"
                Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                Size="Small"
                ToolTip="Reset to 100%"
                Variant="Default"
                Visibility="{Binding ElementName=root, Path=ResetButtonVisibility}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="{Binding ElementName=root, Path=ZoomPercent}" />
                    <TextBlock
                        Margin="2,0,0,2"
                        FontSize="13"
                        FontWeight="Medium"
                        Text="%" />
                </StackPanel>
            </via:XButton>
        </Grid>
        <!--</Border>-->
    </Border>
</UserControl>
