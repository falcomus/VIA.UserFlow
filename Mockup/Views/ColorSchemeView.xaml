<UserControl
    x:Class="Mockup.Views.ColorSchemeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:colorsystem="clr-namespace:Mockup.ColorSystem"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    x:Name="root"
    MinWidth="300"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    Background="Transparent"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="ColorChipGlossBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.00" Color="#30FFFFFF" />
            <GradientStop Offset="0.28" Color="#00FFFFFF" />
            <GradientStop Offset="1.00" Color="#18000000" />
        </LinearGradientBrush>

        <Style x:Key="ColorChipCardStyle" TargetType="Border">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="ColorChipLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,10,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF101828" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ListBoxBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <via:XStackPanel
            Grid.Column="0"
            Margin="12,10,6,10"
            Orientation="Vertical"
            Spacing="8">
            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.PrimaryBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Foreground="White" Text="Primary" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.AccentBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Text="Accent" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.InfoBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Text="Info" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.WarningBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Text="Warning" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.ErrorBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Foreground="White" Text="Error" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.SuccessBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Text="Success" />
                </Grid>
            </Border>
        </via:XStackPanel>

        <via:XStackPanel
            Grid.Column="1"
            Margin="6,10,12,10"
            Orientation="Vertical"
            Spacing="8">
            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.NeutralBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Text="Neutral" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.TextBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Foreground="White" Text="Text" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.ControlBGBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Text="Control Background" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.ControlBorderBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Text="Control Border" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ColorChipCardStyle}" Background="{Binding CurrentProject.ActiveColorSchema.BorderBrush}">
                <Grid>
                    <Border Background="{StaticResource ColorChipGlossBrush}" CornerRadius="6" IsHitTestVisible="False" />
                    <TextBlock Style="{StaticResource ColorChipLabelStyle}" Text="Card Border" />
                </Grid>
            </Border>
        </via:XStackPanel>
    </Grid>
</UserControl>
