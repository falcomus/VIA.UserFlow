<UserControl
    x:Class="Mockup.Views.FlowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    d:DesignHeight="850"
    d:DesignWidth="800"
    Background="{DynamicResource DesignerBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <Grid ext:GridEx.RowDef="45,*">
        <Border
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="2" />
            </Border.Effect>
            <Grid Margin="16,0" ext:GridEx.ColDef="Auto,*">
                <ico:PackIconMaterialDesign
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Kind="Map" />
                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,1"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Action Flow" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Border
                Width="590"
                MaxWidth="780"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F9FAFB"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="18"
                        Direction="315"
                        Opacity="0.08"
                        ShadowDepth="3" />
                </Border.Effect>

                <Grid ext:GridEx.RowDef="Auto,Auto,*">
                    <Border
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="12">
                        <ico:PackIconMaterialDesign
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="Map" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,18,0,18">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="Action Flow" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="A visual overview for screen transitions and action areas."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border
                            Margin="0,0,0,10"
                            Padding="16,14,16,14"
                            Background="White"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ext:GridEx.ColDef="Auto,*">
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="#EEF4FF"
                                    CornerRadius="16">
                                    <ico:PackIconFontAwesome5
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Kind="CheckCircleRegular" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Screen navigation" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="Show how screens, popups and action areas are connected."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,0,0,10"
                            Padding="16,14,16,14"
                            Background="White"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ext:GridEx.ColDef="Auto,*">
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="#EEF4FF"
                                    CornerRadius="16">
                                    <ico:PackIconFontAwesome5
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Kind="CheckCircleRegular" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Flow validation" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="Later this can surface missing targets or broken links."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,0,0,10"
                            Padding="16,14,16,14"
                            Background="White"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ext:GridEx.ColDef="Auto,*">
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="#EEF4FF"
                                    CornerRadius="16">
                                    <ico:PackIconFontAwesome5
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Kind="CheckCircleRegular" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Designer-friendly overview" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="Keep the flow clean and readable without touching the current designer logic."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
