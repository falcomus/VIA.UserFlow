<UserControl
    x:Class="Mockup.Views.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DesignHeight="850"
    d:DesignWidth="800"
    Background="{DynamicResource DesignerBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <Grid ext:GridEx.RowDef="45,*">
        <Border
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="2" />
            </Border.Effect>
            <Grid Margin="16,0" ext:GridEx.ColDef="Auto,*">
                <ico:PackIconFontAwesome5
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Kind="QuestionCircleRegular" />
                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,1"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Help" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Border
                MaxWidth="780"
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="18"
                        Direction="315"
                        Opacity="0.08"
                        ShadowDepth="3" />
                </Border.Effect>

                <Grid ext:GridEx.RowDef="Auto,Auto,*">
                    <Border
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="12">
                        <ico:PackIconFontAwesome5
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                            Kind="QuestionCircleSolid" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,18,0,18">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="Help" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="Quick guidance for using the UserFlow mockup designer."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border
                            Margin="0,0,0,10"
                            Padding="16,14,16,14"
                            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ext:GridEx.ColDef="Auto,*">
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.PrimarySubtle}}"
                                    CornerRadius="16">
                                    <ico:PackIconFontAwesome5
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Kind="CheckCircleRegular" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Project workflow" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="Create projects, add screens, place controls and test them in preview."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,0,0,10"
                            Padding="16,14,16,14"
                            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ext:GridEx.ColDef="Auto,*">
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.PrimarySubtle}}"
                                    CornerRadius="16">
                                    <ico:PackIconFontAwesome5
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Kind="CheckCircleRegular" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Designer shortcuts" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="Use Ctrl + mouse wheel for zoom and context menus for screen/control actions."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Margin="0,0,0,10"
                            Padding="16,14,16,14"
                            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ext:GridEx.ColDef="Auto,*">
                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.PrimarySubtle}}"
                                    CornerRadius="16">
                                    <ico:PackIconFontAwesome5
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        Kind="CheckCircleRegular" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="Troubleshooting" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="This area can later collect common issues and repair actions."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
