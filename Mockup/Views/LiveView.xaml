<UserControl
    x:Class="Mockup.Views.LiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actionArea="clr-namespace:Mockup._ActionArea"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:gong="urn:gong-wpf-dragdrop"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="clr-namespace:Mockup.Navigation"
    xmlns:rendering="clr-namespace:Mockup.Rendering"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="850"
    d:DesignWidth="1200"
    Background="{DynamicResource DesignerBackgroundBrush}"
    PreviewMouseWheel="Root_PreviewMouseWheel"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">


    <UserControl.Resources>
        <Style x:Key="PreviewVerticalScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <via:XBorder
                            Padding="0"
                            Background="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                            BorderThickness="0"
                            CornerRadius="4">
                            <Grid Margin="5" Background="{TemplateBinding Background}">
                                <Track
                                    x:Name="PART_Track"
                                    Cursor=""
                                    IsDirectionReversed="True"
                                    Orientation="Vertical">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            Height="0"
                                            Command="ScrollBar.LineUpCommand"
                                            IsTabStop="False"
                                            Opacity="0" />
                                    </Track.DecreaseRepeatButton>

                                    <Track.Thumb>
                                        <Thumb Width="15" Cursor="Hand" />
                                    </Track.Thumb>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            Height="0"
                                            Command="ScrollBar.LineDownCommand"
                                            IsTabStop="False"
                                            Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </via:XBorder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid
        x:Name="PART_DesignerArea"
        ext:GridEx.RowDef="48,*"
        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">

        <!--#region === SCROLLVIEWER WITH TRANSFORMATION  ===-->
        <ScrollViewer
            x:Name="PART_ScrollViewer"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="24,12,24,24"
            Panel.ZIndex="0"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.LayoutTransform>
                <ScaleTransform ScaleX="{Binding CurrentProject.PreviewZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" ScaleY="{Binding CurrentProject.PreviewZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" />
            </ScrollViewer.LayoutTransform>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                <!--#region === DEVICE FRAME AND SCREEN PREVIEW CONTROL ===-->
                <via:XBorder
                    Padding="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelBackground}}"
                    CornerRadius="18">
                    <via:XBorder.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="315"
                            Opacity="0.22"
                            ShadowDepth="8" />
                    </via:XBorder.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <rendering:LiveViewControl
                            x:Name="PART_LiveViewControl"
                            Grid.Column="0"
                            Width="{Binding CurrentProject.DeviceWidth, FallbackValue=300}"
                            Height="{Binding CurrentProject.DeviceHeight, FallbackValue=400}"
                            Screen="{Binding CurrentScreen}" />

                    </Grid>
                </via:XBorder>
                <!--#endregion === DEVICE FRAME AND SCREEN PREVIEW CONTROL ===-->

                <ScrollBar
                    x:Name="PART_PreviewScrollBar"
                    Grid.Column="1"
                    Height="{Binding CurrentProject.DeviceHeight, FallbackValue=400}"
                    Margin="0,0,-50,0"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                    LargeChange="60"
                    Minimum="0"
                    Orientation="Vertical"
                    SmallChange="15"
                    Style="{StaticResource PreviewVerticalScrollBarStyle}"
                    ValueChanged="PreviewScrollBar_ValueChanged"
                    Visibility="Collapsed" />
                <!--</Border>-->


                <!--#region === PREVIEW POPUP OVERLAY ===-->
                <Grid
                    x:Name="PART_PopupOverlayRoot"
                    Panel.ZIndex="8"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Grid
                        Width="{Binding CurrentProject.DeviceWidth, FallbackValue=300}"
                        Height="{Binding CurrentProject.DeviceHeight, FallbackValue=400}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">

                        <via:XBorder
                            x:Name="PART_PopupDimmer"
                            Padding="0"
                            Background="{DynamicResource {x:Static via:XBrushKeys.Scrim}}"
                            CornerRadius="0"
                            MouseLeftButtonDown="PreviewPopupOverlay_MouseLeftButtonDown"
                            Opacity="0" />

                        <via:XBorder
                            x:Name="PART_PopupCard"
                            Width="{Binding PreviewPopupWidth}"
                            Height="{Binding PreviewPopupHeight}"
                            Margin="{Binding PreviewPopupMargin}"
                            Padding="0"
                            HorizontalAlignment="{Binding PreviewPopupHorizontalAlignment}"
                            VerticalAlignment="{Binding PreviewPopupVerticalAlignment}"
                            CornerRadius="0"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                            <via:XBorder.RenderTransform>
                                <TranslateTransform x:Name="PART_PopupTranslate" />
                            </via:XBorder.RenderTransform>

                            <via:XBorder.Effect>
                                <DropShadowEffect
                                    BlurRadius="24"
                                    Direction="315"
                                    Opacity="0.22"
                                    ShadowDepth="8" />
                            </via:XBorder.Effect>

                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <via:XBorder
                                    Padding="0"
                                    Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0">
                                    <via:XBorder.Style>
                                        <Style TargetType="via:XBorder">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewPopup.HasHeader}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </via:XBorder.Style>

                                    <Grid Margin="10,0,0,1" ext:GridEx.ColDef="*,Auto">
                                        <via:XTextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{Binding PreviewPopupTitle}"
                                            TextTrimming="CharacterEllipsis" />

                                        <via:XButton
                                            Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            Margin="10,0,0,2"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ClosePreviewPopupCommand}"
                                            Content="×"
                                            Cursor="Hand"
                                            FontSize="16"
                                            FontWeight="SemiBold" />
                                    </Grid>
                                </via:XBorder>

                                <ScrollViewer
                                    CanContentScroll="False"
                                    HorizontalScrollBarVisibility="Disabled"
                                    PanningMode="VerticalOnly"
                                    VerticalScrollBarVisibility="{Binding PreviewPopupVerticalScrollBarVisibility}">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Grid.Row" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewPopup.HasHeader}" Value="False">
                                                    <Setter Property="Grid.Row" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>

                                    <designer:PopupDesignerControl
                                        Width="{Binding PreviewPopupWidth}"
                                        Height="{Binding PreviewPopupRequestedContentHeight}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        IsPreviewMode="True"
                                        ScreenPopup="{Binding PreviewPopup}" />
                                </ScrollViewer>
                            </Grid>
                        </via:XBorder>
                    </Grid>
                </Grid>
                <!--#endregion === PREVIEW POPUP OVERLAY ===-->

            </Grid>
        </ScrollViewer>
        <!--#endregion === SCROLLVIEWER WITH TRANSFORMATION  ===-->

        <!--#region === TOP PANEL ===-->
        <via:XBorder
            Grid.Column="1"
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="2" />
            </via:XBorder.Effect>

            <Grid ext:GridEx.ColDef="*,Auto">

                <StackPanel
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <via:XTextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Preview of Screen" />
                    <via:XTextBlock
                        Margin="5,0,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Text="{Binding HomeScreen.Name, FallbackValue='Live preview'}" />

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

                    <via:XIconButton
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="HomeButton_Click"
                        Cursor="Hand"
                        Icon="{via:MaterialDesignIcon Kind=HomeOutline}"
                        IconSize="18"
                        Size="Medium"
                        ToolTip="Goto Home Screen"
                        Variant="Primary" />

                    <via:XSeparator
                        Grid.Column="1"
                        Margin="3,0,3,0"
                        HorizontalAlignment="Center" />

                    <via:XZoomSlider
                        x:Name="PART_ZoomSlider"
                        Margin="3,0,10,0"
                        BorderThickness="0"
                        Cursor="Hand"
                        MaxZoomPercent="200"
                        MinZoomPercent="25"
                        TickFrequency="1"
                        ZoomPercent="{Binding CurrentProject.PreviewZoomPercent, Mode=TwoWay}" />

                </StackPanel>

            </Grid>

        </via:XBorder>

        <navigation:BreadcrumbBar
            Grid.Row="0"
            HorizontalAlignment="Center"
            Focusable="False"
            IsTabStop="False"
            ItemsSource="{Binding NavigationTrail}"
            NavigateToIndexCommand="{Binding NavigateToTrailIndexCommand}" />


        <actionArea:ActionAreaHint
            Grid.Row="2"
            Margin="0,10,15,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            ItemsSource="{Binding ActionAreaHintRows}"
            Visibility="{Binding IsActionAreaHintVisible, Converter={StaticResource BoolToVisibilityConverter}}" />


    </Grid>


</UserControl>

