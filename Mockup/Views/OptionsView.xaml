<UserControl
    x:Class="Mockup.Views.OptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DesignHeight="850"
    d:DesignWidth="800"
    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    mc:Ignorable="d">

    <Grid ext:GridEx.RowDef="48,*">
        <via:XBorder
            Padding="16,0"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
            <via:XStackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <via:XIcon
                    Width="18"
                    Height="18"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                    Kind="Cog"
                    Pack="Material" />
                <via:XTextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{via:XLoc Options.Title, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
            </via:XStackPanel>
        </via:XBorder>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="760" Margin="24" HorizontalAlignment="Center">
                <via:XStackPanel>
                    <via:XStackPanel Margin="0,0,0,20">
                        <via:XTextBlock FontSize="24" FontWeight="SemiBold" Text="{via:XLoc Options.Heading, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                        <via:XTextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                            Text="{via:XLoc Options.Introduction, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                            TextWrapping="Wrap" />
                    </via:XStackPanel>

                    <via:XBorder
                        Padding="20"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <via:XStackPanel>
                            <via:XStackPanel Orientation="Horizontal">
                                <via:XIcon
                                    Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                    Kind="ContentSaveOutline"
                                    Pack="MaterialDesign" />
                                <via:XTextBlock
                                    Margin="9,0,0,0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{via:XLoc Options.Saving, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            </via:XStackPanel>

                            <via:XCheckBox
                                Margin="0,16,0,0"
                                Content="{via:XLoc Options.AutoSave, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                IsChecked="{Binding AutoSaveEnabled, Mode=TwoWay}" />

                            <Grid Margin="0,12,0,0" IsEnabled="{Binding AutoSaveEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <via:XStackPanel>
                                    <via:XTextBlock FontWeight="SemiBold" Text="{via:XLoc Options.SaveInterval, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                    <via:XTextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                        Text="{via:XLoc Options.SaveDescription, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                        TextWrapping="Wrap" />
                                </via:XStackPanel>
                                <via:XTextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{Binding AutoSaveIntervalMinutes, StringFormat={}{0} min}" />
                            </Grid>
                            <via:XSlider
                                Margin="0,8,0,0"
                                IsEnabled="{Binding AutoSaveEnabled}"
                                IsSnapToTickEnabled="True"
                                Maximum="30"
                                Minimum="1"
                                TickFrequency="1"
                                Value="{Binding AutoSaveIntervalMinutes, Mode=TwoWay}" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder
                        Margin="0,14,0,0"
                        Padding="20"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <via:XStackPanel>
                            <via:XStackPanel Orientation="Horizontal">
                                <via:XIcon
                                    Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                    Kind="ViewDashboardOutline"
                                    Pack="MaterialDesign" />
                                <via:XTextBlock
                                    Margin="9,0,0,0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{via:XLoc Options.Workspace, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            </via:XStackPanel>

                            <via:XCheckBox
                                Margin="0,16,0,0"
                                Content="{via:XLoc Options.ShowToolbox, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                IsChecked="{Binding ShowToolbox, Mode=TwoWay}" />
                            <via:XTextBlock
                                Margin="25,4,0,0"
                                Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                Text="{via:XLoc Options.ShowToolboxDescription, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                TextWrapping="Wrap" />

                            <via:XCheckBox
                                Margin="0,14,0,0"
                                Content="{via:XLoc Options.OpenLastProject, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                IsChecked="{Binding OpenLastProjectOnStartup, Mode=TwoWay}" />
                            <via:XTextBlock
                                Margin="25,4,0,0"
                                Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                Text="{via:XLoc Options.OpenLastProjectDescription, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                TextWrapping="Wrap" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder
                        Margin="0,14,0,0"
                        Padding="20"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <via:XStackPanel>
                            <via:XStackPanel Orientation="Horizontal">
                                <via:XIcon
                                    Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                    Kind="FolderOutline"
                                    Pack="MaterialDesign" />
                                <via:XTextBlock
                                    Margin="9,0,0,0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{via:XLoc Options.Storage, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            </via:XStackPanel>
                            <via:XTextBlock
                                Margin="0,16,0,0"
                                Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                Text="{via:XLoc Options.StorageDescription, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                TextWrapping="Wrap" />
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XStackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
