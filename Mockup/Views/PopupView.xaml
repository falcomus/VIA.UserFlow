<UserControl
    x:Class="Mockup.Views.PopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behav="clr-namespace:Mockup.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:gong="urn:gong-wpf-dragdrop"
    xmlns:grouping="clr-namespace:Mockup.Grouping"
    xmlns:helper="clr-namespace:Mockup.Helper"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    Background="{DynamicResource DesignerBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    PreviewMouseWheel="Root_PreviewMouseWheel"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ResizeHeightThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse
                                Fill="{DynamicResource PrimaryBrush}"
                                Stroke="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                StrokeThickness="1.3">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Direction="270"
                                        Opacity="0.5"
                                        ShadowDepth="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <ico:PackIconMaterial
                                Width="14"
                                Height="14"
                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                Kind="ArrowVerticalLock" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeWidthThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse
                                Fill="{DynamicResource PrimaryBrush}"
                                Stroke="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                StrokeThickness="1.3">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Direction="270"
                                        Opacity="0.5"
                                        ShadowDepth="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <ico:PackIconMaterial Kind="ArrowHorizontalLock" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightWidthHandleStyle" TargetType="Thumb">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Margin" Value="0,0,-22,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPopup.Position}" Value="{x:Static mockup:ScreenPopupPosition.Right}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeftWidthHandleStyle" TargetType="Thumb">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="-22,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPopup.Position}" Value="{x:Static mockup:ScreenPopupPosition.Right}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Margin" Value="-22,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BottomHeightHandleStyle" TargetType="Thumb">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Margin" Value="0,-1,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPopup.Position}" Value="{x:Static mockup:ScreenPopupPosition.Bottom}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopHeightHandleStyle" TargetType="Thumb">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,-22,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPopup.Position}" Value="{x:Static mockup:ScreenPopupPosition.Bottom}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Margin" Value="0,-22,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <local:DesignerWorkspaceHost>
        <Grid ext:GridEx.RowDef="48,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="PopupNavigatorColumn"
                Width="{Binding PopupNavigatorWidth}"
                MinWidth="430" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="600" />
        </Grid.ColumnDefinitions>

        <!--  MASTER: popup groups and popups in the selected group  -->
        <via:XBorder
            Grid.Row="1"
            Grid.Column="0"
            Padding="0"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            BorderThickness="0,0,1,0"
            CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <via:XNavigationList
                    Padding="4"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    ItemCornerRadius="4"
                    ItemHoverBackground="{DynamicResource {x:Static via:XBrushKeys.StateHover}}"
                    ItemMargin="0,1"
                    ItemPadding="10,7,8,7"
                    ItemsSource="{Binding PopupNavigationGroups}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding CurrentPopupNavigationGroup, Mode=TwoWay}"
                    SelectedItemBackground="{DynamicResource {x:Static via:XBrushKeys.StateSelected}}"
                    SelectedItemForeground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                    SelectionIndicatorBrush="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                    SelectionIndicatorCornerRadius="0,2,2,0"
                    SelectionIndicatorWidth="3"
                    ShowSelectionIndicator="True"
                    Variant="Surface">
                    <via:XNavigationList.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type via:XNavigationListItem}}" TargetType="{x:Type via:XNavigationListItem}">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="Title" Value="{Binding DisplayName}" />
                            <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                            <Setter Property="ShowBadge" Value="True" />
                            <Setter Property="BadgeContent" Value="{Binding Count}" />
                            <Setter Property="BadgeVariant" Value="Primary" />
                        </Style>
                    </via:XNavigationList.ItemContainerStyle>
                </via:XNavigationList>

                <via:XBorder
                    Grid.Column="1"
                    Background="{DynamicResource {x:Static via:XBrushKeys.Background}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0">
                    <via:XNavigationList
                        x:Name="PopupListBox"
                        Padding="4"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        ContextMenu="{StaticResource PopupListContextMenu}"
                        ItemCornerRadius="4"
                        ItemHoverBackground="{DynamicResource {x:Static via:XBrushKeys.StateHover}}"
                        ItemMargin="0,1"
                        ItemPadding="10,7,8,7"
                        ItemsSource="{Binding PopupsNavigationView}"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding CurrentPopup, Mode=TwoWay}"
                        SelectedItemBackground="{DynamicResource {x:Static via:XBrushKeys.StateSelected}}"
                        SelectedItemForeground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                        SelectionChanged="PopupListBox_SelectionChanged"
                        SelectionIndicatorBrush="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                        SelectionIndicatorCornerRadius="0,2,2,0"
                        SelectionIndicatorWidth="3"
                        ShowSelectionIndicator="True"
                        Variant="Surface"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <via:XNavigationList.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type via:XNavigationListItem}}" TargetType="{x:Type via:XNavigationListItem}">
                                <Setter Property="MinHeight" Value="50" />
                                <Setter Property="Title" Value="{Binding Name}" />
                                <Setter Property="SubTitle" Value="{Binding Description}" />
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                <Setter Property="ShowEdit" Value="True" />
                                <Setter Property="ShowDelete" Value="True" />
                                <Setter Property="EditToolTip" Value="{via:XLoc Common.EditTooltip, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                <Setter Property="DeleteToolTip" Value="{via:XLoc Common.DeleteTooltip, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                <Setter Property="EditCommand" Value="{Binding DataContext.EditPopupCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XNavigationList}}}" />
                                <Setter Property="EditCommandParameter" Value="{Binding}" />
                                <Setter Property="DeleteCommand" Value="{Binding DataContext.DeletePopupCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XNavigationList}}}" />
                                <Setter Property="DeleteCommandParameter" Value="{Binding}" />
                            </Style>
                        </via:XNavigationList.ItemContainerStyle>
                    </via:XNavigationList>
                </via:XBorder>
            </Grid>
        </via:XBorder>

        <GridSplitter
            x:Name="PopupNavigatorSplitter"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            DragCompleted="PopupNavigatorSplitter_DragCompleted"
            DragDelta="PopupNavigatorSplitter_DragDelta"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            ShowsPreview="False"
            Style="{StaticResource DesignerNavigatorSplitterStyle}" />

        <via:XBorder
            Grid.Column="0"
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.2"
                    ShadowDepth="2" />
            </via:XBorder.Effect>

            <Grid ext:GridEx.ColDef="*,Auto">
                <via:XTextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{via:XLoc Popup.Title, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                <via:XIconButton
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Appearance="Subtle"
                    Command="{Binding NewPopupCommand}"
                    Cursor="Hand"
                    Focusable="False"
                    Icon="{via:MaterialIcon Kind=Plus}"
                    Size="Medium"
                    ToolTip="{via:XLoc Popup.New, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Variant="Primary" />
            </Grid>
        </via:XBorder>

        <Grid
            x:Name="PART_DesignerArea"
            Grid.RowSpan="2"
            Grid.Column="2"
            ext:GridEx.RowDef="48,*">

            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Grid.Row="1"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    MinWidth="{Binding ElementName=PART_ScrollViewer, Path=ViewportWidth}"
                    MinHeight="{Binding ElementName=PART_ScrollViewer, Path=ViewportHeight}"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
                    <Grid
                        Margin="0,44,0,44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding CurrentProject.PopupZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" ScaleY="{Binding CurrentProject.PopupZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" />
                        </Grid.LayoutTransform>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid
                                Width="{Binding ElementName=root, Path=PopupPreviewSurfaceWidth}"
                                Height="{Binding ElementName=root, Path=PopupPreviewSurfaceHeight}"
                                ClipToBounds="False">
                                <Rectangle
                                    Width="{Binding CurrentProject.DeviceWidth, FallbackValue=100}"
                                    Height="{Binding CurrentProject.DeviceHeight, FallbackValue=100}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Fill="{DynamicResource DesignAreaBackground}"
                                    Stroke="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                    StrokeDashArray="2 2"
                                    StrokeThickness="1" />

                                <Canvas Background="Transparent" ClipToBounds="False">
                                    <Grid Canvas.Left="{Binding ElementName=root, Path=PopupPreviewLeft}" Canvas.Top="{Binding ElementName=root, Path=PopupPreviewTop}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <via:XBorder
                                            Grid.Row="0"
                                            Margin="0"
                                            Padding="4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="False"
                                            UseLayoutRounding="True">
                                            <designer:PopupDesignerControl
                                                x:Name="PART_PopupDesignerControl"
                                                Width="{Binding PopupDesignerWidth, Mode=TwoWay, FallbackValue=200}"
                                                Height="{Binding PopupDesignerHeight, Mode=TwoWay, FallbackValue=250}"
                                                gong:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource Self}}"
                                                gong:DragDrop.IsDropTarget="True"
                                                AllowDrop="True"
                                                ScreenPopup="{Binding CurrentPopup}" />
                                        </via:XBorder>

                                        <Thumb
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Panel.ZIndex="10"
                                            Background="Transparent"
                                            Cursor="SizeNS"
                                            DragDelta="ResizeHeight"
                                            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                            Style="{StaticResource TopHeightHandleStyle}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border
                                                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                                        BorderThickness="0"
                                                        CornerRadius="4 4 0 0">
                                                        <ico:PackIconMaterial
                                                            Width="12"
                                                            Height="12"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Kind="DragVertical" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>

                                        <Thumb
                                            Grid.Row="1"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            Panel.ZIndex="10"
                                            Background="Transparent"
                                            Cursor="SizeNS"
                                            DragDelta="ResizeHeight"
                                            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                            Style="{StaticResource BottomHeightHandleStyle}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border
                                                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                                        BorderThickness="0"
                                                        CornerRadius="0 0 4 4">
                                                        <ico:PackIconMaterial
                                                            Width="12"
                                                            Height="12"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Kind="DragVertical" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>

                                        <Thumb
                                            Grid.Row="0"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            Cursor="SizeWE"
                                            DragDelta="ResizeWidth"
                                            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                            Style="{StaticResource LeftWidthHandleStyle}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border
                                                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                                        BorderThickness="0"
                                                        CornerRadius="4 0 0 4">
                                                        <ico:PackIconMaterial
                                                            Width="12"
                                                            Height="12"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Kind="DragHorizontal" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>

                                        <Thumb
                                            Grid.Row="0"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            Cursor="SizeWE"
                                            DragDelta="ResizeWidth"
                                            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                            Style="{StaticResource RightWidthHandleStyle}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border
                                                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                                        BorderThickness="0"
                                                        CornerRadius="0 4 4 0">
                                                        <ico:PackIconMaterial
                                                            Width="12"
                                                            Height="12"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Kind="DragHorizontal" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Grid>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <via:XBorder
                Grid.Column="1"
                Padding="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="0">
                <via:XBorder.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="270"
                        Opacity="0.12"
                        ShadowDepth="2" />
                </via:XBorder.Effect>

                <Grid ext:GridEx.ColDef="*,Auto">

                    <via:XTextBlock
                        Margin="18,0,15,1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Opacity="0.9"
                        Text="{Binding CurrentPopup.Name, FallbackValue='Popup Name'}" />

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">

                        <ui:DesignerToolbar x:Name="PART_DesignerToolbar" ZoomPercent="{Binding CurrentProject.PopupZoomPercent, Mode=TwoWay}" />

                    </StackPanel>

                </Grid>

            </via:XBorder>

            <via:XBorder
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.ColumnSpan="3"
                Padding="0"
                Background="{DynamicResource NoDataBackground}"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="0"
                Visibility="{Binding CurrentPopup, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ico:PackIconMaterial
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource DangerBrush}"
                        Kind="Information" />
                    <via:XTextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Text="{via:XLoc Popup.None, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                </StackPanel>
            </via:XBorder>
        </Grid>
        </Grid>
    </local:DesignerWorkspaceHost>
</UserControl>



