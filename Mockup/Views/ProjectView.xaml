<UserControl
    x:Class="Mockup.Views.ProjectView"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behav="clr-namespace:Mockup.Behaviors"
    xmlns:colorsystem="clr-namespace:Mockup.ColorSystem"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:gong="urn:gong-wpf-dragdrop"
    xmlns:helper="clr-namespace:Mockup.Helper"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:render="clr-namespace:Mockup.Rendering"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    xmlns:views="clr-namespace:Mockup.Views"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    PreviewMouseWheel="Root_PreviewMouseWheel"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type Thumb}">
            <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Width" Value="50" />
        </Style>
    </UserControl.Resources>

    <Grid
        ext:GridEx.ColDef="360,*"
        ext:GridEx.RowDef="45,45,*,Auto,0"
        ShowGridLines="False">

        <!--  PROJECT HEADER  -->
        <via:XBorder
            Padding="10,0,10,0"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <TextBlock
                Margin="0,0,0,4"
                VerticalAlignment="Center"
                FontSize="17"
                FontWeight="Medium"
                Text="{Binding CurrentProject.Name, FallbackValue='[No project]'}" />
        </via:XBorder>

        <!--  PROJECT BUTTONS  -->
        <via:XBorder
            Grid.Row="1"
            Padding="10,0,8,0"
            Panel.ZIndex="10"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.18"
                    ShadowDepth="3" />
            </via:XBorder.Effect>



            <Grid
                Margin="0,5"
                VerticalAlignment="Stretch"
                ext:GridEx.ColDef="*,*,80,20">

                <via:XButton
                    Grid.Column="0"
                    MinWidth="84"
                    BorderThickness="0"
                    Command="{Binding LoadProjectCommand}"
                    Content="Open .."
                    Cursor="Hand"
                    Focusable="False"
                    FontSize="15"
                    FontWeight="Medium"
                    Icon="{via:MaterialIcon Kind=FolderOpenOutline}"
                    Appearance="Outline"
                    Size="Large"
                    ToolTip="Open Project"
                    Variant="Primary" />

                <via:XButton
                    Grid.Column="1"
                    MinWidth="84"
                    Margin="5,0,0,0"
                    BorderThickness="0"
                    Command="{Binding SaveProjectCommand}"
                    Content="Save"
                    Cursor="Hand"
                    Focusable="False"
                    FontSize="15"
                    FontWeight="Medium"
                    Icon="{via:MaterialIcon Kind=ContentSave}"
                    Size="Large"
                    ToolTip="Save Project"
                    Variant="Primary" />

                <via:XButton
                    Grid.Column="2"
                    Width="60"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Right"
                    BorderThickness="0"
                    Command="{Binding ElementName=root, Path=DataContext.NewProjectCommand}"
                    Cursor="Hand"
                    Focusable="False"
                    Icon="{via:MaterialIcon Kind=Plus}"
                    Size="Large"
                    ToolTip="New Project"
                    Variant="Primary" />



                <via:XMenuButton
                    Grid.Column="3"
                    Width="30"
                    MinWidth="30"
                    Margin="0,0,-0,0"
                    Padding="20,0,0,0"
                    HorizontalAlignment="Right"
                    BorderThickness="0"
                    Content="{via:MaterialIcon Kind=DotsVertical}"
                    Focusable="False"
                    Menu="{StaticResource ProjectActionsContextMenu}"
                    ToolTip="More Project Actions" />


            </Grid>


        </via:XBorder>

        <!--  PROJECT DESCRIPTION AND PROJECT INFO  -->
        <via:XBorder
            Grid.Row="2"
            Padding="14,12,14,14"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <Grid ext:GridEx.RowDef="Auto,Auto,Auto,Auto,Auto,*">

                <via:XTextBlock
                    Grid.Row="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Opacity="0.62"
                    Text="PROJECT INFO" />

                <via:XTextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="{Binding CurrentProject.Name, FallbackValue='[No project]'}"
                    TextTrimming="CharacterEllipsis" />

                <via:XStackPanel
                    Grid.Row="2"
                    Margin="0,15,0,8"
                    Orientation="Vertical"
                    Spacing="8">
                    <via:XBorder Padding="10,7" Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">
                        <via:XBorder.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.15"
                                ShadowDepth="2" />
                        </via:XBorder.Effect>
                        <Grid Margin="0,1,0,0" ext:GridEx.ColDef="Auto,*">
                            <via:XTextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Opacity="0.62"
                                Text="Device" />
                            <via:XTextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                FontWeight="SemiBold">
                                <via:XTextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} × {1}">
                                        <Binding Path="CurrentProject.DeviceWidth" />
                                        <Binding Path="CurrentProject.DeviceHeight" />
                                    </MultiBinding>
                                </via:XTextBlock.Text>
                            </via:XTextBlock>
                        </Grid>
                    </via:XBorder>

                </via:XStackPanel>

                <UniformGrid
                    Grid.Row="3"
                    Margin="0,3,0,12"
                    Columns="2">
                    <via:XBorder
                        MinHeight="74"
                        Margin="0,0,5,5"
                        Padding="12,10"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">
                        <via:XBorder.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.15"
                                ShadowDepth="2" />
                        </via:XBorder.Effect>
                        <Grid ext:GridEx.ColDef="4,*">
                            <via:XBorder
                                Padding="0"
                                Background="IndianRed"
                                CornerRadius="1" />
                            <via:XStackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="3">
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentProject.Screens.Count}" />
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.72"
                                    Text="Screens" />
                            </via:XStackPanel>
                        </Grid>
                    </via:XBorder>

                    <via:XBorder
                        MinHeight="74"
                        Margin="5,0,0,5"
                        Padding="12,10"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">
                        <via:XBorder.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.15"
                                ShadowDepth="2" />
                        </via:XBorder.Effect>
                        <Grid ext:GridEx.ColDef="4,*">
                            <via:XBorder
                                Padding="0"
                                Background="DarkTurquoise"
                                CornerRadius="1" />
                            <via:XStackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="3">
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding Templates.Count}" />
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.72"
                                    Text="Templates" />
                            </via:XStackPanel>
                        </Grid>
                    </via:XBorder>

                    <via:XBorder
                        MinHeight="74"
                        Margin="0,5,5,0"
                        Padding="10,10"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">
                        <via:XBorder.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.15"
                                ShadowDepth="2" />
                        </via:XBorder.Effect>
                        <Grid ext:GridEx.ColDef="4,*">
                            <via:XBorder
                                Padding="0"
                                Background="DarkViolet"
                                CornerRadius="1" />
                            <via:XStackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="3">
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentProject.Popups.Count}" />
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.72"
                                    Text="Popups" />
                            </via:XStackPanel>
                        </Grid>
                    </via:XBorder>

                    <via:XBorder
                        MinHeight="74"
                        Margin="5,5,0,0"
                        Padding="12,9"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">
                        <via:XBorder.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.15"
                                ShadowDepth="2" />
                        </via:XBorder.Effect>
                        <Grid ext:GridEx.ColDef="4,*">
                            <via:XBorder
                                Padding="0"
                                Background="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                CornerRadius="1" />
                            <via:XStackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="3">
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding ControlCountValue}" />
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.72"
                                    Text="Controls" />
                            </via:XStackPanel>
                        </Grid>
                    </via:XBorder>
                </UniformGrid>

                <via:XStackPanel
                    Grid.Row="4"
                    Margin="0,0,0,10"
                    Orientation="Vertical"
                    Spacing="8">
                    <via:XBorder Padding="10,7" Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">
                        <via:XBorder.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.15"
                                ShadowDepth="2" />
                        </via:XBorder.Effect>
                        <Grid Margin="0,1,0,0" ext:GridEx.ColDef="Auto,*">
                            <via:XTextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Opacity="0.62"
                                Text="Sharing" />
                            <via:XTextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                FontWeight="SemiBold">
                                <via:XTextBlock.Text>
                                    <MultiBinding StringFormat="{}Shared {0} · Readonly {1}">
                                        <Binding Path="CurrentProject.IsShared" />
                                        <Binding Path="CurrentProject.IsSharedReadonly" />
                                    </MultiBinding>
                                </via:XTextBlock.Text>
                            </via:XTextBlock>
                        </Grid>
                    </via:XBorder>

                    <via:XBorder Padding="10,7" Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">
                        <via:XBorder.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.15"
                                ShadowDepth="2" />
                        </via:XBorder.Effect>
                        <Grid Margin="0,1,0,0" ext:GridEx.ColDef="Auto,*">
                            <via:XTextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Opacity="0.62"
                                Text="File" />
                            <via:XTextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding CurrentProject.FilePath}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding CurrentProject.FilePath}" />
                        </Grid>
                    </via:XBorder>
                </via:XStackPanel>

                <Grid
                    Grid.Row="5"
                    Margin="0,10,0,0"
                    ext:GridEx.RowDef="Auto,Auto,*">
                    <via:XTextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.62"
                        Text="DESCRIPTION" />
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="128"
                        Margin="0,7,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <via:XTextBlock
                            FontSize="13"
                            Opacity="0.76"
                            Text="{Binding CurrentProject.Description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWithOverflow"
                            Visibility="Visible" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </via:XBorder>

        <!--  PROJECT SETTINGS SUMMARY  -->
        <via:XBorder
            Grid.Row="3"
            Padding="12"
            Background="{DynamicResource {x:Static via:XBrushKeys.Background}}"
            BorderThickness="0,0,1,0"
            CornerRadius="0">
            <Grid>
                <via:XBorder Padding="10,8,10,10" Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}">
                    <via:XBorder.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Direction="270"
                            Opacity="0.15"
                            ShadowDepth="2" />
                    </via:XBorder.Effect>
                    <Grid ext:GridEx.ColDef="*,Auto" ext:GridEx.RowDef="Auto,Auto">
                        <via:XTextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.62"
                            Text="Theme" />

                        <via:XStackPanel
                            Grid.Column="1"
                            Margin="0,-3,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="3">

                            <via:XIconButton
                                Width="26"
                                Height="26"
                                MinWidth="26"
                                MinHeight="26"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding NewColorSchemaCommand}"
                                Icon="{via:MaterialIcon Kind=Plus}"
                                IconSize="12"
                                Size="Small"
                                ToolTip="New Color Scheme" />

                            <via:XIconButton
                                Width="26"
                                Height="26"
                                MinWidth="26"
                                MinHeight="26"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding EditColorSchemaCommand}"
                                Icon="{via:MaterialIcon Kind=PencilOutline}"
                                IconSize="12"
                                Size="Small"
                                ToolTip="Edit Color Scheme" />

                            <via:XIconButton
                                Width="26"
                                Height="26"
                                MinWidth="26"
                                MinHeight="26"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DeleteColorSchemaCommand}"
                                Foreground="{DynamicResource DangerBrush}"
                                Icon="{via:MaterialIcon Kind=DeleteOutline}"
                                IconSize="12"
                                Size="Small"
                                ToolTip="Delete Color Scheme" />
                        </via:XStackPanel>

                        <via:XComboBox
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,9,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand"
                            Focusable="False"
                            ItemsSource="{Binding Source={x:Static colorsystem:ColorSchemaCatalog.All}}"
                            SelectedValue="{Binding CurrentProject.ColorSchemaKey, Mode=TwoWay}"
                            SelectedValuePath="Key"
                            UseLayoutRounding="True">
                            <via:XComboBox.ItemTemplate>
                                <DataTemplate DataType="colorsystem:ColorSchema">
                                    <Grid ext:GridEx.ColDef="Auto,*" IsHitTestVisible="False">
                                        <StackPanel VerticalAlignment="Stretch" Orientation="Horizontal">
                                            <!--  Swatches  -->
                                            <StackPanel Margin="-2,1,10,0" Orientation="Horizontal">
                                                <StackPanel.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Width" Value="20" />
                                                        <Setter Property="Height" Value="20" />
                                                        <Setter Property="Margin" Value="1,0" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="CornerRadius" Value="2" />
                                                    </Style>
                                                </StackPanel.Resources>
                                                <Border Background="{Binding PrimaryBrush}" ToolTip="Primary" />
                                                <Border Background="{Binding AccentBrush}" ToolTip="Accent" />
                                                <Border Background="{Binding InfoBrush}" ToolTip="Info" />
                                                <Border Background="{Binding WarningBrush}" ToolTip="Warning" />
                                                <Border Background="{Binding ErrorBrush}" ToolTip="Error" />
                                                <Border Background="{Binding SuccessBrush}" ToolTip="Success" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!--  Name  -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,0,15,2"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </via:XComboBox.ItemTemplate>
                        </via:XComboBox>
                    </Grid>
                </via:XBorder>
            </Grid>
        </via:XBorder>

        <!--  COLOR SCHEMES  -->
        <via:XBorder
            Grid.Row="4"
            Padding="0,2,0,8"
            BorderThickness="0,0,1,0"
            Visibility="Collapsed">
            <!--  Background="White"  -->
            <via:XColorSchemeView
                Grid.Row="1"
                AccentBrush="{Binding CurrentProject.ActiveColorSchema.AccentBrush}"
                SchemeBorderBrush="{Binding CurrentProject.ActiveColorSchema.BorderBrush}"
                ControlBackgroundBrush="{Binding CurrentProject.ActiveColorSchema.ControlBGBrush}"
                ControlBorderBrush="{Binding CurrentProject.ActiveColorSchema.ControlBorderBrush}"
                DangerBrush="{Binding CurrentProject.ActiveColorSchema.ErrorBrush}"
                InfoBrush="{Binding CurrentProject.ActiveColorSchema.InfoBrush}"
                NeutralBrush="{Binding CurrentProject.ActiveColorSchema.NeutralBrush}"
                PrimaryBrush="{Binding CurrentProject.ActiveColorSchema.PrimaryBrush}"
                SuccessBrush="{Binding CurrentProject.ActiveColorSchema.SuccessBrush}"
                TextBrush="{Binding CurrentProject.ActiveColorSchema.TextBrush}"
                WarningBrush="{Binding CurrentProject.ActiveColorSchema.WarningBrush}" />
        </via:XBorder>


        <!--
            ##########################################################################################
            RIGHT SIDE
            ##########################################################################################
        -->

        <!--  SCREEN HEADER  -->
        <via:XBorder
            Grid.Column="1"
            Padding="15,0,0,0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
            <Grid ext:GridEx.ColDef="*,Auto">

                <StackPanel Orientation="Horizontal">
                    <via:XTextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Text="{Binding CurrentProject.Name, FallbackValue='[No project]'}" />
                    <via:XTextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Text="Screens"
                        Visibility="{Binding CurrentProject, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <via:XZoomSlider
                        x:Name="PART_ZoomSlider"
                        Margin="3,0,10,0"
                        HorizontalAlignment="Right"
                        BorderThickness="1,0,0,0"
                        Cursor="Hand"
                        MaxZoomPercent="100"
                        MinZoomPercent="25"
                        TickFrequency="1"
                        ZoomPercent="{Binding CurrentProject.ProjectZoomPercent, Mode=TwoWay}" />
                </StackPanel>

            </Grid>
        </via:XBorder>

        <!--  SCREENS LIST  -->
        <Grid
            x:Name="PART_ScreensHost"
            Grid.Row="2"
            Grid.RowSpan="3"
            Grid.Column="1"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
            <via:XListBox
                x:Name="PART_ScreensList"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                ContextMenu="{StaticResource ProjectScreenListContextMenu}"
                ItemsSource="{Binding ScreensGroupedView}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectedItem="{Binding CurrentScreen}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <via:XListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </via:XListBox.ItemsPanel>

                <via:XListBox.Resources>
                    <Style TargetType="{x:Type ScrollBar}">
                        <Setter Property="Width" Value="118" />
                    </Style>
                </via:XListBox.Resources>


                <via:XListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0" Padding="6">
                            <Border
                                Background="#2A2B2D"
                                BorderThickness="0"
                                CornerRadius="8 8 5 5">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Direction="315"
                                        Opacity="0.38"
                                        ShadowDepth="2" />
                                </Border.Effect>

                                <Grid
                                    Margin="7"
                                    ext:GridEx.RowDef="Auto,*"
                                    Background="Transparent">

                                    <!--  SCREEN ACTION PANEL  -->
                                    <via:XBorder
                                        Height="45"
                                        Margin="0,-45,0,0"
                                        Padding="8,0"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource ToolBarElemBGBrush}"
                                        CornerRadius="6 6 0 0"
                                        Opacity="0">

                                        <via:XBorder.Tag>
                                            <MultiBinding Converter="{via:BooleanOr}">
                                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
                                                <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
                                            </MultiBinding>
                                        </via:XBorder.Tag>

                                        <via:XBorder.RenderTransform>
                                            <TranslateTransform Y="36" />
                                        </via:XBorder.RenderTransform>

                                        <via:XBorder.Style>
                                            <Style TargetType="{x:Type via:XBorder}">
                                                <Setter Property="IsHitTestVisible" Value="False" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">

                                                        <Setter Property="IsHitTestVisible" Value="True" />

                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.22">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>

                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                        To="0"
                                                                        Duration="0:0:0.22">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>

                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.16">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseIn" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>

                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                        To="36"
                                                                        Duration="0:0:0.16">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseIn" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>

                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </via:XBorder.Style>

                                        <via:XStackPanel
                                            Margin="0,-12,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="5">

                                            <via:XIconButton
                                                VerticalAlignment="Center"
                                                Appearance="Ghost"
                                                Command="{Binding DataContext.EditScreenCoreCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectView}}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{via:MaterialIcon Kind=PencilOutline}"
                                                IconSize="16"
                                                Size="Small"
                                                ToolTip="Edit screen"
                                                Variant="Primary" />

                                            <via:XIconButton
                                                VerticalAlignment="Center"
                                                Appearance="Ghost"
                                                Command="{Binding DataContext.DeleteScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectView}}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{via:MaterialIcon Kind=DeleteOutline}"
                                                IconSize="14"
                                                Size="Small"
                                                ToolTip="Delete screen"
                                                Variant="Danger" />

                                            <via:XIconButton
                                                VerticalAlignment="Center"
                                                Appearance="Ghost"
                                                Command="{Binding DataContext.GotoScreenPageCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectView}}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{via:MaterialIcon Kind=ArrowRightBold}"
                                                IconSize="18"
                                                Size="Small"
                                                ToolTip="Goto screen"
                                                Variant="Primary" />

                                        </via:XStackPanel>
                                    </via:XBorder>

                                    <Border Background="{DynamicResource {x:Static via:XBrushKeys.PrimaryStrong}}" CornerRadius="4 4 0 0">
                                        <Grid ext:GridEx.ColDef="*,Auto,Auto">
                                            <TextBlock
                                                Margin="5,0,4,1"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                Opacity="0.92"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />

                                            <via:XIconButton
                                                Grid.Column="2"
                                                MinHeight="30"
                                                Margin="0,0,2,2"
                                                Variant="Default"
                                                Appearance="Ghost"
                                                Command="{Binding DataContext.SetAsHomeScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectView}}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{via:MaterialIcon Kind=HomeOutline}"
                                                IconSize="18"
                                                Opacity="0.9"
                                                Size="Small"
                                                ToolTip="Set as Home Screen">
                                                <via:XIconButton.Style>
                                                    <Style TargetType="{x:Type via:XIconButton}">
                                                        <Setter Property="Foreground" Value="{themes:AppThemeBinding Light='#909295',Dark='#505255'}" />
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHomeScreen}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </via:XIconButton.Style>
                                            </via:XIconButton>

                                        </Grid>
                                    </Border>

                                    <Grid
                                        Grid.Row="1"
                                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                        ClipToBounds="True">
                                        <Grid
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            RenderTransformOrigin="0,0">
                                            <Grid.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding ElementName=root, Path=DataContext.CurrentProject.ProjectZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" ScaleY="{Binding ElementName=root, Path=DataContext.CurrentProject.ProjectZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" />
                                            </Grid.LayoutTransform>

                                            <Grid>
                                                <Border
                                                    Margin="0"
                                                    Padding="0"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                                    UseLayoutRounding="False">
                                                    <render:ScreenThumbnail
                                                        x:Name="PART_ScreenThumbnail"
                                                        Width="{Binding ElementName=root, Path=DataContext.CurrentProject.DeviceWidth}"
                                                        Height="{Binding ElementName=root, Path=DataContext.CurrentProject.DeviceHeight}"
                                                        Screen="{Binding}" />
                                                </Border>

                                                <!--  LONG BADGE  -->
                                                <Border
                                                    Margin="0,8,8,0"
                                                    Padding="8,3,8,3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                                    CornerRadius="10"
                                                    IsHitTestVisible="False">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource GreaterThanToVisibilityConverter}">
                                                            <Binding Path="ScreenHeight" />
                                                            <Binding ElementName="root" Path="DataContext.CurrentProject.DeviceHeight" />
                                                        </MultiBinding>
                                                    </Border.Visibility>

                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                        Text="LONG" />
                                                </Border>

                                                <!--  CONTINUE INDICATOR  -->
                                                <Grid
                                                    Width="{Binding ElementName=PART_ScreenThumbnail, Path=ActualWidth}"
                                                    Height="52"
                                                    MaxWidth="{Binding Width}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    ClipToBounds="True"
                                                    IsHitTestVisible="False">

                                                    <Grid.Visibility>
                                                        <MultiBinding Converter="{StaticResource GreaterThanToVisibilityConverter}">
                                                            <Binding Path="ScreenHeight" />
                                                            <Binding ElementName="root" Path="DataContext.CurrentProject.DeviceHeight" />
                                                        </MultiBinding>
                                                    </Grid.Visibility>

                                                    <!--  Fläche  -->
                                                    <Path
                                                        Data="M 0,22 C 120,8 290,8 420,18 C 540,27 660,30 770,25 C 860,21 930,16 1000,14 L 1000,56 L 0,56 Z"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Fill" />

                                                    <!--  obere Kontur optional  -->
                                                    <Path
                                                        Data="M 0,22 C 120,8 290,8 420,18 C 540,27 660,30 770,25 C 860,21 930,16 1000,14"
                                                        Stretch="Fill"
                                                        StrokeThickness="0" />

                                                    <!--  Inhalt  -->
                                                    <Grid
                                                        Margin="0,0,0,7"
                                                        VerticalAlignment="Stretch"
                                                        ext:GridEx.ColDef="*,Auto">

                                                        <TextBlock
                                                            Margin="15,0,0,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            FontSize="20"
                                                            FontWeight="Medium"
                                                            Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                            Opacity="0.95"
                                                            Text="Continues .." />

                                                        <via:XStackPanel
                                                            Grid.Column="1"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Bottom"
                                                            Orientation="Horizontal"
                                                            Spacing="5">
                                                            <TextBlock
                                                                FontSize="20"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                                Opacity="0.8"
                                                                Text="{Binding Width}" />
                                                            <TextBlock
                                                                FontSize="20"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                                Opacity="0.8"
                                                                Text="x" />
                                                            <TextBlock
                                                                FontSize="20"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                                Opacity="0.8"
                                                                Text="{Binding ScreenHeight}" />
                                                        </via:XStackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>


                            </Border>
                        </Border>
                    </DataTemplate>
                </via:XListBox.ItemTemplate>

                <via:XListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="15" />
                        <Setter Property="Margin" Value="15" />
                        <Setter Property="ClipToBounds" Value="False" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>
                </via:XListBox.ItemContainerStyle>

            </via:XListBox>
        </Grid>

        <!--  SCREEN BUTTONS  -->
        <via:XBorder
            Grid.Row="1"
            Grid.Column="1"
            Padding="0"
            Panel.ZIndex="10"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.18"
                    ShadowDepth="3" />
            </via:XBorder.Effect>
            <Grid ext:GridEx.ColDef="*,Auto,Auto">
                <via:XListBox
                    x:Name="PART_ScreenGroupList"
                    Margin="5,0,5,2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ScreenFilterGroupNames}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding CurrentScreenFilterGroupName, Mode=TwoWay}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True">
                    
                    <via:XListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="6,0,6,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </via:XListBox.ItemContainerStyle>

                    <via:XListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel VirtualizingPanel.IsVirtualizing="True"/>
                        </ItemsPanelTemplate>
                    </via:XListBox.ItemsPanel>

                    <via:XListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MinWidth="64"
                                Padding="13,5,13,5"
                                BorderThickness="0"
                                CornerRadius="14"
                                Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.SurfaceDark}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.HoverBackground}}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{Binding}">
                                    <via:XTextBlock.Style>
                                        <Style TargetType="via:XTextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </via:XTextBlock.Style>
                                </via:XTextBlock>
                            </Border>
                        </DataTemplate>
                    </via:XListBox.ItemTemplate>
                </via:XListBox>

                <via:XStackPanel
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <via:XButton
                        Margin="5,0,0,0"
                        Command="{Binding NewScreenCommand}"
                        Cursor="Hand"
                        Icon="{via:MaterialIcon Kind=Plus}"
                        ToolTip="New Screen"
                        Variant="Primary" />

                </via:XStackPanel>

            </Grid>
        </via:XBorder>

    </Grid>
</UserControl>
