<UserControl
    x:Class="Mockup.Views.ProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behav="clr-namespace:Mockup.Behaviors"
    xmlns:colorsystem="clr-namespace:Mockup.ColorSystem"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:gong="urn:gong-wpf-dragdrop"
    xmlns:helper="clr-namespace:Mockup.Helper"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:render="clr-namespace:Mockup.Rendering"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    xmlns:views="clr-namespace:Mockup.Views"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    PreviewMouseWheel="Root_PreviewMouseWheel"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type Thumb}">
            <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Width" Value="50" />
        </Style>
    </UserControl.Resources>

    <via:XGrid Columns="360,*" Rows="45,45,*,Auto,0">

        <!--  PROJECT HEADER  -->
        <via:XBorder
            Padding="15,0"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <TextBlock
                Margin="0,0,0,4"
                VerticalAlignment="Center"
                FontSize="17"
                FontWeight="Medium"
                Text="{Binding CurrentProject.Name, FallbackValue='[No project]'}" />
        </via:XBorder>

        <!--  PROJECT BUTTONS  -->
        <via:XBorder
            Grid.Row="1"
            Padding="10,0,8,0"
            Panel.ZIndex="10"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.18"
                    ShadowDepth="3" />
            </via:XBorder.Effect>



            <via:XGrid Columns="*,Auto">

                <via:XStackPanel
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal"
                    Spacing="5">

                    <via:XButton
                        MinWidth="70"
                        Appearance="Outline"
                        BorderThickness="0.5"
                        Command="{Binding LoadProjectCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        FontSize="15"
                        FontWeight="Medium"
                        Icon="{via:MaterialIcon Kind=FolderOpenOutline}"
                        Size="Large"
                        ToolTip="{via:XLoc Project.OpenProjectTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />

                    <via:XButton
                        MinWidth="70"
                        Command="{Binding SaveProjectCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        FontSize="15"
                        FontWeight="Medium"
                        Icon="{via:MaterialIcon Kind=ContentSave}"
                        Size="Large"
                        ToolTip="{via:XLoc Project.SaveProjectTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />

                </via:XStackPanel>

                <via:XStackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal"
                    Spacing="2">
                    <via:XButton
                        Appearance="Subtle"
                        Command="{Binding EditProjectCommand}"
                        CommandParameter="{Binding CurrentProjectFile}"
                        Cursor="Hand"
                        Focusable="False"
                        Icon="{via:MaterialIcon Kind=PencilOutline}"
                        Size="Large"
                        ToolTip="{via:XLoc Project.EditProjectSettingsTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />
                    <via:XButton
                        Appearance="Subtle"
                        Command="{Binding ElementName=root, Path=DataContext.NewProjectCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        Icon="{via:MaterialIcon Kind=Plus}"
                        IconSize="16"
                        Size="Large"
                        ToolTip="{via:XLoc Project.NewProjectTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />

                    <via:XMenuButton
                        Appearance="Subtle"
                        Cursor="Hand"
                        Focusable="False"
                        Icon="{via:MaterialIcon Kind=DotsVertical}"
                        IconSize="14"
                        Menu="{StaticResource ProjectActionsContextMenu}"
                        Size="Large"
                        ToolTip="{via:XLoc Project.MoreProjectActionsTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />
                </via:XStackPanel>

            </via:XGrid>


        </via:XBorder>

        <!--  PROJECT INFORMATION  -->
        <via:XBorder
            Grid.Row="2"
            Padding="15,15"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <via:XGrid Rows="Auto,Auto,Auto,Auto,*">

                <via:XTextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{Binding CurrentProject.Name, FallbackValue='[No project]'}"
                    TextTrimming="CharacterEllipsis" />

                <via:XBorder
                    Grid.Row="1"
                    Margin="0,15,0,0"
                    Padding="15,12,20,13"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
                    <via:XGrid Columns="*,Auto">
                        <via:XTextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{via:XLoc Project.Device,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                        <via:XTextBlock
                            Grid.Column="1"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Variant="Primary">
                            <via:XTextBlock.Text>
                                <MultiBinding StringFormat="{}{0} × {1}">
                                    <Binding Path="CurrentProject.DeviceWidth" />
                                    <Binding Path="CurrentProject.DeviceHeight" />
                                </MultiBinding>
                            </via:XTextBlock.Text>
                        </via:XTextBlock>

                    </via:XGrid>
                </via:XBorder>

                <via:XUniformGrid
                    Grid.Row="2"
                    Margin="0,16,0,14"
                    Columns="2">
                    <via:XBorder
                        MinHeight="58"
                        Margin="0,0,5,5"
                        Padding="0"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                        CornerRadius="6">
                        <Grid ext:GridEx.ColDef="10,*">
                            <via:XBorder
                                Padding="0"
                                Background="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                BorderThickness="0"
                                CornerRadius="6,0,0,6" />
                            <via:XStackPanel
                                Grid.Column="1"
                                Margin="12,7"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="1">
                                <via:XTextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentProject.Screens.Count}" />
                                <via:XTextBlock
                                    FontSize="11"
                                    Opacity="0.62"
                                    Text="{via:XLoc Project.Screens,
                                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            </via:XStackPanel>
                        </Grid>
                    </via:XBorder>

                    <via:XBorder
                        MinHeight="58"
                        Margin="5,0,0,5"
                        Padding="0"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                        CornerRadius="6">
                        <via:XGrid Columns="10,*">
                            <via:XBorder
                                Padding="0"
                                Background="{DynamicResource {x:Static via:XBrushKeys.Accent}}"
                                BorderThickness="0"
                                CornerRadius="6,0,0,6" />
                            <via:XStackPanel
                                Grid.Column="1"
                                Margin="12,7"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="1">
                                <via:XTextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding Templates.Count}" />
                                <via:XTextBlock
                                    FontSize="11"
                                    Opacity="0.62"
                                    Text="{via:XLoc Project.Templates,
                                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            </via:XStackPanel>
                        </via:XGrid>
                    </via:XBorder>

                    <via:XBorder
                        MinHeight="58"
                        Margin="0,5,5,0"
                        Padding="0"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                        CornerRadius="6">
                        <via:XGrid Columns="10,*">
                            <via:XBorder
                                Padding="0"
                                Background="{DynamicResource {x:Static via:XBrushKeys.InfoDark}}"
                                BorderThickness="0"
                                CornerRadius="6,0,0,6" />
                            <via:XStackPanel
                                Grid.Column="1"
                                Margin="12,7"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="1">
                                <via:XTextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding CurrentProject.Popups.Count}" />
                                <via:XTextBlock
                                    FontSize="11"
                                    Opacity="0.62"
                                    Text="{via:XLoc Project.Popups,
                                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            </via:XStackPanel>
                        </via:XGrid>
                    </via:XBorder>

                    <via:XBorder
                        MinHeight="58"
                        Margin="5,5,0,0"
                        Padding="0"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                        CornerRadius="6">
                        <via:XGrid Columns="10,*">
                            <via:XBorder
                                Padding="0"
                                Background="{DynamicResource {x:Static via:XBrushKeys.Warning}}"
                                BorderThickness="0"
                                CornerRadius="6,0,0,6" />
                            <via:XStackPanel
                                Grid.Column="1"
                                Margin="12,7"
                                VerticalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="1">
                                <via:XTextBlock
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding ControlCountValue}" />
                                <via:XTextBlock
                                    FontSize="11"
                                    Opacity="0.62"
                                    Text="{via:XLoc Project.Controls,
                                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            </via:XStackPanel>
                        </via:XGrid>
                    </via:XBorder>
                </via:XUniformGrid>

                <via:XBorder
                    Grid.Row="3"
                    Padding="10,8,0,8"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
                    <via:XGrid Columns="*,*" Rows="Auto,*">
                        <via:XTextBlock
                            Margin="0,0,0,4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.62"
                            Text="{via:XLoc Project.Sharing,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                        <via:XStackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <via:XTextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Medium"
                                Text="{via:XLoc Project.Shared,
                                                ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            <ico:PackIconMaterial
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <ico:PackIconMaterial.Style>
                                    <Style TargetType="{x:Type ico:PackIconMaterial}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.StatusSuccess}}" />
                                        <Setter Property="Kind" Value="CheckboxOutline" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentProject.IsShared}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.StatusDanger}}" />
                                                <Setter Property="Kind" Value="CloseBoxOutline" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ico:PackIconMaterial.Style>
                            </ico:PackIconMaterial>
                        </via:XStackPanel>


                        <via:XStackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <via:XTextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Medium"
                                Text="{via:XLoc Project.Readonly,
                                                ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            <ico:PackIconMaterial
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <ico:PackIconMaterial.Style>
                                    <Style TargetType="{x:Type ico:PackIconMaterial}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.StatusSuccess}}" />
                                        <Setter Property="Kind" Value="CheckboxOutline" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentProject.IsSharedReadonly}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.StatusDanger}}" />
                                                <Setter Property="Kind" Value="CloseBoxOutline" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ico:PackIconMaterial.Style>
                            </ico:PackIconMaterial>
                        </via:XStackPanel>

                    </via:XGrid>
                </via:XBorder>
                <!--<via:XBorder
                    Grid.Row="3"
                    Padding="10,8"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                    BorderThickness="1">
                    <via:XGrid Rows="Auto,*">
                        <via:XGrid MinHeight="24" Columns="Auto,*">
                            <via:XGrid
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Columns="Auto,Auto"
                                Rows="Auto,*">
                                <via:XGrid VerticalAlignment="Center" Columns="Auto,24">
                                    <via:XTextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Text="{via:XLoc Project.Shared,
                                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                    <ico:PackIconMaterial
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <ico:PackIconMaterial.Style>
                                            <Style TargetType="{x:Type ico:PackIconMaterial}">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.StatusSuccess}}" />
                                                <Setter Property="Kind" Value="CheckboxOutline" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentProject.IsShared}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.StatusDanger}}" />
                                                        <Setter Property="Kind" Value="CloseBoxOutline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ico:PackIconMaterial.Style>
                                    </ico:PackIconMaterial>
                                </via:XGrid>
                                <via:XGrid
                                    Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Columns="Auto,24">
                                    <via:XTextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Text="{via:XLoc Project.Readonly,
                                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                    <ico:PackIconMaterial
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <ico:PackIconMaterial.Style>
                                            <Style TargetType="{x:Type ico:PackIconMaterial}">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.StatusSuccess}}" />
                                                <Setter Property="Kind" Value="CheckboxOutline" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentProject.IsSharedReadonly}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.StatusDanger}}" />
                                                        <Setter Property="Kind" Value="CloseBoxOutline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ico:PackIconMaterial.Style>
                                    </ico:PackIconMaterial>
                                </via:XGrid>
                            </via:XGrid>
                        </via:XGrid>
                        <via:XGrid
                            Grid.Row="1"
                            Margin="0,7,0,0"
                            Columns="Auto,*">
                            <via:XTextBlock
                                FontSize="12"
                                Opacity="0.62"
                                Text="{via:XLoc Project.File,
                                                ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                            <via:XTextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                FontSize="12"
                                FontWeight="Medium"
                                Text="{Binding CurrentProject.FilePath}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding CurrentProject.FilePath}" />
                        </via:XGrid>
                    </via:XGrid>
                </via:XBorder>-->

                <via:XGrid
                    Grid.Row="4"
                    Margin="0,14,0,0"
                    Rows="Auto,*">
                    <via:XTextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.62"
                        Text="{via:XLoc Project.Description,
                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,7,0,0"
                        VerticalAlignment="Stretch"
                        VerticalScrollBarVisibility="Auto">
                        <via:XTextBlock
                            Padding="0,0,10,0"
                            VerticalAlignment="Top"
                            FontSize="13"
                            Opacity="0.76"
                            Text="{Binding CurrentProject.Description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWithOverflow"
                            Visibility="Visible" />
                    </ScrollViewer>
                </via:XGrid>
            </via:XGrid>
        </via:XBorder>

        <!--  PROJECT DESIGN  -->
        <via:XBorder
            Grid.Row="3"
            Padding="15,10"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderThickness="0,0,1,0"
            CornerRadius="0">
            <via:XGrid Columns="*,Auto" Rows="Auto,Auto,Auto">
                <via:XStackPanel Orientation="Vertical">
                    <via:XTextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{via:XLoc Project.Theme,
                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                </via:XStackPanel>

                <via:XStackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="5">

                    <via:XIconButton
                        Appearance="Subtle"
                        Command="{Binding NewColorSchemaCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        Icon="{via:MaterialIcon Kind=Plus}"
                        IconSize="16"
                        Size="Medium"
                        ToolTip="{via:XLoc Project.NewColorSchemeTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />

                    <via:XIconButton
                        Appearance="Subtle"
                        Command="{Binding EditColorSchemaCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        Icon="{via:MaterialIcon Kind=PencilOutline}"
                        IconSize="16"
                        Size="Medium"
                        ToolTip="{via:XLoc Project.EditColorSchemeTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />

                    <via:XIconButton
                        Appearance="Subtle"
                        Command="{Binding DeleteColorSchemaCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        Icon="{via:MaterialIcon Kind=DeleteOutline}"
                        IconSize="16"
                        Size="Medium"
                        ToolTip="{via:XLoc Project.DeleteColorSchemeTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Danger" />
                </via:XStackPanel>

                <via:XComboBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    MinHeight="38"
                    Margin="0,12,0,0"
                    HorizontalContentAlignment="Stretch"
                    Cursor="Hand"
                    Focusable="False"
                    ItemsSource="{Binding Source={x:Static colorsystem:ColorSchemaCatalog.All}}"
                    SelectedValue="{Binding CurrentProject.ColorSchemaKey, Mode=TwoWay}"
                    SelectedValuePath="Key"
                    UseLayoutRounding="True">
                    <via:XComboBox.ItemTemplate>
                        <DataTemplate DataType="colorsystem:ColorSchema">
                            <Grid ext:GridEx.ColDef="Auto,*" IsHitTestVisible="False">
                                <StackPanel
                                    Margin="-2,1,10,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <StackPanel.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="18" />
                                            <Setter Property="Height" Value="18" />
                                            <Setter Property="Margin" Value="1,0" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="2" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Border Background="{Binding PrimaryBrush}" />
                                    <Border Background="{Binding AccentBrush}" />
                                    <Border Background="{Binding InfoBrush}" />
                                    <Border Background="{Binding WarningBrush}" />
                                    <Border Background="{Binding ErrorBrush}" />
                                    <Border Background="{Binding SuccessBrush}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,12,1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}"
                                    TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </via:XComboBox.ItemTemplate>
                </via:XComboBox>

                <via:XUniformGrid
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,0"
                    Columns="3">
                    <via:XStackPanel
                        Margin="0,0,5,6"
                        Orientation="Vertical"
                        Spacing="3">
                        <via:XTextBlock
                            FontSize="11"
                            Opacity="0.68"
                            Text="{via:XLoc Dialog.ColorScheme.Token.Primary,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                        <via:XBorder
                            Height="18"
                            Background="{Binding CurrentProject.ActiveColorSchema.PrimaryBrush}"
                            CornerRadius="3" />
                    </via:XStackPanel>
                    <via:XStackPanel
                        Margin="5,0,5,6"
                        Orientation="Vertical"
                        Spacing="3">
                        <via:XTextBlock
                            FontSize="11"
                            Opacity="0.68"
                            Text="{via:XLoc Dialog.ColorScheme.Token.Accent,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                        <via:XBorder
                            Height="18"
                            Background="{Binding CurrentProject.ActiveColorSchema.AccentBrush}"
                            CornerRadius="3" />
                    </via:XStackPanel>
                    <via:XStackPanel
                        Margin="5,0,0,6"
                        Orientation="Vertical"
                        Spacing="3">
                        <via:XTextBlock
                            FontSize="11"
                            Opacity="0.68"
                            Text="{via:XLoc Dialog.ColorScheme.Token.Info,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                        <via:XBorder
                            Height="18"
                            Background="{Binding CurrentProject.ActiveColorSchema.InfoBrush}"
                            CornerRadius="3" />
                    </via:XStackPanel>
                    <via:XStackPanel
                        Margin="0,0,5,0"
                        Orientation="Vertical"
                        Spacing="3">
                        <via:XTextBlock
                            FontSize="11"
                            Opacity="0.68"
                            Text="{via:XLoc Dialog.ColorScheme.Token.Warning,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                        <via:XBorder
                            Height="18"
                            Background="{Binding CurrentProject.ActiveColorSchema.WarningBrush}"
                            CornerRadius="3" />
                    </via:XStackPanel>
                    <via:XStackPanel
                        Margin="5,0,5,0"
                        Orientation="Vertical"
                        Spacing="3">
                        <via:XTextBlock
                            FontSize="11"
                            Opacity="0.68"
                            Text="{via:XLoc Dialog.ColorScheme.Token.Error,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                        <via:XBorder
                            Height="18"
                            Background="{Binding CurrentProject.ActiveColorSchema.ErrorBrush}"
                            CornerRadius="3" />
                    </via:XStackPanel>
                    <via:XStackPanel
                        Margin="5,0,0,0"
                        Orientation="Vertical"
                        Spacing="3">
                        <via:XTextBlock
                            FontSize="11"
                            Opacity="0.68"
                            Text="{via:XLoc Dialog.ColorScheme.Token.Success,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                        <via:XBorder
                            Height="18"
                            Background="{Binding CurrentProject.ActiveColorSchema.SuccessBrush}"
                            CornerRadius="3" />
                    </via:XStackPanel>
                </via:XUniformGrid>
            </via:XGrid>
        </via:XBorder>

        <!--  COLOR SCHEMES  -->
        <via:XBorder
            Grid.Row="4"
            Padding="0,2,0,8"
            BorderThickness="0,0,1,0"
            Visibility="Collapsed">
            <!--  Background="White"  -->
            <via:XColorSchemeView
                Grid.Row="1"
                AccentBrush="{Binding CurrentProject.ActiveColorSchema.AccentBrush}"
                ControlBackgroundBrush="{Binding CurrentProject.ActiveColorSchema.ControlBGBrush}"
                ControlBorderBrush="{Binding CurrentProject.ActiveColorSchema.ControlBorderBrush}"
                DangerBrush="{Binding CurrentProject.ActiveColorSchema.ErrorBrush}"
                InfoBrush="{Binding CurrentProject.ActiveColorSchema.InfoBrush}"
                NeutralBrush="{Binding CurrentProject.ActiveColorSchema.NeutralBrush}"
                PrimaryBrush="{Binding CurrentProject.ActiveColorSchema.PrimaryBrush}"
                SchemeBorderBrush="{Binding CurrentProject.ActiveColorSchema.BorderBrush}"
                SuccessBrush="{Binding CurrentProject.ActiveColorSchema.SuccessBrush}"
                TextBrush="{Binding CurrentProject.ActiveColorSchema.TextBrush}"
                WarningBrush="{Binding CurrentProject.ActiveColorSchema.WarningBrush}" />
        </via:XBorder>


        <!--
            ##########################################################################################
            RIGHT SIDE
            ##########################################################################################
        -->

        <!--  SCREEN HEADER  -->
        <via:XBorder
            Grid.Column="1"
            Padding="15,0,0,0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
            <via:XGrid Columns="*,Auto">

                <StackPanel Orientation="Horizontal">
                    <via:XTextBlock
                        Margin="0,0,0,1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Text="{Binding CurrentProject.Name, FallbackValue='[No project]'}" />
                    <via:XTextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Text="{via:XLoc Project.Screens,
                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Visibility="{Binding CurrentProject, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <via:XZoomSlider
                        x:Name="PART_ZoomSlider"
                        Margin="3,0,10,0"
                        HorizontalAlignment="Right"
                        BorderThickness="1,0,0,0"
                        MaxZoomPercent="100"
                        MinZoomPercent="25"
                        ResetButtonToolTip="{via:XLoc Project.ResetZoomTooltip,
                                                      ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        TickFrequency="1"
                        ZoomPercent="{Binding CurrentProject.ProjectZoomPercent, Mode=TwoWay}" />
                </StackPanel>

            </via:XGrid>
        </via:XBorder>

        <!--  SCREENS LIST  -->
        <via:XGrid
            x:Name="PART_ScreensHost"
            Grid.Row="2"
            Grid.RowSpan="3"
            Grid.Column="1"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
            <via:XListBox
                x:Name="PART_ScreensList"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                ContextMenu="{StaticResource ProjectScreenListContextMenu}"
                ItemsSource="{Binding ScreensGroupedView}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectedItem="{Binding CurrentScreen}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <via:XListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </via:XListBox.ItemsPanel>

                <via:XListBox.Resources>
                    <Style TargetType="{x:Type ScrollBar}">
                        <Setter Property="Width" Value="118" />
                    </Style>
                </via:XListBox.Resources>


                <via:XListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0" Padding="6">
                            <Border
                                Background="#2A2B2D"
                                BorderThickness="0"
                                CornerRadius="8 8 5 5">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Direction="315"
                                        Opacity="0.38"
                                        ShadowDepth="2" />
                                </Border.Effect>

                                <via:XGrid
                                    Margin="7"
                                    Background="Transparent"
                                    Rows="Auto,*">

                                    <!--  SCREEN ACTION PANEL  -->
                                    <via:XBorder
                                        Height="50"
                                        Margin="0,-50,0,0"
                                        Padding="8,0"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource ToolBarElemBGBrush}"
                                        CornerRadius="6 6 0 0"
                                        Opacity="0">

                                        <via:XBorder.Tag>
                                            <MultiBinding Converter="{via:BooleanOr}">
                                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
                                                <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
                                            </MultiBinding>
                                        </via:XBorder.Tag>

                                        <via:XBorder.RenderTransform>
                                            <TranslateTransform Y="36" />
                                        </via:XBorder.RenderTransform>

                                        <via:XBorder.Style>
                                            <Style TargetType="{x:Type via:XBorder}">
                                                <Setter Property="IsHitTestVisible" Value="False" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">

                                                        <Setter Property="IsHitTestVisible" Value="True" />

                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.22">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>

                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                        To="0"
                                                                        Duration="0:0:0.22">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>

                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.16">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseIn" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>

                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                        To="36"
                                                                        Duration="0:0:0.16">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <QuadraticEase EasingMode="EaseIn" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>

                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </via:XBorder.Style>

                                        <via:XStackPanel
                                            Margin="0,-13,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="5">

                                            <via:XIconButton
                                                VerticalAlignment="Center"
                                                Appearance="Ghost"
                                                Command="{Binding DataContext.EditScreenCoreCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectView}}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{via:MaterialIcon Kind=Launch}"
                                                IconSize="16"
                                                Size="Small"
                                                ToolTip="{via:XLoc Project.EditScreenTooltip,
                                                                   ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                                Variant="Primary" />

                                            <via:XIconButton
                                                VerticalAlignment="Center"
                                                Appearance="Ghost"
                                                Command="{Binding DataContext.DeleteScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectView}}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{via:MaterialIcon Kind=DeleteOutline}"
                                                IconSize="16"
                                                Size="Small"
                                                ToolTip="{via:XLoc Project.DeleteScreenTooltip,
                                                                   ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                                Variant="Danger" />

                                            <via:XIconButton
                                                VerticalAlignment="Center"
                                                Appearance="Ghost"
                                                Command="{Binding DataContext.GotoScreenPageCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectView}}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{via:MaterialIcon Kind=ArrowRightBold}"
                                                IconSize="16"
                                                Size="Small"
                                                ToolTip="{via:XLoc Project.GotoScreenTooltip,
                                                                   ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                                Variant="Primary" />

                                        </via:XStackPanel>
                                    </via:XBorder>

                                    <Border Background="{DynamicResource {x:Static via:XBrushKeys.PrimaryStrong}}" CornerRadius="4 4 0 0">
                                        <Grid ext:GridEx.ColDef="*,Auto,Auto">
                                            <TextBlock
                                                Margin="5,0,4,1"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                Opacity="0.92"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />

                                            <via:XIconButton
                                                Grid.Column="2"
                                                MinHeight="30"
                                                Margin="0,0,2,2"
                                                Appearance="Ghost"
                                                Command="{Binding DataContext.SetAsHomeScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectView}}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Icon="{via:MaterialIcon Kind=HomeOutline}"
                                                IconSize="18"
                                                Opacity="0.9"
                                                Size="Small"
                                                ToolTip="{via:XLoc Project.SetAsHomeScreenTooltip,
                                                                   ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                                                Variant="Default">
                                                <via:XIconButton.Style>
                                                    <Style TargetType="{x:Type via:XIconButton}">
                                                        <Setter Property="Foreground">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="{themes:AppThemeBinding Light=#FF909295, Dark=#FF505255}" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHomeScreen}" Value="True">
                                                                <Setter Property="Foreground">
                                                                    <Setter.Value>
                                                                        <SolidColorBrush Color="White" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </via:XIconButton.Style>
                                            </via:XIconButton>

                                        </Grid>
                                    </Border>

                                    <via:XGrid Grid.Row="1" Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}">
                                        <Grid
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            RenderTransformOrigin="0,0">
                                            <Grid.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding ElementName=root, Path=DataContext.CurrentProject.ProjectZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" ScaleY="{Binding ElementName=root, Path=DataContext.CurrentProject.ProjectZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" />
                                            </Grid.LayoutTransform>

                                            <Grid>
                                                <Border
                                                    Margin="0"
                                                    Padding="0"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                                    UseLayoutRounding="False">
                                                    <render:ScreenThumbnail
                                                        x:Name="PART_ScreenThumbnail"
                                                        Width="{Binding ElementName=root, Path=DataContext.CurrentProject.DeviceWidth}"
                                                        Height="{Binding ElementName=root, Path=DataContext.CurrentProject.DeviceHeight}"
                                                        Screen="{Binding}" />
                                                </Border>

                                                <!--  LONG BADGE  -->
                                                <Border
                                                    Margin="0,8,8,0"
                                                    Padding="8,3,8,3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                                    CornerRadius="10"
                                                    IsHitTestVisible="False">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource GreaterThanToVisibilityConverter}">
                                                            <Binding Path="ScreenHeight" />
                                                            <Binding ElementName="root" Path="DataContext.CurrentProject.DeviceHeight" />
                                                        </MultiBinding>
                                                    </Border.Visibility>

                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                        Text="LONG" />
                                                </Border>

                                                <!--  CONTINUE INDICATOR  -->
                                                <Grid
                                                    Width="{Binding ElementName=PART_ScreenThumbnail, Path=ActualWidth}"
                                                    Height="52"
                                                    MaxWidth="{Binding Width}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    IsHitTestVisible="False">

                                                    <Grid.Visibility>
                                                        <MultiBinding Converter="{StaticResource GreaterThanToVisibilityConverter}">
                                                            <Binding Path="ScreenHeight" />
                                                            <Binding ElementName="root" Path="DataContext.CurrentProject.DeviceHeight" />
                                                        </MultiBinding>
                                                    </Grid.Visibility>

                                                    <!--  Fläche  -->
                                                    <Path
                                                        Data="M 0,22 C 120,8 290,8 420,18 C 540,27 660,30 770,25 C 860,21 930,16 1000,14 L 1000,56 L 0,56 Z"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Fill" />

                                                    <!--  obere Kontur optional  -->
                                                    <Path
                                                        Data="M 0,22 C 120,8 290,8 420,18 C 540,27 660,30 770,25 C 860,21 930,16 1000,14"
                                                        Stretch="Fill"
                                                        StrokeThickness="0" />

                                                    <!--  Inhalt  -->
                                                    <via:XGrid
                                                        Margin="0,0,0,7"
                                                        VerticalAlignment="Stretch"
                                                        Columns="*,Auto">

                                                        <TextBlock
                                                            Margin="15,0,0,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            FontSize="20"
                                                            FontWeight="Medium"
                                                            Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                            Opacity="0.95"
                                                            Text="Continues .." />

                                                        <via:XStackPanel
                                                            Grid.Column="1"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Bottom"
                                                            Orientation="Horizontal"
                                                            Spacing="5">
                                                            <TextBlock
                                                                FontSize="20"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                                Opacity="0.8"
                                                                Text="{Binding Width}" />
                                                            <TextBlock
                                                                FontSize="20"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                                Opacity="0.8"
                                                                Text="x" />
                                                            <TextBlock
                                                                FontSize="20"
                                                                FontWeight="Medium"
                                                                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                                                                Opacity="0.8"
                                                                Text="{Binding ScreenHeight}" />
                                                        </via:XStackPanel>
                                                    </via:XGrid>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </via:XGrid>
                                </via:XGrid>


                            </Border>
                        </Border>
                    </DataTemplate>
                </via:XListBox.ItemTemplate>

                <via:XListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="15" />
                        <Setter Property="Margin" Value="15" />
                        <Setter Property="ClipToBounds" Value="False" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>
                </via:XListBox.ItemContainerStyle>

            </via:XListBox>
        </via:XGrid>

        <!--  SCREEN BUTTONS  -->
        <via:XBorder
            Grid.Row="1"
            Grid.Column="1"
            Padding="0"
            Panel.ZIndex="10"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.18"
                    ShadowDepth="3" />
            </via:XBorder.Effect>
            <via:XGrid Columns="*,Auto,Auto">
                <via:XListBox
                    x:Name="PART_ScreenGroupList"
                    Margin="5,0,5,2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ScreenFilterGroupNames}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding CurrentScreenFilterGroupName, Mode=TwoWay}"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True">

                    <via:XListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="6,0,6,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </via:XListBox.ItemContainerStyle>

                    <via:XListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </via:XListBox.ItemsPanel>

                    <via:XListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MinWidth="64"
                                Padding="13,5,13,5"
                                BorderThickness="0"
                                CornerRadius="14"
                                Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.SurfaceDark}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.HoverBackground}}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{Binding}">
                                    <via:XTextBlock.Style>
                                        <Style TargetType="via:XTextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </via:XTextBlock.Style>
                                </via:XTextBlock>
                            </Border>
                        </DataTemplate>
                    </via:XListBox.ItemTemplate>
                </via:XListBox>

                <via:XStackPanel
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="4">

                    <via:XButton
                        Margin="5,0,0,0"
                        Appearance="Subtle"
                        Command="{Binding NewScreenCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        Icon="{via:MaterialIcon Kind=Plus}"
                        IconSize="16"
                        Size="Large"
                        ToolTip="{via:XLoc Project.NewScreenTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />

                </via:XStackPanel>

            </via:XGrid>
        </via:XBorder>

    </via:XGrid>
</UserControl>
