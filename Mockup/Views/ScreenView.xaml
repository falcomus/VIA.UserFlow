<UserControl
    x:Class="Mockup.Views.ScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:gong="urn:gong-wpf-dragdrop"
    xmlns:helper="clr-namespace:Mockup.Helper"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    Background="{DynamicResource DesignerBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    PreviewMouseWheel="Root_PreviewMouseWheel"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <local:DesignerWorkspaceHost>
        <Grid ext:GridEx.RowDef="48,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="ScreenNavigatorColumn"
                Width="{Binding ScreenNavigatorWidth}"
                MinWidth="430" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="600" />
        </Grid.ColumnDefinitions>

        <!--  MASTER: screen groups and the screens in the selected group  -->
        <via:XBorder
            Grid.Row="1"
            Grid.Column="0"
            Padding="0"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            BorderThickness="0,0,1,0"
            CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <via:XNavigationList
                    Padding="4"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    ItemCornerRadius="4"
                    ItemHoverBackground="{DynamicResource {x:Static via:XBrushKeys.StateHover}}"
                    ItemMargin="0,1"
                    ItemPadding="10,7,8,7"
                    ItemsSource="{Binding ScreenNavigationGroups}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding CurrentScreenNavigationGroup, Mode=TwoWay}"
                    SelectedItemBackground="{DynamicResource {x:Static via:XBrushKeys.StateSelected}}"
                    SelectedItemForeground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                    SelectionIndicatorBrush="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                    SelectionIndicatorCornerRadius="0,2,2,0"
                    SelectionIndicatorWidth="3"
                    ShowSelectionIndicator="True"
                    Variant="Surface">
                    <via:XNavigationList.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type via:XNavigationListItem}}" TargetType="{x:Type via:XNavigationListItem}">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="Title" Value="{Binding DisplayName}" />
                            <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                            <Setter Property="ShowBadge" Value="True" />
                            <Setter Property="BadgeContent" Value="{Binding Count}" />
                            <Setter Property="BadgeVariant" Value="Primary" />
                        </Style>
                    </via:XNavigationList.ItemContainerStyle>
                </via:XNavigationList>

                <via:XBorder
                    Grid.Column="1"
                    Background="{DynamicResource {x:Static via:XBrushKeys.Background}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0">
                    <via:XNavigationList
                        x:Name="ScreenListBox"
                        Padding="4"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        ContextMenu="{StaticResource ScreenListContextMenu}"
                        ItemCornerRadius="4"
                        ItemHoverBackground="{DynamicResource {x:Static via:XBrushKeys.StateHover}}"
                        ItemMargin="0,1"
                        ItemPadding="10,7,8,7"
                        ItemsSource="{Binding ScreensNavigationView}"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding CurrentScreen, Mode=TwoWay}"
                        SelectedItemBackground="{DynamicResource {x:Static via:XBrushKeys.StateSelected}}"
                        SelectedItemForeground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                        SelectionChanged="ScreenListBox_SelectionChanged"
                        SelectionIndicatorBrush="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                        SelectionIndicatorCornerRadius="0,2,2,0"
                        SelectionIndicatorWidth="3"
                        ShowSelectionIndicator="True"
                        Variant="Surface"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <via:XNavigationList.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type via:XNavigationListItem}}" TargetType="{x:Type via:XNavigationListItem}">
                                <Setter Property="MinHeight" Value="50" />
                                <Setter Property="Title" Value="{Binding Name}" />
                                <Setter Property="SubTitle" Value="{Binding Descr}" />
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                <Setter Property="ShowBadge" Value="{Binding IsHomeScreen}" />
                                <Setter Property="BadgeContent" Value="Main" />
                                <Setter Property="BadgeVariant" Value="Primary" />
                                <Setter Property="ShowEdit" Value="True" />
                                <Setter Property="ShowDelete" Value="True" />
                                <Setter Property="EditToolTip" Value="{via:XLoc Common.EditTooltip, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                <Setter Property="DeleteToolTip" Value="{via:XLoc Common.DeleteTooltip, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                <Setter Property="EditCommand" Value="{Binding DataContext.EditScreenCoreCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XNavigationList}}}" />
                                <Setter Property="EditCommandParameter" Value="{Binding}" />
                                <Setter Property="DeleteCommand" Value="{Binding DataContext.DeleteScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XNavigationList}}}" />
                                <Setter Property="DeleteCommandParameter" Value="{Binding}" />
                            </Style>
                        </via:XNavigationList.ItemContainerStyle>
                    </via:XNavigationList>
                </via:XBorder>
            </Grid>
        </via:XBorder>

        <GridSplitter
            x:Name="ScreenNavigatorSplitter"
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            Cursor="SizeWE"
            DragCompleted="ScreenNavigatorSplitter_DragCompleted"
            DragDelta="ScreenNavigatorSplitter_DragDelta"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            ShowsPreview="False"
            Style="{StaticResource DesignerNavigatorSplitterStyle}" />

        <via:XBorder
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.2"
                    ShadowDepth="2" />
            </via:XBorder.Effect>

            <Grid ext:GridEx.ColDef="*,Auto">

                <via:XTextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{via:XLoc Screen.Title,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                <via:XIconButton
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    Appearance="Subtle"
                    Command="{Binding NewScreenCommand}"
                    Cursor="Hand"
                    Focusable="False"
                    Icon="{via:MaterialIcon Kind=Plus}"
                    Size="Medium"
                    ToolTip="{via:XLoc Screen.New,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Variant="Primary" />

            </Grid>
        </via:XBorder>

        <!--  DESIGNER AREA  -->
        <Grid
            x:Name="PART_DesignerArea"
            Grid.Column="2"
            ext:GridEx.ColDef="250,*"
            Background="{DynamicResource TabHeaderBrush}">


            <!--  NO CURRENT SCREEN INFO  -->
            <via:XBorder
                Grid.Row="1"
                Grid.RowSpan="2"
                Padding="0"
                Background="{DynamicResource NoDataBackground}"
                BorderThickness="0,0,1,0"
                CornerRadius="0"
                Visibility="{Binding CurrentScreen, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ico:PackIconMaterial
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Kind="Information" />
                    <via:XTextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Text="{via:XLoc Screen.None,
                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                </StackPanel>
            </via:XBorder>

        </Grid>

        <Grid Grid.Row="2" Grid.Column="2">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

                <Grid
                    MinWidth="{Binding ElementName=PART_ScrollViewer, Path=ViewportWidth}"
                    MinHeight="{Binding ElementName=PART_ScrollViewer, Path=ViewportHeight}"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
                    <Grid
                        Margin="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding CurrentProject.ScreenZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" ScaleY="{Binding CurrentProject.ScreenZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" />
                        </Grid.LayoutTransform>

                        <!--  gemeinsamer Bezug: links Hilfslinien, rechts Device-Host  -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  DEVICE GUIDE  -->
                            <Grid
                                Grid.Column="0"
                                Height="{Binding CurrentProject.DeviceHeight, FallbackValue=100}"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">

                                <via:XTextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                    Text="{via:XLoc Screen.DeviceTop,
                                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                                <Line
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    SnapsToDevicePixels="True"
                                    Stroke="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                    StrokeDashArray="3 4"
                                    StrokeDashCap="Flat"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="150"
                                    Y1="0.5"
                                    Y2="0.5" />

                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                    Text="{via:XLoc Screen.DeviceBottom,
                                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                                <Line
                                    Margin="0,0,0,-5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    SnapsToDevicePixels="True"
                                    Stroke="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                    StrokeDashArray="3 4"
                                    StrokeDashCap="Flat"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="150"
                                    Y1="0.5"
                                    Y2="0.5" />
                            </Grid>

                            <!--  SCREEN + RESIZE  -->
                            <Grid
                                Grid.Column="2"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <via:XBorder
                                    Grid.Row="0"
                                    Padding="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">

                                    <designer:ScreenDesignerControl
                                        x:Name="PART_ScreenDesigner"
                                        Width="{Binding CurrentScreen.Width, Mode=OneWay, FallbackValue=250}"
                                        Height="{Binding CurrentScreen.ScreenHeight, FallbackValue=350}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        gong:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource Self}}"
                                        gong:DragDrop.IsDropTarget="True"
                                        AllowDrop="True"
                                        Screen="{Binding CurrentScreen}" />
                                </via:XBorder>

                                <via:XBorder
                                    MinWidth="40"
                                    Margin="0,0,-80,0"
                                    Padding="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="False"
                                    Visibility="Collapsed">

                                    <via:XBorder.Resources>
                                        <Style x:Key="SeparatorStyle" TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                            <Setter Property="Height" Value="1" />
                                            <Setter Property="Margin" Value="2,3" />
                                        </Style>

                                        <Style x:Key="IconStyle" TargetType="ico:PackIconMaterial">
                                            <Setter Property="Width" Value="12" />
                                            <Setter Property="Height" Value="12" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </Style>
                                    </via:XBorder.Resources>

                                    <via:XStackPanel Orientation="Vertical" Spacing="3">
                                        <via:XButton
                                            Command="{Binding EditScreenCoreCommand}"
                                            CommandParameter="{Binding CurrentScreen}"
                                            ToolTip="{via:XLoc Screen.Edit,
                                                               ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}">
                                            <ico:PackIconMaterial Kind="Pencil" Style="{StaticResource IconStyle}" />
                                        </via:XButton>

                                        <via:XButton
                                            Command="{Binding DeleteScreenCommand}"
                                            CommandParameter="{Binding CurrentScreen}"
                                            ToolTip="{via:XLoc Screen.Delete,
                                                               ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}">
                                            <ico:PackIconMaterial
                                                Foreground="{DynamicResource DangerBrush}"
                                                Kind="TrashCan"
                                                Style="{StaticResource IconStyle}" />
                                        </via:XButton>

                                        <via:XToggleButton
                                            Height="22"
                                            Margin="2,1,2,0"
                                            Padding="4,0,4,1"
                                            Content="H"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            IsChecked="{Binding CurrentScreen.ShowHeader, Mode=TwoWay}"
                                            Style="{DynamicResource XToggleButton}"
                                            ToolTip="{via:XLoc Screen.ShowHeader,
                                                               ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                                        <via:XToggleButton
                                            Height="22"
                                            Margin="2,1,2,1"
                                            Padding="4,0,4,1"
                                            Content="F"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            IsChecked="{Binding CurrentScreen.ShowFooter, Mode=TwoWay}"
                                            Style="{DynamicResource XToggleButton}"
                                            ToolTip="{via:XLoc Screen.ShowFooter,
                                                               ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                    </via:XStackPanel>
                                </via:XBorder>

                                <Thumb
                                    Grid.Row="1"
                                    Width="22"
                                    Height="22"
                                    Margin="0,-1,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Panel.ZIndex="10"
                                    Background="Transparent"
                                    Cursor="SizeNS"
                                    DragDelta="Thumb_DragDelta"
                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border
                                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                                BorderThickness="0"
                                                CornerRadius="0 0 4 4">
                                                <ico:PackIconMaterial
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Kind="DragVertical" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <via:XBorder
            Grid.Column="2"
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="2" />
            </via:XBorder.Effect>

            <Grid ext:GridEx.ColDef="*,Auto">

                <via:XTextBlock
                    Margin="18,0,15,1"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Opacity="0.9"
                    Text="{Binding CurrentScreen.Name, FallbackValue='Screen Name'}" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

                    <ui:DesignerToolbar x:Name="PART_DesignerToolbar" ZoomPercent="{Binding CurrentProject.ScreenZoomPercent, Mode=TwoWay}" />

                </StackPanel>

            </Grid>

        </via:XBorder>

        <via:XBorder
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="2"
            Background="{DynamicResource NoDataBackground}"
            BorderThickness="0,0,1,0"
            CornerRadius="0"
            Visibility="{Binding CurrentScreen, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ico:PackIconMaterial
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource DangerBrush}"
                    Kind="Information" />
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{via:XLoc Screen.None,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
            </StackPanel>
        </via:XBorder>

        </Grid>
    </local:DesignerWorkspaceHost>
</UserControl>
