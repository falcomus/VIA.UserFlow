<UserControl
    x:Class="Mockup.Views.ScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behav="clr-namespace:Mockup.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:gong="urn:gong-wpf-dragdrop"
    xmlns:grouping="clr-namespace:Mockup.Grouping"
    xmlns:helper="clr-namespace:Mockup.Helper"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    Background="{DynamicResource DesignerBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    PreviewMouseWheel="Root_PreviewMouseWheel"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid ext:GridEx.ColDef="350,*" ext:GridEx.RowDef="48,*">

        <!--  LIST AREA  -->
        <via:XBorder
            Grid.Row="1"
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,1,0"
            CornerRadius="0">

            <Grid>

                <via:XListBox
                    x:Name="ScreenListBox"
                    Grid.Row="0"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="{DynamicResource {x:Static via:XBrushKeys.Background}}"
                    BorderThickness="0"
                    ItemsSource="{Binding ScreensGroupedView}"
                    MouseDoubleClick="ListBox_MouseDoubleClick"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    SelectedItem="{Binding CurrentScreen, Mode=TwoWay}"
                    SelectionChanged="ScreenListBox_SelectionChanged"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    ContextMenu="{StaticResource ScreenListContextMenu}">

                    <via:XListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type via:XListBoxItem}}" TargetType="{x:Type via:XListBoxItem}">

                            <Setter Property="Margin" Value="4,1" />
                            <Setter Property="Padding" Value="12,5,10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                            <Setter Property="Title" Value="{Binding Name}" />
                            <Setter Property="SubTitle" Value="{Binding Descr}" />

                            <Setter Property="ShowBadge" Value="{Binding IsHomeScreen}" />
                            <Setter Property="BadgeContent" Value="Main" />
                            <Setter Property="BadgeVariant" Value="Primary" />

                            <Setter Property="ShowEdit" Value="True" />
                            <Setter Property="ShowDelete" Value="True" />

                            <Setter Property="EditCommand" Value="{Binding DataContext.EditScreenCoreCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}" />

                            <Setter Property="EditCommandParameter" Value="{Binding}" />

                            <Setter Property="DeleteCommand" Value="{Binding DataContext.DeleteScreenCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}" />

                            <Setter Property="DeleteCommandParameter" Value="{Binding}" />
                        </Style>
                    </via:XListBox.ItemContainerStyle>


                    <via:XListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <via:XExpander
                                                    Margin="2"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    behav:GroupExpandStateBehavior.Host="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    behav:GroupExpandStateBehavior.Key="{Binding Name}"
                                                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceDark}}"
                                                    ContentPadding="0 1 0 -2"
                                                    Header="{Binding Name}"
                                                    IsExpanded="True">
                                                    <ItemsPresenter />
                                                </via:XExpander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </via:XListBox.GroupStyle>

                </via:XListBox>


            </Grid>
        </via:XBorder>

        <via:XBorder
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.2"
                    ShadowDepth="2" />
            </via:XBorder.Effect>

            <Grid ext:GridEx.ColDef="*,Auto">

                <via:XTextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Screens" />

                <via:XIconButton
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Command="{Binding NewScreenCommand}"
                    Cursor="Hand"
                    Icon="{via:MaterialIcon Kind=Plus}"
                    IconSize="16"
                    Width="50"
                    Size="Medium"
                    ToolTip="New Screen"
                    Variant="Primary" />

            </Grid>
        </via:XBorder>

        <!--  DESIGNER AREA  -->
        <Grid
            x:Name="PART_DesignerArea"
            Grid.Column="1"
            ext:GridEx.ColDef="250,*"
            Background="{DynamicResource TabHeaderBrush}">


            <!--  NO CURRENT SCREEN INFO  -->
            <via:XBorder
                Grid.Row="1"
                Grid.RowSpan="2"
                Padding="0"
                Background="{DynamicResource NoDataBackground}"
                BorderThickness="0,0,1,0"
                CornerRadius="0"
                Visibility="{Binding CurrentScreen, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ico:PackIconMaterial
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Kind="Information" />
                    <via:XTextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Text="No current Screen2" />
                </StackPanel>
            </via:XBorder>

        </Grid>

        <Grid Grid.Row="2" Grid.Column="1">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

                <Grid
                    MinWidth="{Binding ElementName=PART_ScrollViewer, Path=ViewportWidth}"
                    MinHeight="{Binding ElementName=PART_ScrollViewer, Path=ViewportHeight}"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
                    <Grid
                        Margin="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding CurrentProject.ScreenZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" ScaleY="{Binding CurrentProject.ScreenZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" />
                        </Grid.LayoutTransform>

                        <!--  gemeinsamer Bezug: links Hilfslinien, rechts Device-Host  -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  DEVICE GUIDE  -->
                            <Grid
                                Grid.Column="0"
                                Height="{Binding CurrentProject.DeviceHeight, FallbackValue=100}"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">

                                <via:XTextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="DodgerBlue"
                                    Text="Device Top" />

                                <Line
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    SnapsToDevicePixels="True"
                                    Stroke="DodgerBlue"
                                    StrokeDashArray="3 4"
                                    StrokeDashCap="Flat"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="150"
                                    Y1="0.5"
                                    Y2="0.5" />

                                <via:XTextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Foreground="DodgerBlue"
                                    Text="Device Bottom" />

                                <Line
                                    Margin="0,0,0,-5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    SnapsToDevicePixels="True"
                                    Stroke="DodgerBlue"
                                    StrokeDashArray="3 4"
                                    StrokeDashCap="Flat"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="150"
                                    Y1="0.5"
                                    Y2="0.5" />
                            </Grid>

                            <!--  SCREEN + RESIZE  -->
                            <Grid
                                Grid.Column="2"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <via:XBorder
                                    Grid.Row="0"
                                    Padding="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#202123"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">

                                    <designer:ScreenDesignerControl
                                        x:Name="PART_ScreenDesigner"
                                        Width="{Binding CurrentScreen.Width, Mode=OneWay, FallbackValue=250}"
                                        Height="{Binding CurrentScreen.ScreenHeight, FallbackValue=350}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        gong:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource Self}}"
                                        gong:DragDrop.IsDropTarget="True"
                                        AllowDrop="True"
                                        Screen="{Binding CurrentScreen}" />
                                </via:XBorder>

                                <via:XBorder
                                    MinWidth="40"
                                    Margin="0,0,-80,0"
                                    Padding="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="False"
                                    Visibility="Collapsed">

                                    <via:XBorder.Resources>
                                        <Style x:Key="SeparatorStyle" TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                            <Setter Property="Height" Value="1" />
                                            <Setter Property="Margin" Value="2,3" />
                                        </Style>

                                        <Style x:Key="IconStyle" TargetType="ico:PackIconMaterial">
                                            <Setter Property="Width" Value="12" />
                                            <Setter Property="Height" Value="12" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </Style>
                                    </via:XBorder.Resources>

                                    <via:XStackPanel Orientation="Vertical" Spacing="3">
                                        <via:XButton
                                            Command="{Binding EditScreenCoreCommand}"
                                            CommandParameter="{Binding CurrentScreen}"
                                            ToolTip="Edit Screen">
                                            <ico:PackIconMaterial Kind="Pencil" Style="{StaticResource IconStyle}" />
                                        </via:XButton>

                                        <via:XButton
                                            Command="{Binding DeleteScreenCommand}"
                                            CommandParameter="{Binding CurrentScreen}"
                                            ToolTip="Delete Screen">
                                            <ico:PackIconMaterial
                                                Foreground="{DynamicResource DangerBrush}"
                                                Kind="TrashCan"
                                                Style="{StaticResource IconStyle}" />
                                        </via:XButton>

                                        <via:XToggleButton
                                            Height="22"
                                            Margin="2,1,2,0"
                                            Padding="4,0,4,1"
                                            Content="H"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            IsChecked="{Binding CurrentScreen.ShowHeader, Mode=TwoWay}"
                                            Style="{DynamicResource XToggleButton}"
                                            ToolTip="Show Header" />

                                        <via:XToggleButton
                                            Height="22"
                                            Margin="2,1,2,1"
                                            Padding="4,0,4,1"
                                            Content="F"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            IsChecked="{Binding CurrentScreen.ShowFooter, Mode=TwoWay}"
                                            Style="{DynamicResource XToggleButton}"
                                            ToolTip="Show Footer" />
                                    </via:XStackPanel>
                                </via:XBorder>

                                <Thumb
                                    Grid.Row="1"
                                    Width="22"
                                    Height="22"
                                    Margin="0,-1,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    Cursor="SizeNS"
                                    DragDelta="Thumb_DragDelta"
                                    Foreground="White">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border
                                                Background="#303133"
                                                BorderThickness="0"
                                                CornerRadius="0 0 4 4">
                                                <ico:PackIconMaterial
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Kind="DragVertical" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <via:XBorder
            Grid.Column="1"
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="2" />
            </via:XBorder.Effect>

            <Grid ext:GridEx.ColDef="*,Auto">

                <via:XTextBlock
                    Margin="18,0,15,1"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Opacity="0.9"
                    Text="{Binding CurrentScreen.Name, FallbackValue='Screen Name'}" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

                    <via:XSeparator
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsMultipleControlsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ui:AlignmentToolbar
                        HorizontalAlignment="Right"
                        BorderBrush="{DynamicResource DarkBorderBrush}"
                        BorderThickness="0"
                        Visibility="{Binding IsMultipleControlsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <via:XSeparator
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Center" />

                    <ui:UndoRedoBar />

                    <ui:XZoomSlider
                        x:Name="PART_ZoomSlider"
                        Margin="3,0,5,0"
                        BorderThickness="1,0,0,0"
                        Cursor="Hand"
                        MaxZoomPercent="200"
                        MinZoomPercent="25"
                        TickFrequency="1"
                        ZoomPercent="{Binding CurrentProject.ScreenZoomPercent, Mode=TwoWay}" />

                </StackPanel>

            </Grid>

        </via:XBorder>

        <via:XBorder
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            Background="{DynamicResource NoDataBackground}"
            BorderThickness="0,0,1,0"
            CornerRadius="0"
            Visibility="{Binding CurrentScreen, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ico:PackIconMaterial
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource DangerBrush}"
                    Kind="Information" />
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="No current Screen" />
            </StackPanel>
        </via:XBorder>

    </Grid>
</UserControl>
