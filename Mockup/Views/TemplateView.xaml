<UserControl
    x:Class="Mockup.Views.TemplateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behav="clr-namespace:Mockup.Behaviors"
    xmlns:conv="clr-namespace:Mockup.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:gong="urn:gong-wpf-dragdrop"
    xmlns:group="clr-namespace:Mockup.Grouping"
    xmlns:helper="clr-namespace:Mockup.Helper"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:render="clr-namespace:Mockup.Rendering"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    Background="{DynamicResource DesignerBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    PreviewMouseWheel="Root_PreviewMouseWheel"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Grid ext:GridEx.ColDef="350,*">
        <!--  LIST AREA  -->
        <via:XBorder
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
            BorderThickness="0,0,1,0"
            CornerRadius="0">
            <Grid Grid.Column="0" ext:GridEx.RowDef="48,Auto,*">

                <via:XBorder
                    Grid.Row="1"
                    Height="32"
                    Padding="8,2"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <via:XSearchBox
                        Margin="0,0,0,4"
                        Padding="5,0,5,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderThickness="0,0,0,1"
                        Focusable="True"
                        FontSize="15"
                        FontWeight="Normal"
                        IsHitTestVisible="True"
                        IsTabStop="False"
                        Placeholder="Search .."
                        ShowResetButton="True" />
                </via:XBorder>

                <via:XListBox
                    x:Name="TemplateListBox"
                    Grid.Row="2"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="{DynamicResource {x:Static via:XBrushKeys.Background}}"
                    BorderThickness="0"
                    ContextMenu="{StaticResource TemplateListContextMenu}"
                    ItemsSource="{Binding TemplatesGroupedView}"
                    MouseDoubleClick="ListBox_MouseDoubleClick"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    SelectedItem="{Binding CurrentTemplate, Mode=TwoWay}"
                    SelectionChanged="TemplateListBox_SelectionChanged"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True">

                    <via:XListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type via:XListBoxItem}}" TargetType="{x:Type via:XListBoxItem}">

                            <Setter Property="Margin" Value="4,1" />
                            <Setter Property="Padding" Value="12,5,10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                            <Setter Property="Title" Value="{Binding Name}" />
                            <Setter Property="SubTitle" Value="{Binding Description}" />

                            <Setter Property="ShowEdit" Value="True" />
                            <Setter Property="ShowDelete" Value="True" />

                            <Setter Property="EditCommand" Value="{Binding DataContext.EditTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}" />
                            <Setter Property="EditCommandParameter" Value="{Binding}" />

                            <Setter Property="DeleteCommand" Value="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XListBox}}}" />
                            <Setter Property="DeleteCommandParameter" Value="{Binding}" />
                        </Style>
                    </via:XListBox.ItemContainerStyle>

                    <via:XListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <via:XExpander
                                                    Margin="2"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    behav:GroupExpandStateBehavior.Host="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    behav:GroupExpandStateBehavior.Key="{Binding Name}"
                                                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceDark}}"
                                                    ContentPadding="0 1 0 -2"
                                                    Header="{Binding Name}"
                                                    IsExpanded="True">
                                                    <ItemsPresenter />
                                                </via:XExpander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </via:XListBox.GroupStyle>

                </via:XListBox>


                <via:XBorder
                    Grid.Column="0"
                    Padding="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0">
                    <via:XBorder.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Direction="270"
                            Opacity="0.2"
                            ShadowDepth="2" />
                    </via:XBorder.Effect>

                    <Grid ext:GridEx.ColDef="*,Auto">
                        <via:XTextBlock
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="Templates" />
                        <via:XIconButton
                            Grid.Column="1"
                            Width="50"
                            Margin="0,0,10,0"
                            Command="{Binding NewTemplateCommand}"
                            Cursor="Hand"
                            Icon="{via:MaterialIcon Kind=Plus}"
                            IconSize="16"
                            Size="Medium"
                            ToolTip="New Template"
                            Variant="Primary" />
                    </Grid>
                </via:XBorder>

            </Grid>
        </via:XBorder>

        <!--  DESIGNER AREA  -->
        <Grid
            x:Name="PART_DesignerArea"
            Grid.Column="1"
            ext:GridEx.RowDef="48,*">

            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    MinWidth="{Binding ElementName=PART_ScrollViewer, Path=ViewportWidth}"
                    MinHeight="{Binding ElementName=PART_ScrollViewer, Path=ViewportHeight}"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
                    <Grid
                        Margin="0,44,0,44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding CurrentProject.TemplateZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" ScaleY="{Binding CurrentProject.TemplateZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" />
                        </Grid.LayoutTransform>

                        <!--  DEVICE BOUNDS INDICATOR  -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Rectangle
                                Width="{Binding CurrentProject.DeviceWidth, FallbackValue=100}"
                                Height="{Binding CurrentProject.DeviceHeight, FallbackValue=100}"
                                Fill="{DynamicResource DesignAreaBackground}"
                                Stroke="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                StrokeDashArray="2 2"
                                StrokeThickness="1" />
                        </Grid>

                        <!--  TEMPLATE + RESIZE-THUMB  -->
                        <Grid
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <via:XBorder
                                Grid.Row="0"
                                Padding="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <designer:TemplateDesignerControl
                                    x:Name="PART_TemplateDesigner"
                                    Width="{Binding CurrentProject.DeviceWidth, Mode=TwoWay, FallbackValue=200}"
                                    Height="{Binding TemplateDesignerHeight, Mode=TwoWay, FallbackValue=250}"
                                    gong:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource Self}}"
                                    gong:DragDrop.IsDropTarget="True"
                                    AllowDrop="True"
                                    ScreenTemplate="{Binding CurrentTemplate}" />
                            </via:XBorder>

                            <Thumb
                                Grid.Row="1"
                                Width="22"
                                Height="22"
                                Margin="0,-1,0,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                Cursor="SizeNS"
                                DragDelta="TemplateResizeThumb_DragDelta"
                                Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                PreviewMouseUp="Thumb_PreviewMouseUp">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border
                                            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                                            BorderThickness="0"
                                            CornerRadius="0 0 4 4">
                                            <ico:PackIconMaterial
                                                Width="12"
                                                Height="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="DragVertical" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <via:XBorder
                Grid.Column="1"
                Padding="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="0">
                <via:XBorder.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="270"
                        Opacity="0.12"
                        ShadowDepth="2" />
                </via:XBorder.Effect>

                <Grid ext:GridEx.ColDef="*,Auto">

                    <via:XTextBlock
                        Margin="18,0,15,1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Opacity="0.9"
                        Text="{Binding CurrentTemplate.Name, FallbackValue='Template Name'}" />

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">

                        <via:XSeparator
                            Grid.Column="1"
                            Margin="10,0,10,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsMultipleControlsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ui:AlignmentToolbar
                            HorizontalAlignment="Right"
                            BorderBrush="{DynamicResource DarkBorderBrush}"
                            BorderThickness="0"
                            Visibility="{Binding IsMultipleControlsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <via:XSeparator
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        HorizontalAlignment="Center" />

                    <ui:DesignerToolbar />

                    <via:XSeparator
                        Margin="10,0,10,0"
                        HorizontalAlignment="Center" />

                    <ui:UndoRedoBar />

                        <via:XSeparator
                            Grid.Column="1"
                            Margin="3,0,3,0"
                            HorizontalAlignment="Center" />

                        <via:XZoomSlider
                            x:Name="PART_ZoomSlider"
                            Margin="3,0,5,0"
                            BorderThickness="0"
                            Cursor="Hand"
                            MaxZoomPercent="200"
                            MinZoomPercent="25"
                            TickFrequency="1"
                            ZoomPercent="{Binding CurrentProject.TemplateZoomPercent, Mode=TwoWay}" />

                    </StackPanel>

                </Grid>

            </via:XBorder>

            <!--  NO CURRENT TEMPLATE INFO  -->
            <via:XBorder
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Padding="0"
                Background="{DynamicResource NoDataBackground}"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="0"
                Visibility="{Binding CurrentTemplate, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ico:PackIconMaterial
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource DangerBrush}"
                        Kind="Information" />
                    <via:XTextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Text="No current Template" />
                </StackPanel>
            </via:XBorder>
        </Grid>
    </Grid>
</UserControl>
