<UserControl
    x:Class="Mockup.Views.TemplateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behav="clr-namespace:Mockup.Behaviors"
    xmlns:conv="clr-namespace:Mockup.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:gong="urn:gong-wpf-dragdrop"
    xmlns:group="clr-namespace:Mockup.Grouping"
    xmlns:helper="clr-namespace:Mockup.Helper"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mockup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:render="clr-namespace:Mockup.Rendering"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    Background="{DynamicResource DesignerBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    PreviewMouseWheel="Root_PreviewMouseWheel"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <local:DesignerWorkspaceHost>
        <Grid ext:GridEx.RowDef="48,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="TemplateNavigatorColumn"
                Width="{Binding TemplateNavigatorWidth}"
                MinWidth="430" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="600" />
        </Grid.ColumnDefinitions>

        <!--  MASTER: template groups and templates in the selected group  -->
        <via:XBorder
            Grid.Row="1"
            Grid.Column="0"
            Padding="0"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            BorderThickness="0,0,1,0"
            CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <via:XNavigationList
                    Padding="4"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    ItemCornerRadius="4"
                    ItemHoverBackground="{DynamicResource {x:Static via:XBrushKeys.StateHover}}"
                    ItemMargin="0,1"
                    ItemPadding="10,7,8,7"
                    ItemsSource="{Binding TemplateNavigationGroups}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding CurrentTemplateNavigationGroup, Mode=TwoWay}"
                    SelectedItemBackground="{DynamicResource {x:Static via:XBrushKeys.StateSelected}}"
                    SelectedItemForeground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                    SelectionIndicatorBrush="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                    SelectionIndicatorCornerRadius="0,2,2,0"
                    SelectionIndicatorWidth="3"
                    ShowSelectionIndicator="True"
                    Variant="Surface">
                    <via:XNavigationList.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type via:XNavigationListItem}}" TargetType="{x:Type via:XNavigationListItem}">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="Title" Value="{Binding DisplayName}" />
                            <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                            <Setter Property="ShowBadge" Value="True" />
                            <Setter Property="BadgeContent" Value="{Binding Count}" />
                            <Setter Property="BadgeVariant" Value="Primary" />
                        </Style>
                    </via:XNavigationList.ItemContainerStyle>
                </via:XNavigationList>

                <via:XBorder
                    Grid.Column="1"
                    Background="{DynamicResource {x:Static via:XBrushKeys.Background}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0">
                    <via:XNavigationList
                        x:Name="TemplateListBox"
                        Padding="4"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        ContextMenu="{StaticResource TemplateListContextMenu}"
                        ItemCornerRadius="4"
                        ItemHoverBackground="{DynamicResource {x:Static via:XBrushKeys.StateHover}}"
                        ItemMargin="0,1"
                        ItemPadding="10,7,8,7"
                        ItemsSource="{Binding TemplatesNavigationView}"
                        MouseDoubleClick="ListBox_MouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding CurrentTemplate, Mode=TwoWay}"
                        SelectedItemBackground="{DynamicResource {x:Static via:XBrushKeys.StateSelected}}"
                        SelectedItemForeground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                        SelectionChanged="TemplateListBox_SelectionChanged"
                        SelectionIndicatorBrush="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                        SelectionIndicatorCornerRadius="0,2,2,0"
                        SelectionIndicatorWidth="3"
                        ShowSelectionIndicator="True"
                        Variant="Surface"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <via:XNavigationList.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type via:XNavigationListItem}}" TargetType="{x:Type via:XNavigationListItem}">
                                <Setter Property="MinHeight" Value="50" />
                                <Setter Property="Title" Value="{Binding Name}" />
                                <Setter Property="SubTitle" Value="{Binding Description}" />
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                <Setter Property="ShowEdit" Value="True" />
                                <Setter Property="ShowDelete" Value="True" />
                                <Setter Property="EditToolTip" Value="{via:XLoc Common.EditTooltip, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                <Setter Property="DeleteToolTip" Value="{via:XLoc Common.DeleteTooltip, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                                <Setter Property="EditCommand" Value="{Binding DataContext.EditTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XNavigationList}}}" />
                                <Setter Property="EditCommandParameter" Value="{Binding}" />
                                <Setter Property="DeleteCommand" Value="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType={x:Type via:XNavigationList}}}" />
                                <Setter Property="DeleteCommandParameter" Value="{Binding}" />
                            </Style>
                        </via:XNavigationList.ItemContainerStyle>
                    </via:XNavigationList>
                </via:XBorder>
            </Grid>
        </via:XBorder>

        <GridSplitter
            x:Name="TemplateNavigatorSplitter"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            DragCompleted="TemplateNavigatorSplitter_DragCompleted"
            DragDelta="TemplateNavigatorSplitter_DragDelta"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"
            ShowsPreview="False"
            Style="{StaticResource DesignerNavigatorSplitterStyle}" />

        <via:XBorder
            Grid.Column="0"
            Padding="0"
            Background="{DynamicResource HeaderBackgroundBrush}"
            BorderThickness="0,0,1,1"
            CornerRadius="0">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.2"
                    ShadowDepth="2" />
            </via:XBorder.Effect>

            <Grid ext:GridEx.ColDef="*,Auto">
                <via:XTextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{via:XLoc Template.Title,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                <via:XIconButton
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Appearance="Subtle"
                    Command="{Binding NewTemplateCommand}"
                    Cursor="Hand"
                    Focusable="False"
                    Icon="{via:MaterialIcon Kind=Plus}"
                    Size="Medium"
                    ToolTip="{via:XLoc Template.New,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Variant="Primary" />
            </Grid>
        </via:XBorder>

        <!--  DESIGNER AREA  -->
        <Grid
            x:Name="PART_DesignerArea"
            Grid.RowSpan="2"
            Grid.Column="2"
            ext:GridEx.RowDef="48,*">

            <ScrollViewer
                x:Name="PART_ScrollViewer"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    MinWidth="{Binding ElementName=PART_ScrollViewer, Path=ViewportWidth}"
                    MinHeight="{Binding ElementName=PART_ScrollViewer, Path=ViewportHeight}"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}">
                    <Grid
                        Margin="0,44,0,44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding CurrentProject.TemplateZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" ScaleY="{Binding CurrentProject.TemplateZoomPercent, Converter={StaticResource ZoomPercentToScaleConverter}}" />
                        </Grid.LayoutTransform>

                        <!--  DEVICE BOUNDS INDICATOR  -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Rectangle
                                Width="{Binding CurrentProject.DeviceWidth, FallbackValue=100}"
                                Height="{Binding CurrentProject.DeviceHeight, FallbackValue=100}"
                                Fill="{DynamicResource DesignAreaBackground}"
                                Stroke="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                StrokeDashArray="2 2"
                                StrokeThickness="1" />
                        </Grid>

                        <!--  TEMPLATE + RESIZE-THUMB  -->
                        <Grid
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <via:XBorder
                                Grid.Row="0"
                                Padding="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <designer:TemplateDesignerControl
                                    x:Name="PART_TemplateDesigner"
                                    Width="{Binding CurrentProject.DeviceWidth, Mode=TwoWay, FallbackValue=200}"
                                    Height="{Binding TemplateDesignerHeight, Mode=TwoWay, FallbackValue=250}"
                                    gong:DragDrop.DropHandler="{Binding RelativeSource={RelativeSource Self}}"
                                    gong:DragDrop.IsDropTarget="True"
                                    AllowDrop="True"
                                    ScreenTemplate="{Binding CurrentTemplate}" />
                            </via:XBorder>

                            <Thumb
                                Grid.Row="1"
                                Width="22"
                                Height="22"
                                Margin="0,-1,0,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                Cursor="SizeNS"
                                DragDelta="TemplateResizeThumb_DragDelta"
                                Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                PreviewMouseUp="Thumb_PreviewMouseUp">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border
                                            Background="{themes:AppThemeBinding Light='White',
                                                                                Dark='#606265'}"
                                            BorderThickness="0"
                                            CornerRadius="0 0 4 4">
                                            <ico:PackIconMaterial
                                                Width="12"
                                                Height="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Kind="DragVertical" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <via:XBorder
                Grid.Column="1"
                Padding="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="0">
                <via:XBorder.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="270"
                        Opacity="0.12"
                        ShadowDepth="2" />
                </via:XBorder.Effect>

                <Grid ext:GridEx.ColDef="*,Auto">

                    <via:XTextBlock
                        Margin="18,0,15,1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Opacity="0.9"
                        Text="{Binding CurrentTemplate.Name, FallbackValue='Template Name'}" />

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">

                        <ui:DesignerToolbar x:Name="PART_DesignerToolbar" ZoomPercent="{Binding CurrentProject.TemplateZoomPercent, Mode=TwoWay}" />

                    </StackPanel>

                </Grid>

            </via:XBorder>

            <!--  NO CURRENT TEMPLATE INFO  -->
            <via:XBorder
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Padding="0"
                Background="{DynamicResource NoDataBackground}"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="0"
                Visibility="{Binding CurrentTemplate, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ico:PackIconMaterial
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource DangerBrush}"
                        Kind="Information" />
                    <via:XTextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Text="{via:XLoc Template.None,
                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                </StackPanel>
            </via:XBorder>
        </Grid>
        </Grid>
    </local:DesignerWorkspaceHost>
</UserControl>
