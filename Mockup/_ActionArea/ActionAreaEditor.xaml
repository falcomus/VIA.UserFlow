<Window
    x:Class="Mockup.Actions.ActionAreaEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:aa="clr-namespace:Mockup.Actions"
    xmlns:actions="clr-namespace:Mockup.Actions;assembly=VIA.Mockup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editing="clr-namespace:Mockup.Dialogs"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mockup="clr-namespace:Mockup"
    xmlns:ui="clr-namespace:Mockup.UIControls"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root"
    Title="EDIT ACTION AREA"
    d:DataContext="{d:DesignInstance Type=aa:ActionAreaEditorViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <via:XBorder Padding="20">
        <via:XBorder
            Background="Transparent"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderStrong}}"
            BorderThickness="1.5"
            CornerRadius="8"
            UseLayoutRounding="True">
            <via:XBorder.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Direction="315"
                    Opacity="0.5"
                    ShadowDepth="3" />
            </via:XBorder.Effect>
            <via:XBorder
                Width="825"
                Height="570"
                CornerRadius="8"
                BorderThickness="0">

                <Grid ext:GridEx.RowDef="45,*,Auto">

                    <!--#region === HEADER ===-->
                    <via:XBorder
                        Grid.ColumnSpan="2"
                        Background="{DynamicResource {x:Static via:XBrushKeys.PrimaryStrong}}"
                        BorderThickness="0"
                        CornerRadius="7 7 0 0"
                        MouseLeftButtonDown="TitleBorder_MouseLeftButtonDown">
                        <via:XTextBlock
                            Margin="20,0,0,1"
                            VerticalAlignment="Center"
                            FontSize="17"
                            FontStretch="ExtraExpanded"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                            Text="ACTION ASSIGNMENT" />
                    </via:XBorder>
                    <!--#endregion === HEADER ===-->


                    <!--#region === MAIN CONTENT ===-->
                    <Grid
                        Grid.Row="1"
                        Margin="18,6,18,5"
                        ext:GridEx.RowDef="45,*">

                        <via:XTextBlock
                            Margin="3,0,0,12"
                            VerticalAlignment="Bottom"
                            FontSize="14.5"
                            FontWeight="SemiBold"
                            Text="TRIGGER" />

                        <via:XTextBlock
                            Margin="151,0,0,12"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            FontSize="14.5"
                            FontWeight="SemiBold"
                            Text="ACTION" />

                        <via:XTextBlock
                            Margin="327,0,0,12"
                            VerticalAlignment="Bottom"
                            FontSize="14.5"
                            FontWeight="SemiBold"
                            Text="TARGET" />

                        <!--  Dynamische Liste der Aktionen  -->
                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,3,0,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                Grid.Row="1"
                                Margin="0,2,0,0"
                                IsTabStop="False"
                                ItemsSource="{Binding Triggers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <aa:ActionItemControl x:Name="actionControl" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <EventSetter Event="Loaded" Handler="ContentPresenter_Loaded" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>

                    <!--#region === FOOTER ===-->
                    <via:XBorder
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        BorderThickness="0"
                        UseLayoutRounding="True">
                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,0,15"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <via:XButton
                                Width="110"
                                Height="35"
                                Margin="0,0,12,0"
                                Command="{Binding OkCommand}"
                                Content="OK"
                                FontSize="14"
                                FontWeight="Medium"
                                IsTabStop="False"
                                Style="{StaticResource ButtonPrimary}" />
                            <via:XButton
                                Width="80"
                                Height="35"
                                Margin="5,0,16,0"
                                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                Command="{Binding CancelCommand}"
                                Content="Cancel"
                                FontSize="14"
                                FontWeight="Medium"
                                IsTabStop="False"
                                Style="{StaticResource ButtonCustom}" />
                        </StackPanel>
                    </via:XBorder>
                    <!--#endregion === FOOTER ===-->
                </Grid>
            </via:XBorder>
        </via:XBorder>
    </via:XBorder>
</Window>

