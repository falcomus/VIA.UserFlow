<dialogs:ModalDialogWindow
    x:Class="Mockup.Actions.ActionAreaEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:aa="clr-namespace:Mockup.Actions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Mockup.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    Title="{via:XLoc Dialog.ActionArea.Title,
                     ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
    Width="600"
    Height="430"
    d:DataContext="{d:DesignInstance Type=aa:ActionAreaEditorViewModel}"
    CornerRadius="10"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    ShowResizeGrip="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    TitleBarBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
    TitleBarForegroundBrush="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
    TitleBarHeight="44"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="Transparent"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <via:XGrid Rows="Auto,*,Auto">

        <via:XStackPanel Margin="18,14,18,8" Spacing="6">

            <via:XGrid Columns="170,12,190,12,*">
                <via:XTextBlock Text="{via:XLoc Dialog.ActionArea.Column.Trigger, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" TextRole="Overline" />

                <via:XTextBlock
                    Grid.Column="2"
                    Text="{via:XLoc Dialog.ActionArea.Column.Action,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    TextRole="Overline" />

                <via:XTextBlock
                    Grid.Column="4"
                    Text="{via:XLoc Dialog.ActionArea.Column.Target,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    TextRole="Overline" />
            </via:XGrid>

            <via:XSeparator Orientation="Horizontal" />
        </via:XStackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="18,5,18,8"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl IsTabStop="False" ItemsSource="{Binding Triggers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <aa:ActionItemControl x:Name="actionControl" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <EventSetter Event="Loaded" Handler="ContentPresenter_Loaded" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>

        <via:XBorder
            Grid.Row="2"
            Padding="20,15"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
            BorderThickness="0,1,0,0"
            CornerRadius="0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    MinWidth="104"
                    Command="{Binding OkCommand}"
                    Content="{via:XLoc Common.OK,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    IsDefault="True"
                    Size="Large"
                    Variant="Primary" />
                <via:XButton
                    MinWidth="112"
                    Command="{Binding CancelCommand}"
                    Content="{via:XLoc Common.Cancel,
                                       ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                    Size="Large"
                    Variant="Default" />
            </via:XStackPanel>
        </via:XBorder>
    </via:XGrid>
</dialogs:ModalDialogWindow>