<UserControl
    x:Class="Mockup._ActionArea.ActionAreaHint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Mockup.Resources"
    xmlns:via="http://schemas.via.dev/wpf"
    mc:Ignorable="d">

    <via:XBorder
        Width="300"
        Padding="0"
        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
        BorderThickness="1"
        Effect="{StaticResource EffectShadow3}"
        Visibility="{Binding IsActionAreaHintVisible, Converter={StaticResource BoolToVisibilityConverter}}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <via:XBorder
                Padding="10,6"
                Background="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                CornerRadius="5 5 0 0">
                <via:XTextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                    Text="{via:XLoc Dialog.ActionArea.Hint.Actions, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
            </via:XBorder>

            <!--  Content  -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ActionAreaHintRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,8,10,10">
                            <via:XTextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding Header}" />

                            <via:XBorder
                                Height="1"
                                Margin="0,3,0,6"
                                Background="{DynamicResource {x:Static via:XBrushKeys.Divider}}" />

                            <via:XTextBlock
                                FontSize="13"
                                Text="{Binding Target}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </via:XBorder>
</UserControl>
