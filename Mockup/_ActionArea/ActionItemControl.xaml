<UserControl
    x:Class="Mockup.Actions.ActionItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:aa="clr-namespace:Mockup.Actions"
    xmlns:actions="clr-namespace:Mockup.Actions;assembly=VIA.Mockup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Mockup.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:via="http://schemas.via.dev/wpf"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type=aa:ActionItemControl}"
    Background="Transparent"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--REMOVE-->
    <!--<UserControl.Resources>
        <Style
            x:Key="ComboStyle"
            BasedOn="{StaticResource ComboBoxBaseStyle}"
            TargetType="{x:Type via:XComboBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0,12,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Resources>-->

    <Grid
        Margin="0,0,0,18"
        ext:GridEx.ColDef="130,18,160,18,*"
        ShowGridLines="False">

        <!--  Trigger  -->
        <via:XBorder
            Height="40"
            Background="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
            CornerRadius="4">
            <via:XTextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource {x:Static via:XBrushKeys.PrimaryForeground}}"
                Text="{Binding Trigger}" />
        </via:XBorder>

        <!--  Action Type ComboBox  -->
        <via:XComboBox
            x:Name="PART_ActionCombo"
            Grid.Column="2"
            FontSize="15"
            FontWeight="Medium"
            SelectedValue="{Binding ActionType, Mode=TwoWay}"
            SelectedValuePath="Tag"
            Style="{StaticResource ComboStyle}">
            <ComboBoxItem Content="NONE" Tag="{x:Static actions:ActionType.None}" />
            <Separator />
            <ComboBoxItem Content="Navigate" Tag="{x:Static actions:ActionType.Navigate}" />
            <ComboBoxItem Content="Navigate Home" Tag="{x:Static actions:ActionType.NavigateHome}" />
            <ComboBoxItem Content="Navigate Back" Tag="{x:Static actions:ActionType.NavigateBack}" />
            <Separator />
            <ComboBoxItem Content="Open File" Tag="{x:Static actions:ActionType.OpenFile}" />
            <ComboBoxItem Content="Open URL"      Tag="{x:Static actions:ActionType.OpenURL}" />
            <Separator />
            <ComboBoxItem Content="Show Popup" Tag="{x:Static actions:ActionType.ShowPopup}" />
        </via:XComboBox>

        <!--  Target Picker  -->
        <!--  Target Picker  -->
        <Grid
            Grid.Column="4"
            VerticalAlignment="Center"
            ext:GridEx.ColDef="*,Auto">

            <!--  A) Navigate / ShowPopup -> DropDown (wie bisher)  -->
            <via:XToggleDropDown
                x:Name="PART_TargetButton"
                Grid.ColumnSpan="2"
                Height="38"
                Padding="10,0,10,2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="{Binding DisplayText}"
                FontSize="15"
                FontWeight="Medium"
                Visibility="{Binding DropDownTargetVisibility}">

                <via:XToggleDropDown.DropDownContent>
                    <Grid>

                        <!--  Screen List  -->
                        <via:XListBox
                            x:Name="PART_ScreenListBox"
                            MaxHeight="500"
                            FontSize="15"
                            FontWeight="Medium"
                            IsVisibleChanged="PART_ListBox_IsVisibleChanged"
                            ItemsSource="{Binding Screens}"
                            Mode="CompactNavigation"
                            MouseUp="ListBox_MouseUp"
                            SelectedItem="{Binding SelectedScreen}"
                            Visibility="{Binding ScreenListVisibility}">
                            <via:XListBox.ItemTemplate>
                                <DataTemplate>
                                    <via:XTextBlock
                                        Padding="0,5,0,7"
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </via:XListBox.ItemTemplate>
                        </via:XListBox>

                        <!--  Popup List  -->
                        <via:XListBox
                            x:Name="PART_PopupListBox"
                            MaxHeight="400"
                            IsVisibleChanged="PART_ListBox_IsVisibleChanged"
                            ItemsSource="{Binding Popups}"
                            Mode="CompactNavigation"
                            MouseUp="ListBox_MouseUp"
                            SelectedItem="{Binding SelectedPopup}"
                            Visibility="{Binding PopupListVisibility}">
                            <via:XListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,0,10,0" ext:GridEx.RowDef="*,Auto">
                                        <via:XTextBlock
                                            Padding="0,5,0,7"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Text="{Binding Name}" />
                                        <via:XTextBlock
                                            Grid.Row="1"
                                            MaxWidth="300"
                                            MaxHeight="50"
                                            Margin="0,-6,0,0"
                                            Padding="0,0,0,8"
                                            FontSize="13"
                                            Opacity="0.8"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </via:XListBox.ItemTemplate>
                        </via:XListBox>

                    </Grid>
                </via:XToggleDropDown.DropDownContent>
            </via:XToggleDropDown>

            <!--  B) OpenFile -> TextBox + Browse Button (kein DropDown)  -->
            <via:XTextBox
                Grid.Column="0"
                Height="38"
                Padding="10,0,10,2"
                VerticalContentAlignment="Center"
                FontSize="15"
                FontWeight="Medium"
                Text="{Binding Filename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding FileTargetVisibility}" />

            <via:XButton
                Grid.Column="1"
                Width="38"
                Height="38"
                Margin="6,0,0,0"
                Padding="0"
                Click="BrowseFile_Click"
                Content="…"
                Visibility="{Binding FileTargetVisibility}" />

            <!--  C) OpenURL -> direkte URL-Eingabe (kein DropDown)  -->
            <via:XTextBox
                Grid.ColumnSpan="2"
                Height="38"
                Padding="10,0,10,2"
                VerticalContentAlignment="Center"
                FontSize="15"
                FontWeight="Medium"
                Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding UrlTargetVisibility}" />

        </Grid>

    </Grid>
</UserControl>
