<via:XWindow
    x:Class="UserFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer;assembly=VIA.Mockup"
    xmlns:ext="clr-namespace:Mockup.Extensions;assembly=VIA.Mockup"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:UserFlow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Mockup.Resources;assembly=VIA.Mockup"
    xmlns:ui="clr-namespace:Mockup.UIControls;assembly=VIA.Mockup"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel;assembly=VIA.Mockup"
    xmlns:views="clr-namespace:Mockup.Views;assembly=VIA.Mockup"
    Title="VIA USERFLOW"
    Width="1380"
    Height="850"
    MinWidth="1100"
    MinHeight="800"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    AllowDrop="True"
    Background="{DynamicResource {x:Static via:XBrushKeys.Canvas}}"
    DragEnter="Window_DragEnter"
    DragOver="Window_DragOver"
    Drop="Window_Drop"
    PreviewMouseDown="Window_PreviewMouseDown"
    ResizeMode="CanResizeWithGrip"
    ShowLanguageSelector="True"
    ShowThemeModeButton="True"
    ShowThemeSelector="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <via:XWindow.TitleBarContent>
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                Text="{via:XLoc Main.Theme,
                                ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
            <via:XThemeSelector
                Width="132"
                Height="24"
                Padding="6,0,6,1"
                Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.ControlBorder}}"
                BorderThickness="1" />
        </StackPanel>
    </via:XWindow.TitleBarContent>

    <Grid x:Name="PART_MainGrid" ext:GridEx.RowDef="54,*,28">
        <!--#region === MAIN TABCONTROL ===-->
        <TabControl
            Grid.RowSpan="2"
            ItemContainerStyle="{StaticResource CustomTabItemStyle}"
            SelectedIndex="{Binding MainTabSelectedIndex}"
            Style="{StaticResource CustomTabControlStyle}">
            <TabControl.Resources />
            <!--  Tab PROJECT  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="{via:XLoc Main.TabProject,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}">
                <views:ProjectView />
            </TabItem>

            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="{via:XLoc Main.TabScreen,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                IsEnabled="{Binding CurrentProject, Converter={StaticResource NullToDisabledConverter}, FallbackValue=true}">
                <views:ScreenView Grid.RowSpan="2" />
            </TabItem>
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="{via:XLoc Main.TabTemplate,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                IsEnabled="{Binding CurrentProject, Converter={StaticResource NullToDisabledConverter}, FallbackValue=true}">
                <views:TemplateView Grid.RowSpan="2" />
            </TabItem>
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="{via:XLoc Main.TabPopup,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                IsEnabled="{Binding CurrentProject, Converter={StaticResource NullToDisabledConverter}, FallbackValue=true}">
                <views:PopupView Grid.RowSpan="2" />
            </TabItem>



            <!--  Tab Live PREVIEW  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="{via:XLoc Main.TabPreview,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                Tag="PREVIEW">
                <views:LiveView />
            </TabItem>

            <!--  Tab ACTION FLOW  -->
            <TabItem
                FontSize="15"
                Header="{via:XLoc Main.TabActionFlow,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                IsEnabled="False">
                <views:FlowView />
            </TabItem>

            <TabItem
                Width="20"
                MinWidth="20"
                IsEnabled="False" />

            <!--  Tab OPTIONS  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="{via:XLoc Main.TabOptions,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                IsEnabled="{Binding CurrentProject, Converter={StaticResource NullToDisabledConverter}, FallbackValue=true}">
                <views:OptionsView />
            </TabItem>
            <!--  Tab HELP  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="{via:XLoc Main.TabHelp,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}">
                <views:HelpView />
            </TabItem>
            <!--  Tab ABOUT  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="{via:XLoc Main.TabAbout,
                                  ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}">
                <views:AboutView />
            </TabItem>
        </TabControl>
        <!--#endregion === MAIN TABCONTROL ===-->

        <!--#region === OVERLAY ===-->
        <Border
            x:Name="PART_Overlay"
            Grid.Row="1"
            Background="{DynamicResource {x:Static via:XBrushKeys.Scrim}}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
        <!--#endregion === OVERLAY ===-->

        <!--#region === STATUSBAR ===-->
        <StatusBar
            Grid.Row="2"
            Height="28"
            Padding="0,1,0,0"
            Background="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelBackground}}"
            BorderThickness="0"
            Style="{DynamicResource StatusBarBaseStyle}">
            <StatusBarItem>
                <StackPanel Margin="-4,0,0,0" Orientation="Horizontal">
                    <Border
                        Grid.Column="1"
                        Padding="6,0,6,1"
                        Background="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelItemHoverBackground}}"
                        CornerRadius="3">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}"
                            Opacity="0.6"
                            Text="{via:XLoc Main.StatusScreens,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}"
                        Text="{Binding CurrentProject.Screens.Count, FallbackValue='ScreensCount'}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Grid.Column="1"
                        Padding="6,0,6,1"
                        Background="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelItemHoverBackground}}"
                        CornerRadius="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}"
                            Opacity="0.6"
                            Text="{via:XLoc Main.StatusTemplates,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}"
                        Text="{Binding Templates.Count, FallbackValue='ScreensCount'}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Grid.Column="1"
                        Padding="6,0,6,1"
                        Background="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelItemHoverBackground}}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}"
                            Opacity="0.6"
                            Text="{via:XLoc Main.StatusPopups,
                                            ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}"
                        Text="{Binding CurrentProject.Popups.Count, FallbackValue='PopupCount'}" />
                </StackPanel>
            </StatusBarItem>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border
                    Padding="6,0,7,1"
                    Background="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelItemHoverBackground}}"
                    CornerRadius="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}"
                        Opacity="0.6"
                        Text="{via:XLoc Main.StatusFilePath,
                                        ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
                </Border>
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FontSize="11"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.NavigationPanelForeground}}"
                    Opacity="0.6"
                    Text="{Binding CurrentProject.FilePath, FallbackValue='Project Filepath'}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding CurrentProject.FilePath, FallbackValue='Project Filepath'}" />
            </StackPanel>
            <StatusBarItem />
        </StatusBar>
        <!--#endregion === STATUSBAR ===-->

        <via:XBorder
            Grid.RowSpan="3"
            Padding="0"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderThickness="0,0,1,0"
            CornerRadius="0"
            Visibility="{Binding CurrentProject, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ico:PackIconMaterial
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                    Kind="Information" />
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                    Text="{via:XLoc Main.NoCurrentProject,
                                    ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

                <via:XStackPanel
                    Margin="0,80,0,0"
                    Orientation="Horizontal"
                    Spacing="40">
                    <via:XButton
                        Height="50"
                        Margin="4,2,0,0"
                        Padding="16,0"
                        Command="{Binding LoadProjectCommand}"
                        Content="{via:XLoc Main.ImportProject,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Cursor="Hand"
                        FontSize="14"
                        Icon="{via:MaterialDesignIcon Kind=FolderOpen}"
                        IconSize="20"
                        ToolTip="{via:XLoc Main.ImportProjectTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Danger" />

                    <via:XButton
                        Height="50"
                        Margin="4,2,0,0"
                        Padding="16,0"
                        Command="{Binding NewProjectCommand}"
                        Content="{via:XLoc Main.CreateProject,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Cursor="Hand"
                        FontSize="14"
                        Icon="{via:MaterialIcon Kind=Plus}"
                        IconSize="16"
                        ToolTip="{via:XLoc Main.CreateProjectTooltip,
                                           ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
                        Variant="Primary" />
                </via:XStackPanel>
            </StackPanel>
        </via:XBorder>

    </Grid>


</via:XWindow>
