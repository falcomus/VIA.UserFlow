<via:XWindow
    x:Class="UserFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:Mockup.Designer;assembly=VIA.Mockup"
    xmlns:ext="clr-namespace:Mockup.Extensions;assembly=VIA.Mockup"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:UserFlow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Mockup.UIControls;assembly=VIA.Mockup"
    xmlns:via="http://schemas.via.dev/wpf"
    xmlns:viewmodel="clr-namespace:Mockup.ViewModel;assembly=VIA.Mockup"
    xmlns:views="clr-namespace:Mockup.Views;assembly=VIA.Mockup"
    Title="VIA USERFLOW"
    Width="1380"
    Height="850"
    MinWidth="1100"
    MinHeight="800"
    d:DataContext="{d:DesignInstance Type=viewmodel:MockupViewModel}"
    AllowDrop="True"
    Background="{DynamicResource SecondaryRegionBrush}"
    DragEnter="Window_DragEnter"
    DragOver="Window_DragOver"
    Drop="Window_Drop"
    PreviewMouseDown="Window_PreviewMouseDown"
    ResizeMode="CanResizeWithGrip"
    ShowThemeModeButton="True"
    ShowThemeSelector="False"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <via:XWindow.TitleBarContent>
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                Text="Theme" />
            <via:XThemeSelector
                Width="132"
                Height="24"
                Padding="6,0,6,1"
                Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.ControlBorder}}"
                BorderThickness="1" />
        </StackPanel>
    </via:XWindow.TitleBarContent>

    <Grid x:Name="PART_MainGrid" ext:GridEx.RowDef="54,*,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="{x:Type ColumnDefinition}">
                        <Setter Property="Width" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=PART_ToolboxView, Path=Visibility}" Value="Visible">
                                <Setter Property="Width" Value="60" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--#region === MAIN TABCONTROL ===-->
        <TabControl
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            ItemContainerStyle="{StaticResource CustomTabItemStyle}"
            SelectedIndex="{Binding MainTabSelectedIndex}"
            Style="{StaticResource CustomTabControlStyle}">
            <TabControl.Resources />
            <!--  Tab PROJECT  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="PROJECT">
                <views:ProjectView />
            </TabItem>

            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="SCREEN"
                IsEnabled="{Binding CurrentProject, Converter={StaticResource NullToDisabledConverter}, FallbackValue=true}">
                <views:ScreenView Grid.RowSpan="2" />
            </TabItem>
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="TEMPLATE"
                IsEnabled="{Binding CurrentProject, Converter={StaticResource NullToDisabledConverter}, FallbackValue=true}">
                <views:TemplateView Grid.RowSpan="2" />
            </TabItem>
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="POPUP"
                IsEnabled="{Binding CurrentProject, Converter={StaticResource NullToDisabledConverter}, FallbackValue=true}">
                <views:PopupView Grid.RowSpan="2" />
            </TabItem>



            <!--  Tab Live PREVIEW  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="PREVIEW"
                Tag="PREVIEW">
                <views:LiveView />
            </TabItem>

            <!--  Tab ACTION FLOW  -->
            <TabItem
                FontSize="15"
                Header="ACTION FLOW"
                IsEnabled="False">
                <views:FlowView />
            </TabItem>

            <TabItem
                Width="20"
                MinWidth="20"
                IsEnabled="False" />

            <!--  Tab OPTIONS  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="OPTIONS"
                IsEnabled="{Binding CurrentProject, Converter={StaticResource NullToDisabledConverter}, FallbackValue=true}">
                <views:OptionsView />
            </TabItem>
            <!--  Tab HELP  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="HELP">
                <views:HelpView />
            </TabItem>
            <!--  Tab ABOUT  -->
            <TabItem
                FontSize="15"
                FontWeight="Medium"
                Header="ABOUT">
                <views:AboutView />
            </TabItem>
        </TabControl>
        <!--#endregion === MAIN TABCONTROL ===-->

        <Border
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Background="{DynamicResource AppShellBrush}"
            UseLayoutRounding="True" />


        <!--#region === TOOLBOX VIEW ===-->
        <views:ToolboxView
            x:Name="PART_ToolboxView"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            HorizontalAlignment="Right"
            Panel.ZIndex="20"
            Visibility="{Binding ShowHamburgerButton, Converter={StaticResource BoolToVisibilityConverter}}" />
        <!--#endregion === TOOLBOX VIEW ===-->

        <Border
            Grid.Row="2"
            Grid.Column="2"
            Background="{DynamicResource AppShellBrush}"
            Visibility="{Binding ShowHamburgerButton, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--#region === OVERLAY ===-->
        <Border
            x:Name="PART_Overlay"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Background="#99000000"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
        <!--#endregion === OVERLAY ===-->

        <!--#region === STATUSBAR ===-->
        <StatusBar
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Height="28"
            Padding="0,1,0,0"
            Background="{DynamicResource AppStatusBarBrush}"
            BorderThickness="0"
            Style="{DynamicResource StatusBarBaseStyle}">
            <StatusBarItem>
                <StackPanel Margin="-4,0,0,0" Orientation="Horizontal">
                    <Border
                        Grid.Column="1"
                        Padding="6,0,6,1"
                        Background="{DynamicResource AppStatusBarItemBrush}"
                        CornerRadius="3">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="White"
                            Opacity="0.6"
                            Text="Screens" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="{Binding CurrentProject.Screens.Count, FallbackValue='ScreensCount'}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Grid.Column="1"
                        Padding="6,0,6,1"
                        Background="{DynamicResource AppStatusBarItemBrush}"
                        CornerRadius="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="White"
                            Opacity="0.6"
                            Text="Templates" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="{Binding Templates.Count, FallbackValue='ScreensCount'}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Grid.Column="1"
                        Padding="6,0,6,1"
                        Background="{DynamicResource AppStatusBarItemBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="White"
                            Opacity="0.6"
                            Text="Popups" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="White"
                        Text="{Binding CurrentProject.Popups.Count, FallbackValue='PopupCount'}" />
                </StackPanel>
            </StatusBarItem>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border
                    Padding="6,0,7,1"
                    Background="{DynamicResource AppStatusBarItemBrush}"
                    CornerRadius="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="White"
                        Opacity="0.6"
                        Text="File Path:" />
                </Border>
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FontSize="11"
                    Foreground="White"
                    Opacity="0.6"
                    Text="{Binding CurrentProject.FilePath, FallbackValue='Project Filepath'}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding CurrentProject.FilePath, FallbackValue='Project Filepath'}" />
            </StackPanel>
            <StatusBarItem />
        </StatusBar>
        <!--#endregion === STATUSBAR ===-->

        <!--#region === HAMBURGER BUTTON ===-->
        <via:XToggleButton
            Grid.Column="2"
            Width="32"
            Height="30"
            Margin="0,8,14,0"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Appearance="Ghost"
            CheckedAppearance="Ghost"
            CheckedIcon="{via:MaterialDesignIcon Kind=Close}"
            CheckedVariant="Primary"
            Click="HamburgerButton_Click"
            CornerRadius="4"
            Cursor="Hand"
            Focusable="False"
            Foreground="White"
            IconSize="15"
            IsChecked="{Binding ElementName=PART_ToolboxView, Path=IsFlyoutOpen, Mode=OneWay}"
            ToolTip="Open/Close Toolbox"
            UncheckedIcon="{via:MaterialDesignIcon Kind=Menu}"
            Variant="Default"
            Visibility="{Binding ShowHamburgerButton, Converter={StaticResource BoolToVisibilityConverter}}" />
        <!--#endregion === HAMBURGER BUTTON ===-->

        <via:XBorder
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Padding="0"
            Background="{DynamicResource DesignerBackgroundBrush}"
            BorderThickness="0,0,1,0"
            CornerRadius="0"
            Visibility="{Binding CurrentProject, Converter={StaticResource NullToInversVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ico:PackIconMaterial
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Kind="Information" />
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Text="No current Project" />

                <via:XStackPanel
                    Margin="0,80,0,0"
                    Orientation="Horizontal"
                    Spacing="40">
                    <Button
                        Grid.Column="3"
                        Height="50"
                        Margin="4,2,0,0"
                        Padding="0"
                        Command="{Binding LoadProjectCommand}"
                        Cursor="Hand"
                        FontSize="14"
                        Style="{DynamicResource ButtonWarning}"
                        ToolTip="Open Selected Project">
                        <Grid ext:GridEx.ColDef="Auto,*">
                            <ico:PackIconMaterial
                                Width="20"
                                Height="20"
                                Margin="15,2,0,0"
                                Foreground="White"
                                Kind="FolderOpen" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="15,0,20,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="Import project" />
                        </Grid>
                    </Button>

                    <Button
                        Grid.Column="3"
                        Height="50"
                        Margin="4,2,0,0"
                        Padding="0"
                        Command="{Binding NewProjectCommand}"
                        Cursor="Hand"
                        FontSize="14"
                        Style="{DynamicResource ButtonPrimary}"
                        ToolTip="Open Selected Project">
                        <Grid ext:GridEx.ColDef="Auto,*">
                            <ico:PackIconMaterial
                                Width="16"
                                Height="16"
                                Margin="15,3,0,0"
                                Foreground="White"
                                Kind="Plus" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="15,0,20,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Text="Create new project" />
                        </Grid>
                    </Button>

                </via:XStackPanel>

            </StackPanel>
        </via:XBorder>

    </Grid>


</via:XWindow>

