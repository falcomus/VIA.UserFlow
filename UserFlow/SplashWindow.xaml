<Window
    x:Class="UserFlow.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:Mockup.Resources;assembly=VIA.Mockup"
    xmlns:via="http://schemas.via.dev/wpf"
    Title="VIA USERFLOW"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Manual"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Grid Width="400" Height="300">

        <Image Source="/Resources/png/splashScreen.png" Stretch="Uniform" />

        <TextBlock
            x:Name="PART_HeadingText"
            Margin="25,150,0,0"
            HorizontalAlignment="Left"
            FontSize="18"
            FontWeight="Bold"
            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
            Opacity="0.9"
            Text="{via:XLoc Splash.HeadingStartup, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />

        <TextBlock
            x:Name="PART_StatusText"
            Grid.Row="1"
            Margin="25,195,0,0"
            FontSize="13"
            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
            Opacity="0.9"
            Text="{via:XLoc Splash.StatusPreparing, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}"
            TextTrimming="CharacterEllipsis" />

        <via:XProgressBar
            x:Name="PART_ProgressBar"
            Width="300"
            Height="18"
            Margin="25,175,0,0"
            HorizontalAlignment="Left"
            IsIndeterminate="False"
            Maximum="100"
            Minimum="0"
            MinHeight="0"
            ProgressBrush="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
            ShowValue="False"
            TrackBrush="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
            TrackThickness="18"
            Value="50" />

        <TextBlock
            x:Name="PART_PercentText"
            Margin="350,228,0,0"
            HorizontalAlignment="Left"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
            Opacity="0.9"
            Text="0 %" />
    
        <Border
            x:Name="PART_PleaseWaitImageTextCover"
            Width="165"
            Height="24"
            Margin="22,252,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#F4F6F9" />

        <TextBlock
            x:Name="PART_PleaseWaitText"
            Margin="25,254,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="13"
            Foreground="#6A7DA3"
            Opacity="0.9"
            Text="{via:XLoc Splash.PleaseWait, ResourceManager={x:Static resources:UserFlowResources.ResourceManager}}" />
</Grid>


</Window>
